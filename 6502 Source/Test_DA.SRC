
        verify
        out lt
! ================================================================
! CODEGEN EXTENSIVE TEST PROGRAM
!
! Atari XL / 6502
!
! Purpose:
!   Exercise Codegen's parser, expression evaluator, symbol table,
!   data directives, character constants, addressing modes,
!   macros, local labels and generated machine code.
!
! Expected result:
!
!       CODEGEN TEST
!       ALL TESTS PASSED
!
! or
!
!       CODEGEN TEST
!       TEST FAILED
!
! ================================================================


! ----------------------------------------------------------------
! Atari OS constants
! ----------------------------------------------------------------

EOL     EQU $9B
PUTCH   EQU $F2A4
CIOV    EQU $E456


! ----------------------------------------------------------------
! Test constants
! ----------------------------------------------------------------

VALUE   EQU $2A
VALUE2  EQU VALUE+2
VALUE3  EQU VALUE2*2
VALUE4  EQU (VALUE3/2)+1

LOWADR  EQU <DATA1
HIGHADR EQU >DATA1


! ----------------------------------------------------------------
! Zero-page workspace
! ----------------------------------------------------------------

ORG $80


TEMP    DFB 0
COUNT   DFB 0
SUM     DFW 0
PTR     DFW 0
RESULT  DFB 0


! ================================================================
! Main program
! ================================================================

ORG $4000

START

        JSR PRINTTITLE

        JSR TESTDATA
        BCS +
        JMP FAIL

+   JSR TESTEXPR
        BCS +
        JMP FAIL

+   JSR TESTADDR
        BCS +
        JMP FAIL

+   JSR TESTMACRO
        BCS +
        JMP FAIL

+   JSR TESTCPU

        BCS +
        JMP FAIL

+   JSR PASS

        RTS


! ================================================================
! TEST 1
!
! Test data generated by DFB / DFW / DA / DAT / ASC.
! ================================================================

TESTDATA

        LDA #0
        STA SUM
        STA SUM+1

        LDX #0

TDLOOP

        LDA DATA1,X
        CLC
        ADC SUM
        STA SUM

        LDA SUM+1
        ADC #0
        STA SUM+1

        INX
        CPX #WORDS-DATA1
        BNE TDLOOP


! The following checksum is calculated for the data below.
!
! DATA1:
!   00 01 02 03
!   FE FF
!   41 41 42 43
!
! SUM = 0 + 1 + 2 + 3 + 254 + 255
!       + 65 + 65 + 66 + 67
!
!     = 778 = $030A

        LDA SUM
        CMP #$0A
        BNE TDFAIL

        LDA SUM+1
        CMP #$03
        BNE TDFAIL


! Test the second data area.

        LDA DATA2
        CMP #$12
        BNE TDFAIL

        LDA DATA2+1
        CMP #$34
        BNE TDFAIL

        LDA DATA2+2
        CMP #$01
        BNE TDFAIL

        LDA DATA2+3
        CMP #$00
        BNE TDFAIL


! Test character data.

        LDA CHARS
        CMP #'A'
        BNE TDFAIL

        LDA CHARS+1
        CMP #' '
        BNE TDFAIL

        LDA CHARS+2
        CMP #'!'
        BNE TDFAIL


! Test DFW byte order.

        LDA WORDS
        CMP #$34
        BNE TDFAIL

        LDA WORDS+1
        CMP #$12
        BNE TDFAIL

        LDA WORDS+2
        CMP #$FF
        BNE TDFAIL

        LDA WORDS+3
        CMP #$FF
        BNE TDFAIL

        SEC
        RTS


TDFAIL

        CLC
        RTS


! ================================================================
! DATA TEST AREA
! ================================================================

DATA1

        DFB 0,1,2,3,$FE,$FF
        DFB 'A','A','B','C'




! ------------------------------------------------
! DFW tests
! ------------------------------------------------

WORDS

        DFW $1234
        DFW $FFFF


! ------------------------------------------------
! DA / DAT tests
! ------------------------------------------------

DATA2

        DA $12,$34
        DA %00000001

        DAT $00
        DAT $FF
        DAT $1234


! ------------------------------------------------
! Character tests
! ------------------------------------------------

CHARS

        DFB 'A'
        DFB ' '
        DFB '!'


! ================================================================
! TEST 2
!
! Expression evaluator.
! ================================================================

TESTEXPR

        LDA #VALUE
        CMP #$2A
        BNE TEFAIL

        LDA #VALUE2
        CMP #$2C
        BNE TEFAIL

        LDA #VALUE3
        CMP #$58
        BNE TEFAIL

        LDA #VALUE4
        CMP #$2C
        BNE TEFAIL


! Literal arithmetic.

        LDA #7+8
        CMP #15
        BNE TEFAIL

        LDA #7+8-5
        CMP #10
        BNE TEFAIL

        LDA #3*4
        CMP #12
        BNE TEFAIL

        LDA #20/4
        CMP #5
        BNE TEFAIL


! Parenthesized expression.

        LDA #(3+5)*2
        CMP #16
        BNE TEFAIL


! Negative value.

        LDA #5-2
        CMP #3
        BNE TEFAIL


! Character in expression.

        LDA #7+'A'+8
        CMP #$50
        BNE TEFAIL


! Expression involving a symbol.

        LDA #VALUE-2
        CMP #$28
        BNE TEFAIL


! High and low byte operators.

        LDA #<DATA1
        CMP #LOWADR
        BNE TEFAIL

        LDA #>DATA1
        CMP #HIGHADR
        BNE TEFAIL


        SEC
        RTS


TEFAIL

        CLC
        RTS


! ================================================================
! TEST 3
!
! Addressing modes and forward references.
! ================================================================

TESTADDR

        LDA #0
        STA TEMP

        LDA #$55
        STA TEMP

        LDA TEMP
        CMP #$55
        BNE TAFAIL


! Zero-page indexed.

        LDX #0
        LDA TEMP,X
        CMP #$55
        BNE TAFAIL


! Absolute.

        LDA DATA1
        CMP #0
        BNE TAFAIL


! Absolute indexed.

        LDX #1
        LDA DATA1,X
        CMP #1
        BNE TAFAIL


! Immediate expressions.

        LDA #<DATA2
        STA PTR

        LDA #>DATA2
        STA PTR+1


! Indirect indexed addressing.

        LDY #0

        LDA (PTR),Y
        CMP #$12
        BNE TAFAIL


! Test X-indexed indirect.

        LDX #0

        LDA (PTR,X)
        CMP #$12
        BNE TAFAIL


! Forward reference.

        JMP FORWARD

BACKHERE

        CLC
        RTS


FORWARD

        JMP BACKHERE


TAFAIL

        CLC
        RTS


! ================================================================
! TEST 4
!
! Macro expansion.
! ================================================================

CLEAR   MACRO
        LDA #0
        STA TEMP
        MEND


LOADVAL MACRO A
        LDA #A
        STA TEMP
        MEND


TESTMACRO

        CLEAR

        LDA TEMP
        BNE TMFAIL


        LOADVAL VALUE

        LDA TEMP
        CMP #VALUE
        BNE TMFAIL


        SEC
        RTS


TMFAIL

        CLC
        RTS


! ================================================================
! TEST 5
!
! CPU instruction and branch tests.
! ================================================================

TESTCPU

        LDA #10
        LDX #5
        LDY #3

        CLC
        ADC #5
        CMP #15
        BNE TCFAIL


        SEC
        SBC #5
        CMP #10
        BNE TCFAIL


        INX
        DEX
        INY
        DEY

        CPX #5
        BNE TCFAIL

        CPY #3
        BNE TCFAIL


! Logical operations.

        LDA #$55
        AND #$0F
        CMP #5
        BNE TCFAIL

        LDA #$55
        ORA #$0F
        CMP #$5F
        BNE TCFAIL

        LDA #$55
        EOR #$FF
        CMP #$AA
        BNE TCFAIL


! Shift / rotate.

        LDA #1
        ASL A
        CMP #2
        BNE TCFAIL

        LSR A
        CMP #1
        BNE TCFAIL


! Stack.

        LDA #$5A
        PHA
        LDA #0
        PLA
        CMP #$5A
        BNE TCFAIL


! Branches.

        LDA #0
        BEQ TCBRANCH1
        JMP TCFAIL

TCBRANCH1

        LDA #1
        BNE TCBRANCH2
        JMP TCFAIL

TCBRANCH2

        SEC
        RTS


TCFAIL

        CLC
        RTS


! ================================================================
! PRINT TITLE
! ================================================================

PRINTTITLE

        LDX #0

PTLOOP

        LDA TITLE,X
        BEQ PTDONE

        JSR PUTCH

        INX
        BNE PTLOOP

PTDONE

        LDA #EOL
        JSR PUTCH

        RTS


TITLE

        ASC 'CODEGEN TEST'
        DFB EOL
        DFB 0


! ================================================================
! PASS
! ================================================================

PASS

        LDX #0

PASSLOOP

        LDA PASSMSG,X
        BEQ PASSDONE

        JSR PUTCH

        INX
        BNE PASSLOOP

PASSDONE

        LDA #EOL
        JSR PUTCH

        RTS


PASSMSG

        ASC 'ALL TESTS PASSED'
        DFB EOL
        DFB 0


! ================================================================
! FAIL
! ================================================================

FAIL

        LDX #0

FAILLOOP

        LDA FAILMSG,X
        BEQ FAILDONE

        JSR PUTCH

        INX
        BNE FAILLOOP

FAILDONE

        LDA #EOL
        JSR PUTCH

        RTS


FAILMSG

        ASC 'TEST FAILED'
        DFB EOL
        DFB 0


! ================================================================
! Local-label test section
!
! These deliberately use local labels beginning with '.'
! ================================================================

LOCALTEST

        LDX #0

.loop

        INX
        CPX #10
        BNE .loop

        RTS


! ================================================================
! Additional data for boundary/reference testing
! ================================================================

        DFB 0,0,0,0,0,0,0,0
        DFB 0,0,0,0,0,0,0,0
        DFB 0,0,0,0,0,0,0,0
        DFB 0,0,0,0,0,0,0,0

BIGDATA

        DFB $00,$11,$22,$33,$44,$55,$66,$77
        DFB $88,$99,$AA,$BB,$CC,$DD,$EE,$FF

        DFB %00000000
        DFB %00000001
        DFB %00000010
        DFB %00000100
        DFB %00001000
        DFB %00010000
        DFB %00100000
        DFB %01000000
        DFB %10000000


! ================================================================
! End
! ================================================================
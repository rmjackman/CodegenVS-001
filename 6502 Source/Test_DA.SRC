
        verify
        out lt
CONST0	EQU $00
CONST1	EQU $20
CONST2	EQU $FF
CONST3	EQU $100
CONST4	EQU $1234
CONST5	EQU $FFFF

ZP1	EPZ $40
ZP2	EPZ $80
ZP3	EPZ $FF

LABEL1	EQU $2AFE
LABEL2	EQU $3344
LABEL3	EQU $5678
LABEL4	EQU $ABCD
LABEL5	EQU $0100
LABEL6	EQU $FFFF

NMIST	EQU $D40F


	ORG $2800


* ============================================================
* IMPLIED / ACCUMULATOR
* ============================================================

START	NOP
	CLC
	SEC
	CLD
	SED
	CLI
	SEI
	CLV
	CLD
	TAX
	TAY
	TXA
	TYA
	TSX
	TXS
	INX
	DEX
	INY
	DEY
	ASL
	ROL
	LSR
	ROR


* ============================================================
* IMMEDIATE DECIMAL
* ============================================================

	LDA #0
	LDX #0
	LDY #0

	LDA #1
	LDX #9
	LDY #10

	LDA #127
	LDX #128
	LDY #255


* ============================================================
* IMMEDIATE HEX
* ============================================================

	LDA #$00
	LDX #$01
	LDY #$7F

	LDA #$80
	LDX #$FE
	LDY #$FF


* ============================================================
* IMMEDIATE BINARY
* ============================================================

	LDA #%00000000
	LDX #%00000001
	LDY #%01111111

	LDA #%10000000
	LDX #%10101010
	LDY #%11111111


* ============================================================
* CHARACTER WITHOUT #
* ============================================================

	LDA 'A'
	LDX 'B'
	LDY 'C'

	LDA ' '
	LDX '0'
	LDY '9'


* ============================================================
* CHARACTER WITH #
* ============================================================

	LDA #'A'
	LDX #'B'
	LDY #'C'

	LDA #' '
	LDX #'0'
	LDY #'9'


* ============================================================
* EQU VALUES <= $FF
* ============================================================

	LDA #CONST0
	LDX #CONST1
	LDY #CONST2

	LDA #CONST0+1
	LDX #CONST1+1
	LDY #CONST2-1


* ============================================================
* EPZ / ZERO-PAGE SYMBOLS
* ============================================================

	LDA #ZP1
	LDX #ZP2
	LDY #ZP3

	LDA #ZP1+1
	LDX #ZP2-1


* ============================================================
* ZERO-PAGE LITERAL VALUES
* ============================================================

	LDA #$01
	LDX #$40
	LDY #$80

	LDA #$FE
	LDX #$FF


* ============================================================
* 16-BIT EQU VALUE - LOW BYTE
* ============================================================

	LDA #LABEL1
	LDX #LABEL2
	LDY #LABEL3
	LDA #LABEL4


* ============================================================
* 16-BIT EQU VALUE - HIGH BYTE
* ============================================================

	LDA #LABEL1:H
	LDX #LABEL2:H
	LDY #LABEL3:H
	LDA #LABEL4:H


* ============================================================
* SAME VALUE - LO THEN HI
* Should produce &
* ============================================================

	LDA #LABEL1
	LDX #LABEL1:H

	LDA #LABEL2
	LDX #LABEL2:H

	LDA #LABEL3
	LDX #LABEL3:H

	LDA #LABEL4
	LDX #LABEL4:H


* ============================================================
* SAME VALUE - HI THEN LO
* Should produce @
* ============================================================

	LDY #LABEL1:H
	LDA #LABEL1

	LDY #LABEL2:H
	LDA #LABEL2

	LDY #LABEL3:H
	LDA #LABEL3

	LDY #LABEL4:H
	LDA #LABEL4


* ============================================================
* EXPLICIT LOW AND HIGH BYTE OPERATORS
* ============================================================

	LDA #<LABEL1
	LDX #>LABEL1

	LDA #<LABEL2
	LDX #>LABEL2

	LDA #<LABEL3
	LDX #>LABEL3

	LDA #<LABEL4
	LDX #>LABEL4


* ============================================================
* EXPRESSIONS - LOW BYTE
* ============================================================

	LDA #LABEL1+1
	LDX #LABEL2+1
	LDY #LABEL3+1

	LDA #LABEL4-1
	LDX #LABEL1-1
	LDY #LABEL2-1


* ============================================================
* EXPRESSIONS - HIGH BYTE
* ============================================================

	LDA #LABEL1+1:H
	LDX #LABEL2+1:H
	LDY #LABEL3+1:H

	LDA #LABEL4-1:H
	LDX #LABEL1-1:H
	LDY #LABEL2-1:H


* ============================================================
* 16-BIT LITERALS
* ============================================================

	LDA #$100
	LDX #$1234
	LDY #$5678
	LDA #$ABCD
	LDX #$FFFF


* ============================================================
* 16-BIT LITERALS - HIGH BYTE
* ============================================================

	LDA #$100:H
	LDX #$1234:H
	LDY #$5678:H
	LDA #$ABCD:H
	LDX #$FFFF:H


* ============================================================
* SAME LITERAL - LO / HI
* ============================================================

	LDA #$1234
	LDX #$1234:H

	LDA #$ABCD
	LDX #$ABCD:H

	LDA #$FFFF
	LDX #$FFFF:H


* ============================================================
* DIFFERENT VALUES - 5A/5B
* ============================================================

	LDA #LABEL1
	LDX #LABEL2

	LDA #LABEL2
	LDX #LABEL3

	LDA #LABEL3
	LDX #LABEL4


* ============================================================
* DIFFERENT VALUES - HIGH/LOW
* ============================================================

	LDA #LABEL1:H
	LDX #LABEL2

	LDA #LABEL2:H
	LDX #LABEL3

	LDA #LABEL3:H
	LDX #LABEL4


* ============================================================
* NON-IMMEDIATE INSTRUCTION BETWEEN SAME VALUE
* ============================================================

	LDA #LABEL1
	STA ZP1
	LDX #LABEL1:H

	LDY #LABEL2:H
	STX ZP2
	LDA #LABEL2


* ============================================================
* SEVERAL NON-IMMEDIATE INSTRUCTIONS BETWEEN
* ============================================================

	LDA #LABEL3
	STA ZP1
	INX
	INY
	DEX
	LDX #LABEL3:H

	LDY #LABEL4:H
	STA ZP2
	INX
	DEY
	LDA #LABEL4


* ============================================================
* NON-IMMEDIATE INSTRUCTIONS - DIFFERENT VALUES
* ============================================================

	LDA #LABEL1
	STA ZP1
	INX
	LDX #LABEL2

	LDA #LABEL3:H
	STX ZP2
	INY
	LDY #LABEL4


* ============================================================
* MIXED ADDRESSING BETWEEN PAIRS
* ============================================================

	LDA #LABEL1
	STA ZP1
	LDA #$12
	STX ZP2
	LDX #LABEL1:H

	LDA #LABEL2
	LDY #$34
	LDX #LABEL2:H


* ============================================================
* 16-BIT VALUES AROUND $FF / $100 BOUNDARY
* ============================================================

	LDA #$FE
	LDX #$FF
	LDY #$100

	LDA #$FF
	LDX #$100
	LDY #$101

	LDA #$1FF
	LDX #$200


* ============================================================
* HIGH BYTE BOUNDARIES
* ============================================================

	LDA #$FF00:H
	LDX #$FFFF:H

	LDA #$100:H
	LDX #$1FF:H

	LDA #$200:H
	LDX #$2FF:H


* ============================================================
* EQU 16-BIT CONSTANTS
* ============================================================

	LDA #CONST4
	LDX #CONST5

	LDA #CONST4:H
	LDX #CONST5:H


* ============================================================
* MIX EQU / LABEL
* ============================================================

	LDA #CONST4
	LDX #LABEL1

	LDA #LABEL2
	LDX #CONST4:H

	LDA #CONST5:H
	LDX #LABEL4


* ============================================================
* SAME VALUE USING DIFFERENT EXPRESSIONS
* ============================================================

	LDA #LABEL1
	LDX #$2AFE:H

	LDA #LABEL2+0
	LDX #$3344:H

	LDA #LABEL3-0
	LDX #$5678:H


* ============================================================
* IMMEDIATE OPERATORS + AND -
* ============================================================

	LDA #5+3
	LDX #10-2
	LDY #5-2

	LDA #LABEL1+2
	LDX #LABEL2-2


* ============================================================
* ZERO-PAGE ADDRESSING OUTSIDE #
* ============================================================

	LDA ZP1
	LDX ZP2
	LDY ZP3

	STA ZP1
	STX ZP2
	STY ZP3


* ============================================================
* DIRECT ADDRESSING WITH MEMORY OPERANDS
* ============================================================

	LDA $40
	LDX $80
	LDY $FF

	LDA $40,X
	LDA $80,X
	LDX $40,Y
	LDY $80,X


* ============================================================
* OTHER DIRECT ADDRESSING MODES
* ============================================================

	LDA LABEL1
	LDX LABEL2
	LDY LABEL3

	LDA LABEL1,X
	LDX LABEL2,Y
	LDY LABEL3,X


* ============================================================
* FINAL UNPAIRED 16-BIT IMMEDIATE
* ============================================================

	LDA #LABEL6

	RTS
verify
 out lt

                ORG $DA68

; ============================================================
; Test constants
; ============================================================

ADR_5C0  = $05C0
ADR_6000 = $6000
ADR_7ABC = $7ABC

FR0      = $D4


; ============================================================
; ORIGINAL EXAMPLE
; ============================================================

        STA ADR_5C0
        LDY #$01

L0807   LDA #ADR_5C0
L0804   LDX /ADR_5C0

L0597   STX $D5
        STA $D4
        STY $D6


; ============================================================
; TEST 1
; No intervening label or data
; ============================================================

        LDA #ADR_6000
        LDX /ADR_6000


; ============================================================
; TEST 2
; Label on second instruction
; ============================================================

        LDA #ADR_6000
LABEL1  LDX /ADR_6000


; ============================================================
; TEST 3
; One DATA line between the two operations
;
; This should BREAK the low/high relationship if the
; assembler requires the two instructions to be adjacent.
; ============================================================

        LDA #ADR_7ABC

        DFB $11

        LDX /ADR_7ABC


; ============================================================
; TEST 4
; DATA line with a label
; ============================================================

        LDA #ADR_5C0

DATA1   DFB $22

        LDX /ADR_5C0


; ============================================================
; TEST 5
; Several DATA bytes between the operations
; ============================================================

        LDA #ADR_6000

        DFB $31,$32,$33,$34

        LDX /ADR_6000


; ============================================================
; TEST 6
; Several labelled DATA lines between the operations
; ============================================================

        LDA #ADR_7ABC

DATA2   DFB $41

DATA3   DFB $42

DATA4   DFB $43

        LDX /ADR_7ABC


; ============================================================
; TEST 7
; DATA line between the operations, but the DATA has a
; left-hand label
; ============================================================

TEST7A  LDA #ADR_5C0
DATA7   DFB $55
        LDX /ADR_5C0


; ============================================================
; TEST 8
; Reverse direction (@)
; No intervening data
; ============================================================

        LDX /ADR_6000
        LDA #ADR_6000


; ============================================================
; TEST 9
; Reverse direction (@) with a labelled second instruction
; ============================================================

        LDX /ADR_7ABC
LABEL9  LDA #ADR_7ABC


; ============================================================
; TEST 10
; Reverse direction (@) with DATA between
; ============================================================

        LDX /ADR_5C0

        DFB $66

        LDA #ADR_5C0


; ============================================================
; TEST 11
; Reverse direction (@) with labelled DATA
; ============================================================

        LDX /ADR_6000

DATA11  DFB $77

        LDA #ADR_6000


; ============================================================
; TEST 12
; DATA immediately followed by the high-byte instruction,
; with labels on both the DATA and instruction
; ============================================================

        LDA #ADR_7ABC

DATA12  DFB $81

LABEL12 LDX /ADR_7ABC


; ============================================================
; TEST 13
; Multiple DATA lines and multiple labels
; ============================================================

        LDA #ADR_5C0

DATA13A DFB $91

DATA13B DFB $92

DATA13C DFB $93

LABEL13 LDX /ADR_5C0


; ============================================================
; TEST 14
; Control case: actual instructions between the operands
; ============================================================

        LDA #ADR_6000

        LDY #$01
        NOP

        LDX /ADR_6000


; ============================================================
; TEST 15
; Mixed labelled instructions and DATA
; ============================================================

TEST15A LDA #ADR_7ABC
TEST15B LDY #$01
DATA15  DFB $A1,$A2
TEST15C NOP
TEST15D LDX /ADR_7ABC


; ============================================================
; TEST 16
; Original pattern with multiple data lines after it
; ============================================================

TEST16A LDA #ADR_5C0
TEST16B LDX /ADR_5C0

DATA16A DFB $B1
DATA16B DFB $B2
DATA16C DFB $B3


        RTS
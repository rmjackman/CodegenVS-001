verify
 out lt

CONST0	EQU 0
CONST1	EQU $20
CONST2	EQU $7F
CONST3	EQU $FF

ZP1	EPZ $20
ZP2	EPZ $40
ZP3	EPZ $80

BUFFER	EQU $3000
SCREEN	EQU $4000
LABEL2	EQU $3344
LABEL3	EQU $5678
LABEL4	EQU $ABCD
NMIST	EQU $D40F

 
ORG $2800
 

*
START	NOP
CLC
SEC
CLI
SEI
CLD
SED
CLV
TAX
TAY
TXA
TYA
TSX
TXS
INX
DEX
INY

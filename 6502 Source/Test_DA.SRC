*

; Immediate constants

 
LDA #0
LDX #1
LDY #2

LDA #$0A
LDX #$7F
LDY #$FF

LDA #CONST0
LDX #CONST1
LDY #CONST2
LDA #CONST3
 

*
; Character and binary constants

 
LDA 'A'
LDX 'B'
LDY 'C'

LDA #%00001111
LDX #%10101010
LDY #%11111111
 

*
; Immediate address values

 
LDA #LABEL2
LDX #LABEL2:H

LDA #LABEL3
LDX #LABEL3:H

LDA #LABEL4
LDX #LABEL4:H
 

*
; Low/high bytes used independently

 
LDA #LABEL2
LDX #LABEL2:H

LDY #LABEL3:H
LDA #LABEL3

LDX #LABEL4
LDA #LABEL4:H
 

*
; Address expressions

 
LDA #LABEL2+1
LDX #LABEL2+2
LDY #LABEL3-1

LDA #$12FE
LDX #$12FE:H
 

*
; Store immediate values and use zero-page variables

 
LDA #$55
STA ZP1

LDX #LABEL2:H
STX ZP2

LDY #LABEL3:H
STY ZP3
 

*
; Zero-page addressing

 
LDA ZP1
LDX ZP2
LDY ZP3

STA ZP1
STX ZP2
STY ZP3

LDA ZP1,X
LDY ZP3,X
LDX ZP1,Y
 

*
; Absolute addressing

 
LDA LABEL2
LDX LABEL3
LDY LABEL4

STA LABEL2
STX LABEL3
STY LABEL4

LDA LABEL2,X
LDA LABEL3,Y
LDX LABEL4,Y
LDY LABEL2,X

STA LABEL2,X
STA LABEL3,Y
 

*
; Indirect addressing

 
LDA (ZP1,X)
LDA (ZP2),Y
STA (ZP3,X)
STA (ZP1),Y
 

*
; Arithmetic and logical instructions

 
LDA #CONST1
ADC #1
ADC #$7F
ADC #CONST1

SEC
SBC #1
SBC #CONST1

AND #%00001111
ORA #%10000000
EOR #%01010101

CMP #0
CMP #$FF
CPX #CONST1
CPY #CONST2
 

*
; Memory arithmetic

 
ADC ZP1
ADC ZP2,X
SBC ZP3
SBC ZP1,X

AND ZP1
ORA ZP2
EOR ZP3

ADC LABEL2
ADC LABEL3,X
ADC LABEL4,Y

SBC LABEL2
SBC LABEL3,X
SBC LABEL4,Y

CMP ZP1
CPX ZP2
CPY ZP3

CMP LABEL2
CPX LABEL3
CPY LABEL4
 

*
; Bit and shift instructions

 
BIT ZP1
BIT LABEL2

INC ZP1
DEC ZP2
INC ZP3,X
DEC ZP1,X

ASL ZP1
LSR ZP2
ROL ZP3
ROR ZP1

ASL ZP1,X
LSR ZP2,X
ROL ZP3,X
ROR ZP1,X

ASL LABEL2
LSR LABEL3
ROL LABEL4
ROR LABEL2
 

*
; Stack

 
PHA
PHP
PLA
PLP
 

*

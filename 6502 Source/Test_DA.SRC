
        out lt
        verify

        ORG $2000

; --------------------------------------------------------------
; Positive offsets
; --------------------------------------------------------------

POS     DFB $AA

P01     DFW POS
P02     DFW POS+1
P03     DFW POS+2
P04     DFW POS+3


; --------------------------------------------------------------
; Negative offsets
; --------------------------------------------------------------

NEG     DFB $BB

N01     DFW NEG-1
N02     DFW NEG-2
N03     DFW NEG-3
N04     DFW NEG-4


; --------------------------------------------------------------
; Symbol before/after target
; --------------------------------------------------------------

        DFW SYM1          ; target is BEFORE SYM1

SYM1    DFB $11

        DFW SYM1          ; target is AFTER SYM1


; --------------------------------------------------------------
; Several consecutive positive offsets
; --------------------------------------------------------------

TABLE   DFB $10,$20,$30,$40,$50,$60

        DFW TABLE
        DFW TABLE+1
        DFW TABLE+2
        DFW TABLE+3
        DFW TABLE+4
        DFW TABLE+5


; --------------------------------------------------------------
; Word symbol
; --------------------------------------------------------------

WORD    DFW $1234

        DFW WORD
        DFW WORD+1
        DFW WORD+2


; --------------------------------------------------------------
; Negative offsets around a word symbol
; --------------------------------------------------------------

BASE    DFW $5555

        DFW BASE-1
        DFW BASE-2
        DFW BASE-3


; --------------------------------------------------------------
; Symbol far away
; --------------------------------------------------------------

FAR     DFB $66

        ORG $fffe

FARAWAY DFB $77

        DFW FARAWAY
        DFW FAR


; --------------------------------------------------------------
; $FFFD boundary
; --------------------------------------------------------------

        ORG $FFF0

BEFORE  DFW FARAWAY       ; target $FFFD, symbol is $FFFF

        ORG $fffc

LAST    LDA $99        ; LAST = $FFFF

        DFW LAST       ; target wraps past $FFFF if necessary
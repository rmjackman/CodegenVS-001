verify
 out lt
        ORG $DA00

ADR_1234 EQU $1234
ADR_5678 EQU $5678
ADR_7ABC EQU $7ABC
ADR_6000 EQU $6000
ADR_8000 EQU $8000


; ============================================================
; BASIC LOW/HIGH PAIRS
; ============================================================

        LDA #ADR_1234
        LDX /ADR_1234             ; & at DA00

        LDA /ADR_1234
        LDX #ADR_1234             ; @ at DA02


        LDA #ADR_5678
        LDX /ADR_5678             ; & at DA04

        LDA /ADR_5678
        LDX #ADR_5678             ; @ at DA06


; ============================================================
; SAME ADDRESS, REPEATED
; ============================================================

        LDA #ADR_7ABC
        LDX /ADR_7ABC             ; &

        LDA #ADR_7ABC
        LDX /ADR_7ABC             ; &

        LDA /ADR_7ABC
        LDX #ADR_7ABC             ; @

        LDA /ADR_7ABC
        LDX #ADR_7ABC             ; @


; ============================================================
; TWO PAIRS WITH NO INTERVENING SOURCE SYMBOL
; ============================================================

        LDA #ADR_6000
        LDX /ADR_6000             ; &

        LDA /ADR_8000
        LDX #ADR_8000             ; @


; ============================================================
; DIFFERENT 16-BIT VALUES
; Should cause 5A/5B handling rather than &/@
; ============================================================

        LDA #ADR_1234
        LDX /ADR_5678

        LDA #ADR_5678
        LDX /ADR_1234


; ============================================================
; LOW followed by LOW
; Should NOT produce &
; ============================================================

        LDA #ADR_1234
        LDX #ADR_1234


; ============================================================
; HIGH followed by HIGH
; Should NOT produce @
; ============================================================

        LDA /ADR_5678
        LDX /ADR_5678


; ============================================================
; THREE OCCURRENCES
; First two form a pair; third starts a new pending pair
; ============================================================

        LDA #ADR_1234
        LDX /ADR_1234             ; &

        LDA #ADR_1234             ; pending


; ============================================================
; THREE OCCURRENCES, HIGH FIRST
; ============================================================

        LDA /ADR_5678
        LDX #ADR_5678             ; @

        LDA /ADR_5678             ; pending


; ============================================================
; PAIR SEPARATED BY AN ORDINARY INSTRUCTION
; This should still pair if there is no symbol-table entry
; at the intervening address.
; ============================================================

        LDA #ADR_6000
        NOP
        LDX /ADR_6000


; ============================================================
; PAIR SEPARATED BY TWO ORDINARY INSTRUCTIONS
; ============================================================

        LDA #ADR_8000
        NOP
        NOP
        LDX /ADR_8000


; ============================================================
; SYMBOL/LABEL INTERRUPTION
; The DATA1 source line should prevent the preceding
; operand from pairing with the following one.
; ============================================================

        LDA #ADR_1234
DATA1   DFB $00
        LDX /ADR_1234


; ============================================================
; ANOTHER LABEL INTERRUPTION
; ============================================================

        LDA /ADR_5678
DATA2   DFB $00
        LDX #ADR_5678


; ============================================================
; EMPTY-SYMBOL SOURCE LINE / DATA
; ============================================================

        LDA #ADR_7ABC
        DFB $00
        LDX /ADR_7ABC


; ============================================================
; DIFFERENT VALUE AFTER INTERRUPTION
; ============================================================

        LDA #ADR_1234
DATA3   DFB $11
        LDX /ADR_5678


; ============================================================
; PAIR AFTER AN INTERRUPTED PAIR
; ============================================================

        LDA #ADR_6000
DATA4   DFB $22
        LDX /ADR_6000

        LDA #ADR_8000
        LDX /ADR_8000             ; &


; ============================================================
; REVERSE PAIR AFTER INTERRUPTION
; ============================================================

        LDA /ADR_6000
DATA5   DFB $33
        LDX #ADR_6000

        LDA /ADR_8000
        LDX #ADR_8000             ; @


; ============================================================
; EXPRESSIONS
; Check that the value used for pairing is the evaluated
; 16-bit value, not the textual symbol.
; ============================================================

ADR_1235 EQU ADR_1234+1
ADR_5677 EQU ADR_5678-1

        LDA #ADR_1235
        LDX /ADR_1235             ; &

        LDA /ADR_5677
        LDX #ADR_5677             ; @


; ============================================================
; SAME VALUE THROUGH DIFFERENT SYMBOLS
; ============================================================

ADR_A   EQU $6000
ADR_B   EQU $6000

        LDA #ADR_A
        LDX /ADR_B                ; &

        LDA /ADR_A
        LDX #ADR_B                ; @


; ============================================================
; HIGH/LOW USING EXPRESSIONS
; ============================================================

        LDA #ADR_1234+1
        LDX /ADR_1234+1           ; &

        LDA /ADR_5678-1
        LDX #ADR_5678-1           ; @


; ============================================================
; BACK-TO-BACK PAIRS OF OPPOSITE TYPES
; ============================================================

        LDA #ADR_1234
        LDX /ADR_1234             ; &

        LDA /ADR_5678
        LDX #ADR_5678             ; @

        LDA #ADR_7ABC
        LDX /ADR_7ABC             ; &

        LDA /ADR_6000
        LDX #ADR_6000             ; @


; ============================================================
; END
; ============================================================

        RTS
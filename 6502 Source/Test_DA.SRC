
        verify
        out lt
VALUE   EQU $A
NMIST   EQU $D40F

        ORG $4000

        DA 0,1,2,3,$FE,$FF

        DA $100
        DA $101
        DA $1234
        DA $FFFF

        DA 'A','A','B','C'

        DA $12,$34

        DA %00000001
        DA %11111111

        DA "AABC1234567890"

        DA \ABC

        DA /ABC/

        DA 1

        DA $1234

        DA 2

        DA $5678

        DA 3,$A,$B,$FF

        DA $100
        DA $104
        DA TARGET
        DA TARGET+1
        DA $4043
        DA TARGET
        DA TARGET+1
        DA TARGET+2
        DA TARGET+3
        DA TARGET+4
        DA $4043
begin   TAX
        TXA
        ASL !comment
        lda <#target
        sta 9 
        lda >#target 
        sta 10
TARGET  DA $11,$22,$33,$44,$55,#>target
        DA TARGET+4
        DA >$8090
        DA <$8090

        DA "END"

        DA 0

        DA TARGET

        DA 'X'

        DA 7

        DA %00001010
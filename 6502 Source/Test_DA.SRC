
        verify
        out lt
LABEL1  EQU $2AFE
LABEL2  EQU $3344
LABEL3  EQU $5678
LABEL4  EQU $ABCD

ZP1     EQU $40
ZP2     EQU $80

        ORG $2800

START   LDA #LABEL1
        LDX #LABEL1:H

        LDA #LABEL2
        STA ZP1

        LDX #LABEL3:H
        STX ZP2

        LDA #LABEL1
        LDX #LABEL2
        STA ZP1

        LDY #LABEL4:H
        LDA #LABEL4

        LDX #LABEL3
        RTS
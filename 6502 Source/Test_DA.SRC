
        verify
        out lt
LABEL1	EQU $2AFE
LABEL2	EQU $3344
LABEL3	EQU $5678
ZP1	EQU $40
ZP2	EQU $80

	ORG $2800

START
	LDA #LABEL1
	LDX #LABEL1:H
	LDY #LABEL2
	LDA #LABEL2:H

	STA ZP1
	STX ZP2

	LDA #LABEL3
	LDX #LABEL3:H
	LDY #LABEL3

	LDA #LABEL1
	LDY #LABEL2:H

	STA ZP1
	LDA ZP2

	JMP NEXT

NEXT
	LDA #LABEL2
	LDX #LABEL2:H
	LDY #LABEL1

	STA ZP2
	LDA ZP1

	RTS
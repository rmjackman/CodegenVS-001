verify
 out lt
*==============================================================
* IFNEST2.SRC
*
* Test: outer FALSE condition containing nested conditionals,
* followed by the outer .ELSE.
*
* This specifically tests that nested .ENDIF directives restore
* the correct outer conditional level.
*==============================================================

        ORG $5000


*--------------------------------------------------------------
* TEST 1
*
* A = 0
*
* The entire first branch is inactive.
* The nested .IF directives must NOT affect the outer .ELSE.
*
* Expected: $11
*--------------------------------------------------------------

        .DEFINE A 0
        .DEFINE B 1
        .DEFINE C 0

        .IF A

        .IF B

        LDA #$21
        STA $80

        .IF C

        LDA #$22
        STA $80

        .ELSE

        LDA #$23
        STA $80

        .ENDIF

        .ELSE

        LDA #$24
        STA $80

        .ENDIF

        .ELSE

T1      LDA #$11
        STA $80

        .ENDIF


*--------------------------------------------------------------
* TEST 2
*
* A = 0
*
* Two nested levels, each with an .ELSE.
*
* Expected: $33
*--------------------------------------------------------------

        .DEFINE A 0
        .DEFINE B 0

        .IF A

        .IF B

        LDA #$31
        STA $81

        .ELSE

        LDA #$32
        STA $81

        .ENDIF

        .ELSE

T2      LDA #$33
        STA $81

        .ENDIF


*--------------------------------------------------------------
* TEST 3
*
* A = 0
*
* Three nested levels.
* The deepest level contains another .ELSE.
*
* Expected: $44
*--------------------------------------------------------------

        .DEFINE A 0
        .DEFINE B 1
        .DEFINE C 1

        .IF A

        .IF B

        .IF C

        LDA #$41
        STA $82

        .ELSE

        LDA #$42
        STA $82

        .ENDIF

        .ELSE

        LDA #$43
        STA $82

        .ENDIF

        .ELSE

T3      LDA #$44
        STA $82

        .ENDIF


*--------------------------------------------------------------
* TEST 4
*
* Deliberately invalid source exists inside the inactive outer
* section.
*
* The outer .ELSE must still be reached.
*
* Expected: $55
*--------------------------------------------------------------

        .DEFINE A 0

        .IF A

        .IF B

THIS IS INVALID ASSEMBLER
@@@@@@ !!!!! $$$$$
NOT_AN_OPCODE $GGGG

        .IF C

        .DEFINE THIS_MUST_NOT_EXIST 123

        .ENDIF

        .ENDIF

        .ELSE

T4      LDA #$55
        STA $83

        .ENDIF


*--------------------------------------------------------------
* TEST 5
*
* After all nested conditionals, normal assembly must continue.
*
* Expected: $66
*--------------------------------------------------------------

T5      LDA #$66
        STA $84


*--------------------------------------------------------------
* End
*--------------------------------------------------------------

ENDTEST RTS
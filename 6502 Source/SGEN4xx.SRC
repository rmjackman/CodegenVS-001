*

FFG	DFB 0

*********** FINS: F insert new in V.3 ************

FINS	INC FFG
	LDY TOA
	BNE NOFF
	LDA TOA+1
	BNE NOFF
	JMP OPFL		if TOA == 0

NOFF	DEC FFG		not load file  FFG=0

	STY STAD		= TOA
	STY NDAD		= TOA

	MovaB STAD+1,TOA+1
	STA NDAD+1

	OPFL
	NOTE
	LDY NWA
	BNE ISNWA
	LDA NWA+1
	BEQ NONWA

ISNWA		STY NDAD
		STY ADR
		MovaB NDAD+1,NWA+1
		STA ADR+1

		POINT
		GETR
		BPL FI12

FIE1		LDY #$A
		JMP IOE

FI12		GETR
		BPL FIE1
		JMP FID2

NONWA	LDA FSEC,X
	STA ADR

FHILP		LDY SECSZ
		DEY
		TYA
		STA FBYT,X		

		LDA #$25	POINT
		STA ICCOM,X
		CIOV
		BMI FLOLP
		GETR
		BMI FLOLP

		CLC
		LDA NDAD
		ADC SECSZ
		STA NDAD
		BCC F21

		INC NDAD+1

F21		GETR
		BMI FID

		LDA #$26	NOTE
		STA ICCOM,X
		CIOV
		LDA FSEC,X
		INC ADR
		CMP ADR
		BEQ FHILP

F2E		LDY #$A4

FLOLP	CPY #$A4
	BNE F26
	JMP IOE

F26	LDA #0
	STA FBYT,X
	POIN

	LDA FSEC,X
	STA ADR

F24	GETR
	BMI FID
	IncW NDAD
		LDA #$26	NOTE
		STA ICCOM,X
		CIOV
		LDA FSEC,X
		CMP ADR
	BEQ F24
	BNE F2E

FID	LDA NDAD
	BNE FID1
	DEC NDAD+1
FID1	DEC NDAD

FID2	MovlB LPTR,0
	MovaW SKA,STAD
	PTHW
	PTSTR
	ASC \ \
	MovaW SKA,NDAD
	PTHW
	PRL

	OPFL
	JMP F6

*
OPFLI	LDA FLV
	CMP 'F'
	BNE OLI

	LDY #0		F: double density
	BEQ OL2
OLI	LDY $308		DBYTLO (SECTOR SIZE)
OL2	DEY
	DEY
	DEY
	STY SECSZ

	LDA FFG
	BEQ OI1

	CKFF
	RTS

OI1	PLA
	PLA
	RTS
*

RBTI	LDA FFG
	BEQ RI2

	JMP RD6B

RI2	SEC
	INC EOFG
	PLA
	PLA
	PLA
	PLA
	RTS
*

* Subroutine for C

CI	LDA LS
	BEQ CID
	CMP 'W'
	BNE CID

	INC C3F
	MovlB CHIF,0
	MovlB PFG,1
	JMP API
CID	RTS

*
APINS	RBT

	LDY C3F
	BEQ CID

	LDY CHIF
	BNE CI1

CI2	CMP NWA
	BNE CDADR

	INC CHIF
	BNE CDADR

CI1	DEC CHIF
	CMP NWA+1
	BNE CI2	

	DecW SKA
	MovaW ADV,SKA
	MovlB LPTR,0
	PTHW
	WRL
	GETC
	CMP #ESC
	BNE CDADR

	JMP DSI	

CDADR	DADR
	CmpaW ADR,TOA
	BEQ JDSI
	LDY #39
	LDA ADR+1
	STA (88),Y

	JMP AP

JDSI	JMP DSI
CHIF	DFB 0

***

HATED	EQU $321		E: pointer
HATKB	EQU $327		K: pointer
TEXT	EQU $BE00
NEWED	EQU $BE70
NEWKB	EQU $BE78

EOL	EQU $9B		
ESC	EQU $1B

START	MovaW EDADV,HATED
	MovaW KBADV,HATKB
	MovlW HATED,NEWED	new E: routine
	MovlW HATKB,NEWKB	new K: routine

	LDY #0		start with 8 not 0
	STY TXPT
SH1	LDA (EDADV),Y
	STA NEWED,Y
	LDA (KBADV),Y
	STA NEWKB,Y

	INY
	CPY #8
	BNE SH1

	MovlB NEWED+4,EGTBYT-1
	STA NEWKB+4
	MovlB NEWED+5,EGTBYT-1:H
	STA NEWKB+5

	RTS
*
EGTBYT	LDY TXPT
	LDA TEXT,Y
	CPY MAX
	BNE H2

	LDY EDADV
	STY HATED		
	LDY EDADV+1
	STY HATED+1

	LDY KBADV
	STY HATKB		
	LDY KBADV+1
	STY HATKB+1

H2	INC TXPT
	LDY #1
	RTS


MAX	DFB 0




*
CKSEGTAB MovlB SEGNO,0
	
NEXTSEG	LDA SEGNO
	ASL
	ASL
	TAX
	INC SEGNO	1 2
	LDA CNT1
	CMP SEGNO
	BCC END		not found

	LDA SKA+1
	CMP SEGTAB+1,X
	BNE EEE
	LDA SKA
	CMP SEGTAB,X
	
EEE	BCC NEXTSEG	BRA if adr < from_adr
	
	LDA SEGTAB+3,X
	CMP SKA+1
	BNE EEE2
	LDA SEGTAB+2,X
	CMP SKA
EEE2	BCC NEXTSEG	bra if to_adr < adr
	
END	RTS		found:- CS		
*
F1STSEG	CKSG
	BCS SST2

	OPFL
SSTLP	  RD6B1		* RD6B sets STAD,NDAD,DSEC,DBYT
	  CKSG		stad <= ad <= ndad
	  BCS SST2		yes

	  MovaW ADR,NDAD		no
	  DADR
	  POINT
	  BPL SSTLP	loop always

SST2	RTS
*
CNT1	DFB 0
STADSV	DFW 0
NDADSV	DFW 0
DSECSV	DFW 0
DBYTSV	DFB 0

*
SETSGTAB	LDA FFG
	BEQ END
	
	F1STSEG

	MovaW SEGTAB,AD	 - set first entry
	MovaW STADSV,STAD
	MovaW NDADSV,NDAD
	MovaW DSECSV,DSEC
	MovaB DBYTSV,DBYT
	LDX #0
	MovlB CNT1,1

SSTLP2	  TOAINSEG	  
	  BCS SSTEND		exit
	  
	  MovaWX SEGTAB+2,NDAD
	  MovaW ADR,NDAD
	  DADR
	  POINT
	  RD6B2

	  LDA CNT1
	  ASL
	  ASL
	  TAX
	  INC CNT1
	  MovaWX SEGTAB,STAD
	  JMP SSTLP2		loop

SSTEND	MovaWX SEGTAB+2,TOA
RESTSEG	  MovaW STAD,STADSV
	  MovaW NDAD,NDADSV
	  MovaW DSEC,DSECSV
	  MovaB DBYT,DBYTSV

	RTS
	
#	'#' causes the following lines to be ignored up until the next '#'.	
	ORG $600
	RTS
			  

SAVV1	DFW 0
SAVV2	DFW 0
SAVV3	DFW 0
SAVV4	DFW 0

MESSAGE	PHP
	PHA
	TXA
	PHA
	TYA
	PHA

	MovaW SAVV1,ZF
	MovaW SAVV2,SKA
	MovaW SAVV3,STAD
	MovaW SAVV4,NDAD
		
	PRL
	PutS \ZF=\
	PutW ZF

	PutS \ SKA=\
	PutW SKA

	PutS \ STAD=\
	PutW STAD
	PutS \ NDAD=\
	PutW NDAD
	
	PRL

	MovaW ZF,SAVV1
	MovaW SKA,SAVV2
	MovaW STAD,SAVV3
	MovaW NDAD,SAVV4
	

	PLA
	TAY
	PLA
	TAX
	PLA
	PLP
	RTS
#

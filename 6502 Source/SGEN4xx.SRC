	PLA
	TAY
	LDA $21
	RTS
**************************************

ANO1	MovaW PVA,PVAV
ANO	MovaW SKAV,SKA
	MovlB ANF,0
	STA AOF
	LDA PVA+1
	BEQ AOD

	LDY #1
	LDA (PVA),Y
	TAX
	INY
	LDA (PVA),Y
	BMI MANO

	LDY #0
	CLC
	ADC (PVA),Y
	TAY
	BCC AO1

	INX
AO1	CPX SKA+1
	BNE AO2

	CPY SKA
AO2	BCC MANO

	LDY #4
	LDA (PVA),Y
AOY	CKTY
	BCC AO3

	MovlB ANF,1
	BNE AOD

AO3	MovlB ANF,128
	SEC
	RTS
*
MANO	LDA SEF
	BNE AOD

	INC AOF
	LDY #1
	LDA (ADR1),Y
	STA TMP+1
	INY
	LDA (ADR1),Y
	BPL AOD

	LDY #0
	CLC
	ADC (ADR1),Y
	STA TMP
	BCS AO6

	DEC TMP+1
AO6	CmpaW SKA,TMP
	BCC AOD

	LDY #4
	LDA (ADR1),Y
	JMP AOY

AOD	LDA ANF
	CLC
	RTS
*
WBL	WIS BLB
	BCC WD

WBL1	PutS \H\
	CLC
	ROR CNT+1
	ROR CNT
	MovaW $20,SKA
	EquSum SKA,CNT,LOFST
	PTHW
	MovaW SKA,$20
	SEC
WD	RTS
**************************************
*** A1MX.w = SYTL.w + SYMTAB.b
AJA1MX	MovaB A1MX,SYTL	
	CLC
	LDA SYTL+1
	ADC SYMTAB
	STA A1MX+1
	RTS
*** ADR1 > A1MX?
CA1MX	CmpaW ADR1,A1MX
	RTS
**************************************
*** K.Keys
KKEYS	Cmpl TOA,10
	BCS KD
	ASL
	TAX
	MovaWX FKTB,AD
KD	RTS
**************************************
*** Initialize lable tables
ITLB	LDY #13 
loop	LDA DLB-1,Y
	STA LBTB,Y
	DEY
	LDA #0
	STA LBTB,Y
	DEY
	DEY
	BPL loop
	RTS

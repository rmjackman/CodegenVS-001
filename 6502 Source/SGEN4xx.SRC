**********************************************************************************
************************ S O U R C G E N Reasembler for Atari 8-Bit **************
**********************************************************************************

* ( Set the TAB of your text editor to 9 for correct display. )
*
* ATMAS-II compatible Source code
* Assemble using the CODEGEN Macro ASSEMBLER for PC
*
* CODEGEN will create a Load-File and save it to an ATR or XFD-disk image file.
* Change the name of the following disk image file ( W1_DD.XFD ) as required:


	XFDIMAGE SGEN32.ATR	DOS 2.5 -- Use SAVEAS AUTORUN.SYS
*	XFDIMAGE W1_DD.ATR	TURBO DOS -- deactivate SAVOBJAS when using this


* CODEGEN will then start your Atari800 emulator and boot the XFD-disk image file.
* Please check the following path and file; change if necessary:


	RUNEMUL "C:\Program Files (x86)\Atari800WinPLus\Atari800Win.exe"


* Use the CPFL directive to compare the generated code with another file

	CPFL SGEN32.LOAorig
	
	SAVEAS AUTORUN.SYS		when using ATARI DOS 2.5
	APPEND FRAMDISK		under DOS 2.5 FRAMDISK should be appended to AUTORUN.SYS
	ADDTOIMG AUTOLOAD.SMB	add AUTOLOAD.SMB to disk image.  (required)
	ADDTOIMG AUTORUN.SMT	add SGEN32.SMT to disk image.  (optional)
	
* Use the OUT directive to create a text output file with the extension ".LIS"
*            L: Listing will be creatied. Assembly and CPFL mismatches will be shown.
*            LM: Macros will not be expanded, and assembly and CPFL mismatches will not be shown.
*            N: Symbol table will be listed.
*            T: SOURCGEN symbol table will be listed.
* OUT can be placed anywhere in the source code. OUT with no parameters terminates the listing.
	RUNEMUL "C:\Program Files (x86)\Atari800WinPLus\Atari800Win.exe"
	INCLUDE if_while_macros.src
	INCLUDE Macros.SRC
	OUT L
	
COPN	EQU 3
CGTXTR	EQU 5
CGBINR	EQU 7
CPTXTR	EQU 9
CPBINR	EQU $B
CNOTE	EQU $26

*MMMMM	EQU $D40F
CRSINH	EQU $2F0
DSPFLG	EQU $2FE
ICCOM	EQU $342
ICBADR	EQU $344
ICBLEN	EQU $348
ICAX1	EQU $34A
CIOV	EQU $E456
RAMTOP	EQU $6A

INIT	EQU $600
BEGAD	EQU $6FA

*YTIT


SDLSTL	EQU $230

COLOR0	EQU $2C4

VCOUNT	EQU $D40B
**


	ORG $4D00

BEGIN	LDA #$C0
	CMP RAMTOP
	BEQ YL0

	BCS YL1

	STA RAMTOP
*?
YL0	LDA #OKTXT
	LDX #OKTXT:HI
	JSR TITLE
	RTS

YL1	LDA #ERRTXT
	LDX #ERRTXT:HI
	JSR TITLE
ERROR	JMP ERROR

TITLE	STA TXTADR
	STX TXTADR+1
	LDY VCOUNT
	CPY #$7A
	BNE TITLE

	LDY #0
	STY COLOR0+2
	LDY #$C
	STY COLOR0+1
?
	LDA #NEWDLST
	LDX #NEWDLST:HI
	STA SDLSTL
	STX SDLSTL+1
	RTS

NEWDLST	DFB $70,$70
	DFB $70,$70,$70,$70,$70,$42
	DFW TTEXT
	DFB $70,7,$70,2,$70,$70,$42
TXTADR	DFW OKTXT	or errtxt
	DFB $41
	DFW NEWDLST

TTEXT	ASC %RE-ASSEMBLER for the%
	ASC % ATMAS-II assembler %
	ASC %   SOURCGEN V.3.2   %
	ASC % Copyright 1988-2003%
	ASC % by Richard Jackman %
* 4CA5
OKTXT	ASC %    www.richard-jack%

	ASC %man.de/atari_xl     %
* 4CCD
ERRTXT	ASC $requires 48K- Press $
	ASC $OPTION when booting.$

	DFB 0

*	INCLUDE Macros.SRC
*

ADR1	EPZ $80	w
ADR2	EPZ $82	w
LEN	EPZ $84	w
ERNO	EPZ $86	w
NDAD	EPZ $88	w
SFC	EPZ $8B
AD	EPZ $8C	w
TOA	EPZ $8E	w
NWA	EPZ $90	w
SKAV	EPZ $92	w
PVAV	EPZ $94	w
ADR1V	EPZ $96	w
CHC	EPZ $98	w
STAD	EPZ $9A	w
A1MX	EPZ $9C	w
TV	EPZ $9E	w

GTC	EPZ $A0	b
HF	EPZ $A1	b
LSV	EPZ $A2	w


TXPT	EPZ $A9	b
EDADV	EPZ $AA	w
KBADV	EPZ $AC	w


OLL	EPZ $AE	b

SCTP	EPZ $B0

SWTP	EPZ $B2	b
TPNO	EPZ $B3	b
LBFG	EPZ $B4	b
STKV	EPZ $B5	b
ANF	EPZ $B6	b
ADR1OF	EPZ $B7	b
XSAV	EPZ $B8	b
PRF	EPZ $B9	b
PFG	EPZ $BA	b
AOF	EPZ $BB	b
SEF	EPZ $BC	b
BV	EPZ $BD	b
SPV	EPZ $BE	B

BTC	EPZ $BF	W
LFG	EPZ $C1
JF1	EPZ $C2
JF2	EPZ $C3
HIF	EPZ $C4
JKF	EPZ $C5
JKF1	EPZ $C6
HLFG	EPZ $C7
ZZF	EPZ $C8
SKF	EPZ $C9
HIF1	EPZ $CA
SP	EPZ $CB
TF	EPZ $CC
CBF	EPZ $CD
C3F	EPZ $CE
EOFG	EPZ $CF

SAV	EPZ $D0
A1S	EPZ $D2
SYA	EPZ $D4
NWAS	EPZ $D6
AD1V	EPZ $D8

TCT	EPZ $DE
BT1	EPZ $E0
BT2	EPZ $E1
BT3	EPZ $E2

A1	EPZ $E4
A2	EPZ $E6
A3	EPZ $E8
SKA	EPZ $EA
ADR	EPZ $EC
JJ	EPZ $EE
LPTR	EPZ $F0
*A4	EPZ $F2

FG	EPZ $F5
BYT	EPZ $F6
CNT	EPZ $F7
TMP	EPZ $F9
PVA	EPZ $FB
JMPAD	EPZ $FD	w

CURSUP	EQU 28
DBS	EQU 126


SVL	EQU NWA
RC	EQU $54
PORTB	EQU $D301

	ORG $2E0
	DFW GENBEG	RUNAD
	DFW BEGIN	INITAD


	ORG $5640

*** If ":" not found, "D:" is assumed ***
*** If found, could be D:,F:,P:,S:etc ***

adjstDX	LDA ':'
	CMP LS+1
	BEQ cont
	CMP LS+2
	BEQ cont

	LDY NML
	INC NML
	INC NML
	LDX NML

do	LDA LS,Y		'X'
	  STA LS,X	
	  DEX
	  DEY
	  whilePL

	LDA 'D'
	STA LS
	LDA ':'
	STA LS+1

cont	RTS	

*	LDY 0		write filename
*adj1	LDA LS,Y
*	PTCH
*	INY
*	CPY NML
*	BNE adj1
	
*	GETC
*	RTS

	ORG $2200

GENBEG	JMP BEG

PKT	DFB 9,192,226,20,3   colours etc.

SK	EQU $100


SCREEN	EQU $4C20
CRAMTOP	EQU $50
FKTB	EQU $5000
FLV	EQU $5000+20
LS	EQU $5000+35
LN	EQU $5090
OSV	EQU $50E0
FTV	EQU $50F0
X	EQU $56
SEGTAB	EQU $5680

OUTMENSV	EQU $BC00

DLB	DFB X
DLE	DFW 0
ZLB	DFB X+1
ZLE	DFW 0
BLB	DFB X+4
BLE	DFW 0
JLB	DFB X+$C
JLE	DFW 0
TLB	DFB X+$11
TLE	DFW 0
SYMTAB	DFB X+$17
SYTL	DFW 0
RAMTOPSV	DFB $BC
LBTB	ASC "DDDZZZHHHJJJTTT"
LOFST	DFW 0
SGFG	DFB 0
ADRV	DFW 0
FLFG	DFB 0
DFG	DFB 0
ZF	DFB 0
MNLB	DFW $80
ADV	DFW 0
TYTB	ASC ".(;!'\#"
	DFB '"'
	ASC "=-%$*&<_|@"
	ASC /=-/
	DFB 0,0
TPRTB	DFW TXTY,W,W,W,W,ASTY
	DFW DBTY,STRTY,DWE,DWM
	DFW BITY,STRTY,OGTY,W,W
	DFW DWM,DWE,W,DWE,DWM,0

ANFV	DFB 0
J9FG	DFB 0
ODF	DFB 0
TBMP	DFB 0,$40,$20,$10,$08
BGFG	DFB 1
LODAUTFG DFB 0

BEG	CLD

	MovaW JDOS+1,$C
	MovlW $C,JDOS		dosini
	LDX #$FF
	STX 8
	INX
	STX $244
	INX
	STX 9
	LDA BGFG
	BEQ BG1

	MovlB A1MX,0		a1mx = SYMTAB
	MovaB A1MX+1,SYMTAB
	MovlB FLV,0
	STA CBF

BG1	TSX
	STX STKV

	MovlB RAMTOP,CRAMTOP

	OpenX $20,12,'E'
	OpenX $30,4,'K'

	LDX #4
do	LDA TBMP,X
	STA 675,X
	DEX
	whilePL

	MovlB 709,5
	MovlB 82,0		LMARGN
	STA BGFG
	STA SWTP
	QUE
DSI	LDX STKV
	TXS

	LDA LODAUTFG
	ifEQ
	  INC LODAUTFG
	  NEW

endif	MovaW 709,PKT	colours
	MovaB 712,PKT+2	   |
	MovaW 729,PKT+3	cursor speed

	J600

	LDA CBF
	ifNE
	LDA FLFG
	ifNE

	MovlB OPD1+1,4
	OPFL

endif	LDX #EOFG-BTC	initialize zero page
	LDA #0		variables
do	STA BTC,X
	DEX
	whilePL

	AJA1MX

	LDA ZF
	ifNE
	  DEC ZF		header
	  INC ZZF
	  LHEAD
	  LDA FFG
	  BEQ +
	    RESTSEG
+	  JMP API

endif	LDA DFG
	BEQ DSI1

	TAX
	Cmpl NWAS,$A	third value e.g. for P:
	BEQ cont
	Cmpl LS,'D'
	BNE cont
	LDA #0	
	STA ICBLEN,X	
	STA ICBLEN+1,X
do	DEC A1		fill with $FF
	BEQ cont
	LDA #$FF
	CIOV
	whilePL
	JMP IOE

cont	ComCiov $C
DSI1	MovlB PRF,0
	STA CRSINH
	STA DSPFLG
	STA PFG
	STA DFG
	STA EOLFG
	Dsta TOA
	STA 694
	STA $55
	MovlB ICAX1+$20,12
	MovlB 702,64
	MovlB $54,23
	LDX #$70				sg31
	ComCiov $C	close printer	sg31
	PRINT
	DFB 156
	ASC "?"		print prompt: ?
	DFB 0
	INPT
	JMP DSI
*
CKSG	CmpaW AD,STAD
	BCC CKS
	CmpaW NDAD,AD
CKS	RTS
*
API1	PRINT
	DFB EOL,0
API2	ClearW TOA

API	LDA FFG
	ifNE

	F1STSEG
	
endif	LDA AD	     was MovaW ADR,AD
         STA ADR		MovaW ADV,ADR
         STA ADV
         
         LDA AD+1
         STA ADR+1
         STA ADV+1
	
	LDA ZZF
	ifNE

	PTORG
	PutW ADR
	PRL
	PRL
endif	MovlB LPTR,0
	FTY
	CHKTOA
	ITLB

AP	LDX STKV
	TXS
	LDA EOFG
	BNE APD

	LDA SGFG
	ifNE

	 PRL
	 PRL
	 PTORG
	 PutW STAD
	 PRL
	 PRL
	 FTY
	 ITLB

endif	MovlB HLFG,0
	STA LBFG
	STA J9FG
	LDA FLFG
	BEQ APC11

	  TOAINSEG

	  BCC AP11		NDAD < TOA  ie. TOA not in segment

APC11	CmpaW TOA,ADR
	BCS AP11			ADR <= TOA

	    LDA ZZF		ADR > TOA
	    BEQ APD
		PutW BTC
		PutS \ bytes\
		WRL
APD	    JMP DSI

AP11	MovaB SKA,ADR
         STA ADRV 	
	MovaB SKA+1,ADR+1
         STA ADRV+1        
	Cmpl 53279,7		consol
	BCC APD

	LDA OLNFG
	ifNE

	  DEC OLNFG
	  LDA OLNFG
	  BEQ APD
	
endif	APINS

	BCC +
	JMP AP

+	MovlB BT1,156
	WCM1
	ADNM1
	MovlB SKF,0
	LDA CBF
	BNE +
	LDA FG4
	BMI AP1
+	PTFG4
	LDA CBF
	BNE +
	JMP WI3

+	DEC CRSINH
	PRINT
	DFB 28,127,0	up, tab
	MovaW LEN,ADR
	INPP
	LDA #$FF
	Dsta TOA
	MovaW ADR,LEN
	BC
	RBT
	PRINT
	DFB 28,0
	PTFG4
WI3	DADR
	JMP AP

AP1	DADR
	LDA SCTP
	SWTYP
	CKTY
	BCC W

	LDA TPNO
	ASL
	TAX
	LDA TPRTB,X
	STA XX+1
	LDA TPRTB+1,X
	STA XX+2
XX	XX
	JMP AP2

W	INC LBFG

	TABR
	PTOPCD

	LDA BYT
	TAX
	AND #$1F
	STA JJ
	TAY

	BBB

	PRL
	LDX TF
	ifNE
	Cmpl BT1,32	jsr no
	BEQ DOT
	Cmpl JJ,16
	BEQ DOT
	LDA SKF
endif	BNE DOT
	JMP AP

DOT	PRINT
	ASC "<R><T><*><RET>
	DFB 0
	GETC
	BMI ALE
	PHA
	PRINT
	DFB $9C,0
	PLA
	CMP #ESC
	BEQ AP3

	CMP 'R'
	BEQ RT1
	CMP '*'
	BNE +
	JMP TR1

+	CMP 'T'		trace
	BNE DOT

	Cmpl BT1,32	jsr no
	ifEQ

	LDY SP
	LDA ADR
	STA SK,Y
	INY
	LDA ADR+1
	STA SK,Y
	INY
	JMP APF

endif	CMP #108
	BEQ APE
	CMP #64
	BEQ APE
	CMP #96
	BNE AP4

RT1	LDY SP
	BEQ APE
	DEY
	LDA SK,Y
	STA SKA+1
	DEY
	LDA SK,Y
	STA SKA
APF	STY SP
	STY SPV
AP4	MovaB AD,SKA
	STA TV
	MovaB AD+1,SKA+1
	STA TV+1
	PutS \*****\
	LDA SP
	LSR
	PHB
	PRL
	JMP API
AP2	PRL
AP3	JMP AP

APE	LDY #$F
ALE	JMP IOE
*
PTORG	PRL
	TABR
	PutS \ORG $\
	RTS
*
OGTY	DecW ADR
	TABR
	PutS \ORG *+$\
	ClearW TCT
OT1	IncW TCT
	CKNA
	BCC OT1
	PutW TCT
	JMP PRL
*
DFWTY	LDA BYT
	PHA
	CKNA1
	BCS DW7

	LDA ADR
	AND #1
	CMP ODF
	BNE DW4

DW7	PLA
	STA BYT
	PLA
	PLA
	MovlB TCT,1
	JMP DFBT1

DW4	LDA SCTP
	BMI DW5

	MovaB SKA+1,BYT
	PLA
	STA SKA
	JMP DW6

DW5	MovaB SKA,BYT
	PLA
	STA SKA+1

DW6	DADR
	TABR
	PutS \DFW \
	MovlB CHC,0
	INC LBFG
	RTS
*
DWM	DFWTY
	IncW SKA
	ADNM2
	PutS \-1\
	JMP WCM2
*
DWE	DFWTY
	LDA SKA
	BNE DWD
	LDA SKA+1
	BNE DWD

	PutS \0\
	RTS

DWD	JMP B3D

*
NORTZ	ASC "%"
INVTZ	ASC "$"
*
STRTY	AOI
	BPL WS

	AND #%01100000
	BNE WASC

STT1	PTDB
	LDA BV
	JMP PHB

WS	Cmpl BV,EOL
	BNE WS1

	PTDB
	JMP WEOL

WS1	STT1
	PutS \ [S]\
	RTS

WASC	PTAS
	LDA BYT
	BMI ASCINV

	LDA NORTZ
	PTCH

AS6	LDA BYT
	BMI ASCD

	PTCH
	CKNA
	BCS ASCD

	AOI
	BPL ASCD

	AND #%01100000
	BEQ ASCD

	DEC TCT
	BNE AS6

ASCD	LDA NORTZ
	AND #%01111111
	JMP PTCH
*
ASCINV	LDA INVTZ
	AND #%01111111
	PTCH

AV6	LDA BYT
	BPL AVND
	AND #%01111111
	PTCH

	CKNA
	BCS AVND

	AOI
	BPL AVND

	AND #%01100000
	BEQ AVND

	DEC TCT
	BNE AV6

AVND	LDA INVTZ
	JMP PTCH
*
AOI	MovaB BV,BYT
	MovlB NORTZ,'"'
	MovlB INVTZ,'/'
	Cmpl SCTP,'"'
	BEQ CFK

	MovlB NORTZ,'%'
	MovlB INVTZ,'$'
	LDA BYT
	LDX #0
ATLP	CMP #32
	  BCC TYE2
	  INX
	  SBC #32
	  JMP ATLP

TYE2	ADC ASTB,X
	STA BYT
*
CFK	LDA BYT
	LDX #16

FKL	DEX
	BMI CFKD
	CMP FKYTAB,X
	BNE FKL

CFKD	RTS
*
********  
TXTB1	DFB $0D,$0A	$84,$94,$81,$8E,$99,$9A,$9E,	
TXTB2	DFB EOL,0	$0B,$0F,$0A,$7B,$0C,$10,$22,
TXTY	MovlB TCT,40
	DecW ADR

TXT1	LDA BYT

	LDY #TXTB2-TXTB1
TX12	DEY
	BMI TX11
	CMP TXTB1,Y
	BNE TX12
	
	LDA TXTB2,Y
	BEQ TX13		skip cha

TX11	CMP #155
	BEQ TXT3

	PTCH
	DEC TCT
	BEQ TXT3

TX13	CKNA
	BCS TXTD
	BCC TXT1		do

TXT3	DADR

TXTD	RTS
*
DBTY	MovlB TCT,6
DFBT1	DecW ADR
	PTDB

DFB1	LDA BYT
	PHB

	DEC TCT
	BEQ DFB3

	CKNA
	BCS DFBD
	PutS \,\
	JMP DFB1

DFB3	DADR
DFBD	RTS
*
CKNA	DADR
	JMP CKNA1
*
FTY	MovaW SKA,ADR
	FADR1
	PHP
	MovaW ADR1V,ADR1
	MovaW PVAV,PVA
	PLP
	BNE Y

	LDY #0
	LDA (PVA),Y
	AND #1
	STA ODF

	DecW ADR1
	LDA (ADR1),Y
	SWTYP
	STA SCTP
Y	RTS

*
PICTAB	DFW IPT1,SETED,SETED,SETED,SETED	
	DFW ONELN,INPT,INPT,INPT,INPT
	DFW INPT,INPT,INPT,INPT,INPT
	DFW TR,PL,FRE,MI,MENUE,QUE
	DFW Z,U,U,U,U,U,Z,Z,Z,Z,Y
	DFW LST,ONEL,SAME,ONEG,ONELN
	DFW START,A,B,C,D,EDIT,FILE
	DFW GO,HEAD,INDEX,JUNK,KEYS,L
	DFW MINLAB,NEW,OBTAIN,PREPARE,QUIT
	DFW R,S,TRACE,UTILITY,0
OLNFG	DFB 0

ONELN	MovlB OLNFG,2
	JMP IPT1

ONEL	DecW ADV
	JMP OG1

ONEG	IncW ADV

OG1	PRINT
	DFB EOL,EOL,0
SAME	MovaW AD,ADV
	PRINT
	DFB EOL,0
	JMP API1
*
MINLAB	MovaW MNLB,ADR
	RTS
*
QUE	PRMEN
	LDX #0
	STX XSAV
	MovlB CNT,'A'
	BNE WG3

WGLP	STX XSAV
	LDA GTAB-1,X
	BEQ WGD
	BPL WG1

	AND #127
	PUTR
WG3	PRINT
	DFB EOL,127,0
	Cmpl CNT,'V'
	BEQ WGD

	PUTR
	INC CNT
	PRINT
	ASC ". "
	DFB 0
	JMP WG2

WG1	PUTR
WG2	LDX XSAV
	INX
	BNE WGLP

WGD	RTS
*
QUIT	Cmpl AD,1
	BNE WGD

	MovlB LS,0
	STA CRSINH
	PRINT
	ASC "SAVE? Y/N"
	DFB EOL,0
	GETC
	CMP 'N'
	BEQ Q1
	LDA 'S'
	NP
	JMP DSI

Q1	MovaW $C,JDOS+1
	MovlB RAMTOP,$C0
	JMP QI

JDOS	JSR 0
	MovaB RAMTOP,RAMTOPSV
	JMP BG1
*
IPT1	MovaW AD,ADRV	EOL
	WDBS
	JMP API
*
SETED	LDA 'E'
	BNE CMPQ
*
INPT	MovlB LS,0
	STA CRSINH
	GETC
	AND #%01111111	include inverted
NP	INC CRSINH
	STA GTC


CMPQ	CMP 'v'		Letter after u
	BCS INPT
	CMP #ESC		ESC - first FKey
	BCC INPT
	PHA

	CMP 'A'
	BCC FJA
*			have A - U
	AND #%11011111	include lower case
	CMP 'V'		Letter after U
	BCS INPT
	
	PHA
	WDBS
	PLA

	SEC
*	STA $4C40+80	screen
	SBC 'A'
	TAX

	LDY #$FF

FNDGT	INY
	DEX
	BMI FGT2

FGT1	LDA GTAB,Y
	BMI FNDGT
	INY
	BNE FGT1	J

FGT2	LDA GTAB,Y
	BMI FJA

	DEY

FGT3	INY
	TYA
	PHA
	LDA GTAB,Y

	AND #%01111111

	PUTR

	PLA
	TAY
	LDA GTAB,Y
	BPL FGT3

	DEC CRSINH
	PRINT
	DFB '>',EOL,0

	INPP

	MovaW NWAS,NWA
FJA	PLA		Have FKey
*	ORA #%00100000
	SEC
	SBC #$1B		ESC- First Fkey
	ASL
	TAX
	LDA PICTAB,X
	STA JMPAD
	LDA PICTAB+1,X
	STA JMPAD+1
	JMP (JMPAD)
*
INPP	INP2LS
	BMI IERR

	INC CRSINH
	JMP INO

IERR	JMP IOE

************ print opcode *****************

OPFG	DFB 0
PTOPCD	LDY BYT		better 	LDX BYT
	LDA OPOF,Y		LDY OPOF,X
	TAY			don't need TAY
	STY OPFG
	LDX #3

PAB1	LDA OPCDTB,Y	put three characters
	PTCH
	INY
	DEX
	BNE PAB1
	RTS
*******************************************
BBB	MovaB BT1,BYT
	LDA OPFG
	BNE B13

	LDA ZF
	BEQ B1P

	PTHW
	MovaW ADV,SKA
	WRL
	LDY #$C
	JMP IOE


	MovAW AD,ADV
	JMP API1
*** List next line ***
fQUEST	MovlB OLNFG,2
	JMP fESC
*** List from (last address) - 1
fLEthan	DecW ADV
	JMP +
*** List from (last address) + 1
fGRthan	IncW ADV

+	PRINT
	DFB EOL,EOL,0
*** List from last entered address
fEQUAL	MovaW AD,ADV
	PRINT
	DFB EOL,0
	JMP API1
*** Set minimum label
MMINLAB	MovaW MNLB,ADR
	RTS
*** Go to Main Menu
fSLASH	PRMEN
	LDX #0
	STX XSAV
	MovlB CNT,'A'
	BNE +

WGLP	STX XSAV
	  LDA MenTab-1,X
	  BEQ WGD
	  BPL skip

	    AND #127
	    PUTR
+	    PRINT
	    DFB EOL,TAB,0
	    Cmpl CNT,'V'
	    BEQ WGD

	    PUTR
	    INC CNT
	    PRINT
	    ASC ". "
	    DFB 0
	    JMP WG2

skip	  PUTR
WG2	  LDX XSAV
	  INX
	  BNE WGLP

WGD	RTS

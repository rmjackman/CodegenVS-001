	JMP CKNA1
	

	
*** Find type (SCTP)
FTY	MovaW SKA,ADR
	FADR1
	PHP
	MovaW ADR1V,ADR1
	MovaW PVAV,PVA
	PLP
	BNE YY

	LDY #0
	LDA (PVA),Y
	AND #%00000001
	STA ODF

	DecW ADR1
	LDA (ADR1),Y
	SWTYP
	STA SCTP
YY	RTS		YY is in PICTAB

OPCtab	ASC " ? ANDASLBCCBCSBEQBITBMI
	ASC "BNEBPLBRKBVCBVSCLCCLDCLI
	ASC "CLVCMPCPXCPYDECDEXDEYEOR
	ASC "INCINXINYJMPJSRLDALDXLDY
	ASC "LSRNOPORAPHAPHPPLAPLPROL
	ASC "RORRTIRTSSBCSECSEDSEISTA
	ASC "STXSTYTAXTAYTSXTXATXSTYA
	ASC "ADC
*

*** Menu A to U
MenTab	ASC \ADDRESS/symbol-search\
	ASC \BYTE-change\
	ASC \CODE-find\
	ASC \DELETE symbols\
	ASC \EDIT symbols\
	ASC \FILE\
	ASC \GO\
	ASC \HEAD\
	ASC \INDEX\
	ASC \JUNK?\
	ASC \KEY <0-9>\
	ASC \LIST symbols\
	ASC \MINIMUM-label\
	ASC \NEW\
	ASC \OBTAIN symbols\
	ASC \PREPARE labels\
	ASC \QUIT (1)\
	ASC \RE-ADDRESS symbols\
	ASC \SAVE symbols\
	ASC \TRACE\
	ASC \UTILITY\
	
*	OUT L
	DFB 0
*	OUT


TEMP	EPZ $4A

HATABS	EQU $31A


*SG ROUTINES



	ORG $5100


FSEC	EQU $34C		ICAX3,X
FBYT	EQU $34E		ICAX5,X


SECSZ	DFB 125
*** output menu item offsets
MTAB	DFB 10,30,10,10,10,20,10,10,0
*** Check for F-disk
J600	MovlB RDFG,0
	LDY #3
	MovaW TEMP,JIN+1	TEMP=600
	LDA (TEMP),Y	check two bytes
	CMP #HATABS
	BNE skip
	  INY
	  LDA (TEMP),Y
	  CMP #HATABS:H
	  BNE skip

	    INC RDFG

JIN	    JMP INIT		f-disk exists

skip	RTS		does not exist

RDFG	DFB 0



*** NOT ENOUGH ROOM
ERR	LDY #9
	JMP IOERR

***U.Utility
UUTILITY	LDX #$FF
-	INX
	LDA LS,X
	CMP #EOL
	BEQ skip
	  CMP ';'
	  BNE -

	  LDY #$FF
loop	  INY
	  STY MAX
	  INX
	  LDA LS,X
	  STA TEXT,Y
	  CMP #EOL
	  BEQ +

	    CMP '^'
	    BNE loop

	    LDA #EOL
	    STA TEXT,Y
	    BNE loop

+	      JMP SHIFT8	(RTS)

skip	LDA AD
	CMP #$39
	BCC C11

	SBC #$38
	STA TEMP
	LDA #$BC
	SBC TEMP

	CMP A1MX+1
	BCC ERR
	BEQ ERR
	TAY
	BCS C22

C11	LDA #$C0
	LDY #$BC
C22	STY RAMTOPSV
	STA BEGAD
	STA SKA+1
	MovlB SKA,0
	STA LSPOS
	LDA RDFG
	BNE C21

	PRINT
	DFB BELL
	ASC "No F-Ramdisk"
	DFB EOL,0
	JMP DSI

C21	PTSTR
	ASC \F-Ramdisk begins at $\
	PTHW
	WRL

	LDA LS
	BEQ +		no input
	  adjstDX
	  LDA LS
	  CMP 'D'	filename was entered
	  BEQ C6
	  RTS


+	LDA FLV		no input
	CMP 'D'
	BEQ +

	  LDY #$A5
	  JMP IOERR


+	LDY #14
C5	LDA FLV,Y
	STA LS,Y
	DEY
	BPL C5

C6	LDX #$60
	LDA #CCLOSE
	CIOVR

	LDA #4
	STA ICAX1,X	

	LDA #LS
	STA ICBADR,X
	LDA #LS:H
	STA ICBADR+1,X	
	LDA #COPN
	CIOVR

	BADLEN

	LDX #$40
	LDA #8
	STA ICAX1,X
	LDA 'F'
	OPENR

	BADLEN	




ULOOP	LDX #$60
	LDA #CNOTE
	CIOVR

	LDA #7
	STA ICCOM,X
	CIOV
	BMI U8

	LDX #$40
	LDA #CPBINR
	CIOVR

	JMP ULOOP

U8	CPY #$88
	BNE ERR1

	POIN

loop	LDX #$60
	GETR
	BMI TRND

	  LDX #$40

	  PUTR1
	  BPL loop

TRND	CPY #$88
	BNE ERR1

	  MovlB LS,'F'
	  MovlB LS+1,':'
	  JMP FFILE

ERR1	JMP IOERR
*** Point
POIN	LDA #CPOINT
CIOVR	STA ICCOM,X
	CIOV
	BMI ERR1
	RTS
	
***********************************************************
BADLEN	LDA SECSZ
	STA ICBLEN,X
	LDA #0
	STA ICBLEN+1,X
	STA ICBADR,X
	LDA #$BD
	STA ICBADR+1,X
	RTS

*** Print inverted '-' or '='
WADNMI	CMP #$AD	'-'inverted
	BEQ WA11
	CMP #$BD	'='inverted
	BNE WA22
WA11	PTCH
WA22	RTS
*

OFSI	DETZ
	LDA PREPFG
	BEQ OFD

	JMP CPHL
OFD	RTS
*
POINI	CmpaW NDAD,ADR
	BCC PII2
	CIOV
PIID	RTS

PII2	LDA AX65	
	BEQ PII1

	DEC AX65
	JMP PII3

PII1	LDY SECSZ
	DEY
	STY AX65	124
	DecW AX63
PII3	CIOV
	BMI PIID

	JMP GETR 
*
QI	LDX #$60
	LDA #CCLOSE
	CIOVR
	JMP (DOSVEC)

*

*FFG	DFB 0

*** FINS: F insert new in V.3
FINS	INC FFG
	LDY TOA
	BNE NOFF
	LDA TOA+1
	BNE NOFF
	JMP OPFL		if TOA == 0

NOFF	DEC FFG		not load file  FFG=0

	STY STAD		= TOA
	STY NDAD		= TOA

	MovaB STAD+1,TOA+1
	STA NDAD+1

	OPFL
	NOTE
	LDY NWA
	BNE ISNWA
	LDA NWA+1
	BEQ NONWA

ISNWA	  STY NDAD
	  STY ADR
	  MovaB NDAD+1,NWA+1
	  STA ADR+1

	  POINT
	  GETR
	  BPL +
*** INVALID ADDRESS
-	    LDY #$A
	    JMP IOERR

+	  GETR
	  BPL -
		
	  JMP FID2

NONWA	LDA FSEC,X
	STA ADR

FHILP	  LDY SECSZ
	  DEY
	  TYA
	  STA FBYT,X		

	  LDA #CPOINT
	  STA ICCOM,X
	  CIOV
	  BMI FLOLP
	    GETR
	    BMI FLOLP

	      CLC
	      LDA NDAD
	      ADC SECSZ
	      STA NDAD
	      BCC +

		INC NDAD+1

+		GETR
		BMI FID

		  LDA #CNOTE
		  STA ICCOM,X
		  CIOV
		  LDA FSEC,X
		  INC ADR
		  CMP ADR
		  BEQ FHILP

F2E		    LDY #$A4

FLOLP	CPY #$A4
	BNE +
	JMP IOERR

+	LDA #0
	STA FBYT,X
	POIN

	LDA FSEC,X
	STA ADR

loop	GETR
	BMI FID
	  IncW NDAD
	  LDA #CNOTE
	  STA ICCOM,X
	  CIOV
	  LDA FSEC,X
	  CMP ADR
	  BEQ loop
	  
	  BNE F2E

FID	LDA NDAD
	BNE +
	  DEC NDAD+1
+	DEC NDAD

FID2	MovlB LSPOS,0
	MovaW SKA,STAD
	PTHW
	PTSTR
	ASC \ \
	MovaW SKA,NDAD
	PTHW
	PRL

	OPFL
	JMP F6

***********************************************************
OPFLI	LDA FLV
	CMP 'F'
	BNE OLI

	LDY #0		F: double density
	BEQ OL2
OLI	LDY DBYTLO 	(SECTOR SIZE)
OL2	DEY
	DEY
	DEY
	STY SECSZ

	LDA FFG
	BEQ OI1

	CKFF
	RTS

OI1	PLA
	PLA
	RTS
***********************************************************

RBTI	LDA FFG
	BEQ RI2

	JMP RD6B

RI2	SEC
	INC EOFG
	PLA
	PLA
	PLA
	PLA
	RTS
***********************************************************

* Subroutine for CCODE
CI	LDA LS
	BEQ CID
	CMP 'W'
	BNE CID

	INC C3F
	MovlB CHIF,0
	MovlB PREPFG,1
	JMP API
CID	RTS

***********************************************************
APINS	RDBYT

	LDY C3F
	BEQ CID

	LDY CHIF
	BNE CI1

CI2	CMP NWA
	BNE CDADR

	INC CHIF
	BNE CDADR

CI1	DEC CHIF
	CMP NWA+1
	BNE CI2	

	DecW SKA
	MovaW ADV,SKA
	MovlB LSPOS,0
	PTHW
	WRL
	GETC
	CMP #ESC		(or EOL)
	BNE CDADR

	JMP DSI	

CDADR	INCADRw
	CmpaW ADR,TOA
	BEQ JDSI
	LDY #39
	LDA ADR+1
	STA (SAVMSK),Y

	JMP APLOOP

JDSI	JMP DSI
CHIF	DFB 0

**********************************************************

HATED	EQU $321		E: pointer
HATKB	EQU $327		K: pointer
TEXT	EQU $BE00
NEWED	EQU $BE70
NEWKB	EQU $BE78


*** @ (SHIFT-<8>)
SHIFT8	MovaW EDADV,HATED
	MovaW KBADV,HATKB
	MovlW HATED,NEWED	new E: routine
	MovlW HATKB,NEWKB	new K: routine

	LDY #0		start with 8 not 0
	STY TXPT
SH1	LDA (EDADV),Y
	STA NEWED,Y
	LDA (KBADV),Y
	STA NEWKB,Y

	INY
	CPY #8
	BNE SH1

	MovlB NEWED+4,EGTBYT-1
	STA NEWKB+4
	
	MovlB NEWED+5,EGTBYT-1:H
	STA NEWKB+5

	RTS
***********************************************************
EGTBYT	LDY TXPT
	LDA TEXT,Y
	CPY MAX
	BNE H2

	LDY EDADV
	STY HATED		
	LDY EDADV+1
	STY HATED+1

	LDY KBADV
	STY HATKB		
	LDY KBADV+1
	STY HATKB+1

H2	INC TXPT
	LDY #1
	RTS


MAX	DFB 0




***********************************************************
CKSEGTAB MovlB SEGNO,0
	
NEXTSEG	LDA SEGNO
	ASL
	ASL
	TAX
	INC SEGNO	1 2
	LDA CNT1
	CMP SEGNO
	BCC END		not found

	LDA SKA+1
	CMP SEGTAB+1,X
	BNE EEE
	LDA SKA
	CMP SEGTAB,X
	
EEE	BCC NEXTSEG	BRA if adr < from_adr
	
	LDA SEGTAB+3,X
	CMP SKA+1
	BNE EEE2
	LDA SEGTAB+2,X
	CMP SKA
EEE2	BCC NEXTSEG	bra if to_adr < adr
	
END	RTS		found:- CS		
**********************************************************
F1STSEG	CKSG
	BCS SST2

	OPFL
SSTLP	  RD6B1		* RD6B sets STAD,NDAD,DSEC,DBYT
	  CKSG		stad <= ad <= ndad
	  BCS SST2		yes

	  MovaW ADR,NDAD		no
	  INCADRw
	  POINT
	  BPL SSTLP	loop always

SST2	RTS
**********************************************************
CNT1	DFB 0
STADSV	DFW 0
NDADSV	DFW 0
DSECSV	DFW 0
DBYTSV	DFB 0

*** Create segment table for H.HEAD
SETSGTAB	LDA FFG
	BEQ END		RTS
	
	F1STSEG

	MovaW SEGTAB,AD	 - set first entry
	MovaW STADSV,STAD
	MovaW NDADSV,NDAD
	MovaW DSECSV,DSEC
	MovaB DBYTSV,DBYT
	LDX #0
	MovlB CNT1,1

SSTLP2	  TOAINSEG	  
	  BCS SSTEND		exit
	  
	  MovaWX SEGTAB+2,NDAD
	  MovaW ADR,NDAD
	  INCADRw
	  POINT
	  RD6B2

	  LDA CNT1
	  ASL
	  ASL
	  TAX
	  INC CNT1
	  MovaWX SEGTAB,STAD
	  JMP SSTLP2		loop

SSTEND	MovaWX SEGTAB+2,TOA
RESTSEG	  MovaW STAD,STADSV
	  MovaW NDAD,NDADSV
	  MovaW DSEC,DSECSV
	  MovaB DBYT,DBYTSV

	RTS
	

*** Find first EPZ in symbol table
FNDEPZ	MovaB ADR1+1,SYMTAB		adr1 = symtab
	MovlB ADR1,0
	
loop	CKCONSTY
	BNE EPZFND

	  AddaB ADR1,ADR1OF
	  JMP loop

EPZFND	RTS

*** Find ADR1OF, Check ']' 
CKCONSTY	LDY #3
	LDA (ADR1),Y	offset
	STA ADR1OF
	TAY		offset in Y
	DEY
	LDA (ADR1),Y	ch type
	CMP ']'
	RTS
	
*** Write head constants
WHDCONST	MovaB ADR1+1,SYMTAB		adr1 = symtab
	MovlB ADR1,0
loop	CKCONSTY
	BNE WHCND
	
	  WADNM
	  PutTAB
	  PutS \EQU \
	  LDY #0
	  LDA (ADR1),Y
	  PHB
	  WHeadCmt	SGEN412
+	  PRL
	  AddaB ADR1,ADR1OF
	  JMP loop

WHCND	PRL
	RTS

	
***	
CONSOLR	LDA CONSOL
	CMP #6	START
	BNE +
	BEQ CONSOLR
+	CMP #7	OPTION SELECT
	BCC +
	  RTS
+	JMP DSI



*** Display menu
MENU	ASC %1.address 2.comment %
	ASC %                    %
	ASC %3.ADDRESS 4.COMMAND %
	ASC %5.address 6.comment   %
	ASC "MMMMMMM"
	ASC % 7.JSR    %	
	ASC % 8.binary  9.ASC     %
	ASC $<A><1>..<9><RETURN>
	ASC "NNNNNNNNNNNNNNNNNNNNF"


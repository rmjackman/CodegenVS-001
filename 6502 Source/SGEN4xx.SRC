	JMP API
	
*** Calculate branch
CALCBRA	AddlB SKA,2
	LDA BT2
	BPL +

	  DEC SKA+1
+	CLC
	ADC SKA
	STA SKA
	BCC CBND
	  INC SKA+1
CBND	RTS

*** Open file
OPFL	MovlB FLFG,1
	LDX #$60
	ComCiov CCLOSE
*** Open file, 4: read
OPD1	MovlWX ICAX1,4	OR $C (BYTE CHANGE)


*	LDA #FLV		5014
*	STA ICBADR,X	344
*	LDA #FLV/$FF	5014
*	STA ICBADR+1,X	345


	ICBadrl FLV
	ComCiov COPN
	BMI FERR

	OPFLI
*** Check #$FF, needed for load-file
CKFF	GETR		err if not ff
	BMI FERR
	CMP #$FF
	BEQ CKFND

	LDY #6
	BNE FERR

CKFND	RTS

*** Error - no filename saved
FE1	LDY #$A5
FERR	JMP IOERR

*** F. FILE
FFILE	MovlB FLFG,0
	STA FFG
	STA CNT

	Cmpl AD,$FF	ff entered
	BNE +

	  JMP DSI	if ff

+	DEC AD

	LDA LS
	BEQ FA		no entry	at all
	
	adjstDX

	  LDY #$FF
***  Save file name (LS to FLV)
loop	    INY
	    LDA LS,Y
	    STA FLV,Y
	    CMP #EOL
	    BNE loop

FA	PRINT
	DFB DLN,0	del line
	LDA FLV		get saved file name
	BEQ FE1		error - no file

	LDX #$20		screen
	MovlBX ICBLEN,$20
	ICBadrl FLV
	ComCiov CPTXTR		wr filename
	FINS
FIN	  MovaW BTC,NDAD	loop begin
	  IncW BTC
	  RD6B1		RD6B sets STAD,NDAD,DSEC,DBYT
	  MovlB LSPOS,0
	  PTSEG
	  CONSOLR
	  INC CNT
	  LDA AD
	  BEQ F6

	    DEC AD
	    MovaW ADR,NDAD
	    INCADRw
	    POINT
	    JMP FIN	loop end


F6	LDA STAD		MovaW ADR,STAD
         STA ADR 		MovaW ADRV,ADR
         STA ADRV
	LDA STAD+1       
	STA ADR+1
	STA ADRV+1
	JMP DSI
* Show segments on F.FILE
PTSEG	PutW STAD
	PutS \ \
	PutW NDAD
	Cmpl LSPOS,9
	BEQ +
	PutTAB
*** diamond
+	PutS \ ` \
	LDX CNT
	INX
	TXA
	PHB
	CmpaW STAD,BTC
	BNE PS1
	PutS \>\
PS1	JMP PRL

*** Put TAB DFB
PTDFB	PutTAB
	PutS \DFB \
	RTS
*
BinTy	PTDFB
	PutS \%\
	LDA BYT
	JMP PTBI1
*** Open printer, 8: write 
OPENPR	OpenX $70,8,'P'
	BMI PER
	INC PRF		Set flag for atari printer.
	RTS
PER	JMP IOERR
* J.JUNK?
JJUNK	Cmpl NWA,1
	BEQ skip
	
	  INC JKF
	  BNE GGO
	
skip	INC JKF1
	BNE GGO
* T.TRACE
TTRACE	MovaW TV,AD
	INC TF		on
	BNE GGO
* H.HEAD
HHEAD	ERTOA0		Error if no to-address
	SETSGTAB
	ClearW ZLE	0
	Dsta DLE		0
	INC ZF		on
	
	LDX #127
	STX FG3		off
	INX
	STX FG4		on
* G.GO
GGO	MovlB ROWCRS,23
	MovlB SWTP,0

	LDA LS
	BEQ CDD		nothing
	
	CMP 'P'		Atari printer?
	BNE skip
	
	LDA LS+1
	CMP #EOL
	BNE skip
	
	  OPENPR		PRF = 1
CDD	  JMP API	
	
skip	LDY #$FF		is there a type char?
loop	INY
	LDA TypTab,Y
	BEQ skip		End of table--no char found
	
	  CMP LS
	  BNE loop
	  
	  MovaB SWTP,LS	char found
	  JMP API

skip	LDX #127		sg31
*	STX FG3		sg31
	INX		sg31
	STX FG4		sg31

	LDX #$10		PTDSK
	STX DFG
	MovlBX ICAX1,8
	MovlW OPF1+1,SRC
	adjstDX		?????
	OPF
	MovaB A1,SECSZ
	JMP API

*** Keys 1 to 5
f1to5	INC TF
*** Keys 6 t0 0
f6to0	SEC
	LDA GTC
	SBC '0'
	ASL
	TAX
	LDA FKTB,X
	STA AD
	LDA FKTB+1,X
	STA AD+1
	JMP API1
* B.BYTE
BBYTE	INC CBF
	PRINT
	DFB CRSUP,0
	LDA FLFG
	BEQ +
	  MovlB OPD1+1,$C
	  OPFL
+	  JMP API2
*
BC	LDA LS
	BEQ +

	  STA AD
+	LDA FLFG
	BNE +

	  LDY #0
	  LDA AD
	  STA (ADR),Y
	  RTS

+	POINT
	MovlBX ICCOM,11
	MovlBX ICBLEN,0
	STA ICBLEN+1,X
	LDA AD
	CMP BYT
	BEQ +
	CIOV
	BMI BE
+	RTS

BE	JMP IOERR

*** Do if ZF (head flag) is set
DETZ	LDA ZF
	BEQ DZD		exit

	LDA FFG
	BEQ +

	  CKSEGTAB
	  BCC skip
	  BCS PLRETADR
*** not file
+	CmpaW SKA,AD
	BCC skip		ska < ad

	  CmpaW TOA,SKA	if ska <= toa	
	  BCS PLRETADR	pull retadress
*** ska outside, so add to tab
skip	CKD000
	BCC skip

	  MovlW $20,DLB
	  ILSR
	  JMP PLRETADR

skip	MovlW $20,ZLB
	ILSR
PLRETADR	RTS		???????????
	PLA		???????????
	PLA		???????????
DZD	RTS		???????????
*
*** List head
LHEAD	WHDCONST
	ITLB
	INC LBFG		on
	MovlB ADR,0
	STA BT1		= 0
	MovaB ADR+1,ZLB
	MovaW LEN,ZLE
	LH
	MovlB ADR,0
	MovaB ADR+1,DLB
	MovaW LEN,DLE
	MovlB BT1,140	(CTRL-L  STY aaaa?)
	LH
	RTS
*
LH	MovlB LSPOS,0
	Dsta A2

LHLOOP	CONSOLR
	LDA LEN
	BNE +
	  LDA LEN+1
	  BNE +

	    JMP LHD

+	MovPZ SKA,ADR
	FADR1
	BPL +

	  WADNM
	  JMP LH5

+	WJLTL
	BCS LH5

	  WBL
	  BCC skip

LH5	PutTAB
	LDA SKA+1
	BEQ +

	PutS \EQU \
	JMP LH2

+	PutS \EPZ \
LH2	PHW
	WHeadCmt		SGEN412
	PRL
skip	AddlB ADR,2
	SublB LEN,2
	JMP LHLOOP

LHD	JMP PRL

*** Error if no to-address
ERTOA0	CmplW TOA,0
	BNE ETD

	  LDY #$B
	  JMP IOERR
ETD	RTS

* C.CODE
CCODE	MovlB SWTP,0
	MovlB FG3,128
	CI
	BEQ J1

	CMP '#'
	BNE ETD

	INC JF2
	BNE JND

J1	INC JF1
JND	JMP API
*
LPV	DFB 0
*
ASCty	CkScrCtl
	BMI AST1

	STA BYTSV
	JMP WSCTL

AST1	LDA BYT
	AND #%01100000
	BNE WAS

	PTDFB
	LDA BYT
	JMP PHB

WAS	PTAS
	MovaB LPV,LSPOS
	LDA '\'
	PTCH

ASLP	LDA BYT
	BMI ASD

	AND #%01100000
	BEQ ASD1

	LDA BYT
	PTCH

	CKNA
	BCS ASD1

	CkScrCtl
	BPL ASD1

	DEC TCT
	BNE ASLP

ASD1	LDX LPV
	LDA '"'
	STA LN,X
	JMP PTCH

ASD	INCADRw
	LDA BYT
	AND #%01111111
	PTCH
	LDA '\'
	JMP PTCH
* L.LIST
LLIST	INC LFG
	Cmpl LS,'P'
	BNE LND

	OPENPR
LND	JMP LSTADNM
*
INCADRw	INC ADR
	BNE DA1
	INC ADR+1
	BNE DA1
	INC EOFG
DA1	RTS
*** Write DBS
WDBS	PRINT
	DFB DBS,0	
	RTS
*** flag4 COMMAND off
PTFG4	PutTAB
	MovaB BYTSV,BYT
	CMP #$10
	BCS WO

	BLK
	LDA BYT
WO	PHB1
	PutS \ ` \	diamond
	Cmpl BYT,EOL
	ifNE
	  PutC #ESC
	  PutC BYT
	  JMP +

endif	PutS \EOL\

+	MovlB SCTP,'$'
	AOI
	PutS \  \
	PutC #ESC
	Cmpl BYT,EOL
	BNE +
	  LDA #ESC
+	PTCH
	PutS \  \
	MovaB BYT,BYTSV

	PTBI3
	PutS \  \
	PTOPCD
	JMP PRL
*** List last section displayed using T.TRACE
fSTAR	INC TF
TR1	MovaB SP,SPV
	MovaW AD,TV
	JMP API1
*
PTAS	DecW ADR
	MovaB TCT,ASCLEN	ASC string length
	PutTAB
	PutS \ASC \
	RTS



**LIB



*
	
**** "0123456789ABCDEF"
HXTB	ASC "0123456789ABCDEF"
LNPTRMX	DFB LN-LS
NMC	DFB 0
DBYT	DFB 0
DSEC	DFW 0
SGC	DFB 0
*** "D1:AUTOLOAD"
AUT	ASC "D1:AUTOLOAD"
SMB	ASC ".SMB"
	DFB EOL
*** Move LEN bytes from ADR1.. to ADR2..
MovER	MovaW LOCALW1,ADR1
	MovaW LOCALW2,ADR2
	LDY #0
	LDX LEN+1
	ifNE
*** LEN:H != 0
-	  LDA (ADR1),Y
	  STA (ADR2),Y
	  INY
	  BNE -

	  INC ADR1+1
	  INC ADR2+1
	  DEX
	  BNE -
*** LEN:L == 0?
endif	LDA LEN
	BEQ MVND
*** LEN:L != 0
do	LDA (ADR1),Y
	  STA (ADR2),Y
	  INY
	  CPY LEN
	  whileNE

MVND	MovaW ADR1,LOCALW1
	MovaW ADR2,LOCALW2
	RTS
	
*** Add LEN to ADR1 and ADR2
MMOVER	AddaW ADR1,LEN
	AddaW ADR2,LEN

	LDX LEN+1
	INX
	LDY #$FF

loop	DEC ADR1+1
	  DEC ADR2+1
	  DEX
	  BEQ skip
-	    LDA (ADR1),Y
	    STA (ADR2),Y
	    DEY
	    BNE -

	  LDA (ADR1),Y
	  STA (ADR2),Y
	  DEY
	  BMI loop

skip	LDX #0
-	  CPX LEN
	  BEQ MMD
	  
	    LDA (ADR1),Y
	    STA (ADR2),Y
	    DEY
	    INX
	    BNE -
MMD	RTS

*** Find SKA in symtab
FLA	MovlB ANF,0
	STA PVA+1
	STA SEF
*** long loop
loop	LDA SCTP		SGEN408
	CMP ']'		SGEN408
	BNE +		SGEN408

	  CKCONSTY	SGEN408
	  BNE NOTF	SGEN408	if next symbol not a constant

+	CA1MX		SGEN408 loop replaced with +
	  BCC +
	  BEQ NOTF1

	    LDY #$33
	    JMP IOERR
*** SKAw == (ADR1)?
+	  LDY #1
	  LDA (ADR1),Y
	  CMP SKA+1
	  BCC FLOF
	    BEQ LOW
	    BCS NOTF
*** Y=0
LOW	  DEY
	  LDA (ADR1),Y
	  CMP SKA
	  BEQ FLND
	  BCS NOTF

FLOF	  LDY #3
	  MovaW PVA,ADR1
	  LDA (ADR1),Y
	  CLC
	  ADC ADR1
	  STA ADR1
	  LDA ADR1+1
	  BCC loop
	    INC ADR1+1
	    BCS loop
*** Address found
FLND	LDY #4
	LDX #0
*** sec type char only?
-	LDA TypTab,X
	BEQ NotTyCH

	  INX
	  CMP (ADR1),Y
	  BNE -

	   INC ANF
	   BNE FLND2

NotTyCH	MovlB ANF,128

FLND2	DEY		Y=3
	LDA (ADR1),Y	
	TAY
	STY ADR1OF	Y=ADR1OF
NOTF	LDA ANF
	RTS
	
NOTF1	INC SEF
	BNE NOTF	(A is 0)
******************************************
	
* $D000 to $D7FF, write-only table
WTAB	DFB 140,141,142,153,157
* $D000 to $D7FF, write only: carry set
CKD000	Cmpl SKA+1,$D0	
	BCC CD2		SKA+1 < $D0

	CMP #$D8
	BCS CD2

	CMP #$D3		are all R/W registers
	BEQ CD2

	CMP #$D0
	BNE CD3

	Cmpl SKA,$1F	$D01F is R/W
	BEQ CD2

CD3	LDX #4
loop	LDA WTAB,X
	  CMP BT1
	  BEQ CD4

	  DEX
	  BPL loop

CD2	CLC		not D3 to D8
	RTS

CD4	SEC	Write-only symbol
	RTS


*** search for SKA, ADR1:=SYMTAB
FADR1	MovlB CONSTFG,1
	LDA SCTP
	CMP '"'
	BEQ skip
	CMP ','
	BEQ skip
	CMP ']'		SGEN408
	BEQ skip		SGEN408
	CMP '['
	BNE +

skip	  MovaB ADR1+1,SYMTAB	adr1 = symtab
	  MovlB ADR1,0
	  BEQ FADR1A	forced branch
	
	
+	DEC CONSTFG
	FNDEPZ


	
*** CKD000, search for SKA in symbol table
FADR1A	LDA SKA			push ska
	PHA
	LDA SKA+1
	PHA

	CKD000
	BCC +

	  MovlW SKA,NMIST		$D40F
	  FLA
	  BEQ FLAERR		not found in symbol table

	  LDY #3
	  CLC
	  LDA ADR1
	  ADC (ADR1),Y		add offset
	  STA ADR1
	  BCC +
	  
	    INC ADR1+1

+	PLA
	STA SKA+1
	PLA
	STA SKA
	
	FLA
	
	RTS
*** Need D40F/<SYMBOL>
FLAERR	LDY #$D
	JMP IOERR
*** incorporates MMOVER
ILSR	WISR
	BCS IRND

	LDY #1
	CLC
	LDA A1
	ADC #2
	ADC ($20),Y

	INY
	LDA A1+1
	ADC ($20),Y

	INY
	CMP ($20),Y
	BNE IR1
	JMP IOERR

IR1	IncW $20
	LDA A3
	ADC #2
	STA ADR1
	LDA A3+1
	ADC #0
	STA ADR1+1

	CLC
	LDA A3
	ADC #4
	STA ADR2
	LDA A3+1
	ADC #0
	STA ADR2+1

	SubaW A3,A1
	SEC
	LDY #0
	LDA ($20),Y
	SBC A3
	STA LEN
	INY
	LDA ($20),Y
	SBC A3+1
	STA LEN+1

	MovaW TMP,ADR1

	MMOVER

	LDY #1
	LDA SKA+1
	STA (TMP),Y
	DEY
	LDA SKA
	STA (TMP),Y

	CLC
	LDA ($20),Y
	ADC #2
	STA ($20),Y
	INY
	LDA ($20),Y
	ADC #0
	STA ($20),Y

IRND	RTS
*
WISR	LDY #0
	STY A1
	LDA ($20),Y
	STA A1+1

	CLC
	INY
	LDA ($20),Y	WCM1
	ADC A1
	STA A3

	INY
	LDA ($20),Y
	ADC A1+1
	STA A3+1

	LDA LBFG		only place where LBFG is tested
	BEQ INSTR

WWI1	SublB A3,2

	LDA A3+1
	CMP A1+1
	BCC WINF

	LDY #1
	LDA (A3),Y
	CMP SKA+1
	BNE WWI2

	DEY
	LDA (A3),Y
	CMP SKA
	BEQ WIF
WWI2	BCS WWI1

WINF	CLC
	RTS

WIF	EquDif CNT,A3,A1
	SEC
	RTS
*
PNT	EPZ A2

INSTR	LDY #19
	LDA ($20),Y
	STA PNT

	INY
	LDA ($20),Y
	STA PNT+1

	SublB PNT,2

loop	AddlB PNT,2

	  CmpaW PNT,A3
	  BCS skip

	    LDY #1
	    LDA (PNT),Y
	    CMP SKA+1
	    BNE +

	  DEY
	  LDA (PNT),Y
	  CMP SKA
	  BEQ cont
	  
+	  BCC loop

skip	AJPNT
	CLC
	RTS

cont	MovaW A3,PNT
	EquDif CNT,A3,A1
	AJPNT
	SEC
	RTS
*
AJPNT	LDY #19
	LDA PNT
	STA ($20),Y

	INY
	LDA PNT+1
	STA ($20),Y
	RTS
*** ZF=0, PRLN, LSPOS=0
PREL	MovlB ZF,0
*** Write line, LSPOS:=0
WRL	PutC #EOL
	LDX #0
	PRLN
	MovlB LSPOS,0
	RTS
*
PRL	LDA HIF
	BEQ PRL9

	JMP PRL6

PRL9	LDA JF1
	BNE PRL5
	LDA JF2
	BNE PRL5
	LDA JKF
	BNE PRL5
	LDA JKF1
	BNE PRL5
	LDA ZF
	BNE PRL5
	LDA PREPFG
	BEQ skip
*** char to top right corner. J. H. P.
PRL5	  LDA ADR+1
	  LDY #39
	  STA (SAVMSK),Y	Top RH corner of screen

	  JMP PRND

skip	LDX DFG
	BNE PRL1

	PutC #EOL
	JMP PRL3
*** A$, Line Feed: Atari800Win P:
PRL1	Cmpl NWASV,$A
	BEQ PRL11
		
	PutC #$D		Default, Car. Return: AtmasII editor
	Cmpl NWASV,$DA	$DA, CR + LF: old printers
	BNE PRL3
	
	LDA #$A
PRL11	PTCH

PRL3	LDA PRF
	BEQ +
	  MovlB ROWCRS,19
	  PRINT
	  DFB DLN,DLN,DLN,DLN,0	del four lines	  
+	PRLN		X is DFG
	ifMI

	  JMP PRER

endif	LDA DFG		write to disk?
	BNE PRL5

	LDA PRF		to Atari printer
	BEQ PRND

PRLA	MovlB ROWCRS,19	Atari Printer. Get line from screen
	LDX #$20		E:
	MovlBX ICAX1,13
	ICBadrl LN		set address to LN
	INPL			get text

*** write line to Atari printer
	MovlBX ICAX1,12	
	TYA
	BMI PRER
	LDX #$70
	ICBadrl LN
	ICBlenl 127
	ComCiov CPTXTR
	BMI PRER

PRND	LDA ZZF
	BEQ PRL6

	AddaB BTC,LSPOS
PRL6	MovlB LSPOS,0
	RTS

PRER	LDA #30
	JMP IOERR
*** Print LN
PRLN	ICBadrl LN
	MovaBX ICBLEN,LSPOS
	MovlBX ICBLEN+1,0
	ComCiov CPBINR
	RTS
*
BLK	LDA ' '
PTCH	STX TMP
	LDX LSPOS
	STA LN,X
	INC LSPOS

	LDA LSPOS
	CMP LNPTRMX
	BEQ PCHERR

	INC CHC
	LDX TMP
	DEC A1
	BEQ PTCND

	  MovaB A1,SECSZ

PTCND	RTS
*
PCHERR	PREL
	LDY #$30
IOERR	STY ERNO

	MovlB DFG,0
	STA ZF

	CPY #$88
	BNE IE6

	MovlB LSPOS,0
	JMP IE5

IE6	MovaW ADR,ADRV
	CPY #128
	BEQ JINP

	LDA HILOFG
	BEQ IE9

	LDA BT2
	PHB
	PREL

IE9	MovlB ROWCRS,23
	MovlB LSPOS,0
	PRINT
	DFB BELL,INSLN,0		$FD,$9D
	PutS \Error- \
	LDA ERNO
	PHB

IE5	PutS \   \

	LDA ERNO
	BPL IE4

	MovlW A2,FLerrTb
	LDX #128
	BMI IE3

IE4	CMP #$12
	BCS IE8

	MovlW A2,ERTAB1
	LDX #0

IE3	LDY #$FF

IE1	INY
	LDA (A2),Y
	BPL IE1

	INX
	CPX ERNO
	BNE IE1

IE2	INY
	LDA (A2),Y
	AND #%01111111
	PTCH
	LDA (A2),Y
	BPL IE2

IE8	PREL

	LDA HILOFG
	BEQ JINP

	PREL
	fPL
JINP	JMP DSI
*** Put Hex Byte (A)
PHB	PHA
	CMP #10
	BCC skip
	  PutS \$\
	  STX XSAV
	  PLA
PHB1	  PHA
	  LSR
	  LSR
	  LSR
	  LSR
	  BEQ skip
	    TAX
	    LDA HXTB,X
	    PTCH
skip	PLA
	AND #%00001111
	TAX
	LDA HXTB,X
	PTCH
	LDX XSAV
	RTS
********************************************************
LSTADNM	MovaW SKA,AD
*** Show more items in the symbol-table
fSEMICOL	CHKTOA
	  MovaB ADR1+1,SYMTAB	SGEN408	adr1 = symtab
	  MovlB ADR1,0		SGEN408
	FADR1A			SGEN408
	PRINT
	DFB DBS,0
loop	CONSOLR
	LADNM
	  CLC
	  LDA ADR1OF
	  ADC ADR1
	  STA ADR1
	  BCC +
	    INC ADR1+1
+	  CA1MX
	  BCC loop

	BNE LAERR
LADND	JMP DSI
*
LAERR	LDY #$31
	JMP IOERR
*** List address name
LADNM	MovlB LSPOS,0
LADNM1	CA1MX
	BCS LADND

	MovPZ SKA,ADR1
	LDA LFG
	BEQ +

	  CmpaW TOA,SKA
	  BCC LADND

+ 	MovaW A3,SKA

	PTHW
	BLK
	LDY #2
	LDA (ADR1),Y
	BEQ skip
	BPL +

	  DEC SKA+1
+	CLC
	ADC SKA
	STA SKA
	BCC +
	  INC SKA+1

+	PTHW
	BLK
skip	PutS \/\

	LDY #3
	LDA (ADR1),Y
	STA ADR1OF

	INY
-	LDA (ADR1),Y
	  PTCH
	  INY
	  CPY ADR1OF
	  BNE -

	PRL
	MovaW SKA,A3
	RTS
*** Put Hex Word (SKA)
PHW	LDA SKA+1
	BNE +
	  LDA SKA
	  JMP PHB
+	PutS \$\
*** Put Hex Word (SKA)
PTHW	LDA #0
	CMP SKA
	BNE PH1
	CMP SKA+1
	BNE PH1

	JMP PHB

PH1	LDA SKA
	PHA
	LDA SKA+1
	PHA

	LDX #4
	MovlB FG,0

NXN2	LDY #4
	LDA #0

SN2	ASL SKA
	ROL SKA+1
	ROL
	DEY
	BNE SN2

	TAY
	BNE PHX1
	LDA FG
	BEQ PHX2

PHX1	INC FG
	LDA HXTB,Y
	PTCH

PHX2	DEX
	BNE NXN2

	PLA
	STA SKA+1
	PLA
	STA SKA

	RTS
	
*** if no TOA, TOA=FFFF, else ADR>TOA?
CHKTOA	LDA TOA
	BNE ADGTTO
	LDA TOA+1
	BNE ADGTTO

	DEC TOA		set 0 to ff
	DEC TOA+1
	RTS
*** ADR>TOA?
ADGTTO	LDA FFG
	BNE AGTND	
	CmpaW TOA,ADR
	BCS AGTND
	LDY #4
	JMP IOERR
AGTND	RTS

*** Parsing input line LS after '/' (Y)
INA	LDX #$FF
	STX FG
	MovaW ADR,AD
loop	INY
	  INX		X starts at 0
	  LDA LS,Y	Y starts at pos after '/'
	  STA LS,X
	  CMP ' '
	  BNE IA1

	    LDA FG
	    BEQ loop
	    DEX
	    BNE loop

IA1	CMP ';'
	BNE +

	  INC FG		FG = 0
+	STA HF
	CMP '`'		diamond
	BEQ +

	  CMP #EOL
	  BNE loop

+	STX NML
	CKDX
	RTS
*
LTAB	ASC "BCDGHJKMPRT
	DFB 0
*** Please enter address
ADRERR	LDY #$11
	JMP IOERR
	
*** Parsing input line LS
INO	MovaB LSsav,LS
	CMP #EOL
	BNE +
	LDX #$FF
*** Error: no-input
-	INX
	  LDA LTAB,X
	  BEQ +
	  
	  CMP GTC
	  BEQ ADRERR
	  
	  BNE -
*** Clear AD,TOA,NWA
+	LDX #5
	LDA #0
-	STA AD,X
	DEX
	BPL -

	MovlB NMC,$FF
INO1	MovlB BT1,156
	LDY #0

loop	LDA LS,Y
	CMP '$'
	BEQ +
	CMP '*'
	BEQ +
	CMP 'J'
	BEQ +
	CMP 'T'
	BEQ +
	CMP ' '
	BNE NNB
+	INY
	BNE loop

NNB	INC NMC
NXN	LDA LS,Y
	CMP ' '
	BNE skip

-	INY
	LDA LS,Y
	CMP ' '
	BEQ -
	BNE NNB	J

skip	STA HF
	CMP '`'
	BEQ INPND
	CMP #EOL
	BEQ INPND
	
	LDX HILOFG
	BEQ +

	  CMP ':'
	  BEQ INPND
	  BNE FHX
+	CMP '/'
	BNE FHX
	  JMP INA
	  
FHX	LDX #$F
*** Find Hex
FNDHEX	CMP HXTB,X
	BEQ +
	DEX
	BPL FNDHEX
	BMI SYNER

+	TXA
	PHA
	MovlB CNT,%00010000
	LDA NMC
	ASL
	TAX

-	ASL AD,X
	ROL AD+1,X
	ASL CNT
	BCC -

	PLA
	ORA AD,X
	STA AD,X

	INY
	BNE NXN

INPND	LDA HILOFG
	BNE IPD

	MovaW ADR,AD
	MovlB LS,0
	STA NML
IPD	RTS

SYNER	LDA HILOFG
	BEQ SNE1

	LDA #0
	PLA
	PLA
	RTS

SNE1	LDA NMC
	BNE SNTXERR

	STA AD
	STA AD+1
	STA ADR
	STA ADR+1
	LDY #$FF
	JMP INA
*** INVALID SYNTAX
SNTXERR	LDY #1
	JMP IOERR
	
*** main EDIT routine
ED1	LDA AD
	BNE +
	
	  LDA AD+1
	  BNE +

	  LDA LSsav
	  CMP '0'
	  BEQ +
	
	  CMP #EOL
	  BNE SNTXERR

	  RTS

+	CKDX
	BMI skip		Why BMI ????

-	LDA LS,X		move contents of LS 4 to the right
	  STA LS+4,X	to make room for AD and offset
	  DEX
	  BPL -

	MovaW LS,AD	write address
	MovlB LS+2,0	offset = 0

	LDA TOA
	BNE +
	  LDA TOA+1
	  BEQ skip

+	EquDif LS+2,TOA,AD	write offset

skip	CLC
	LDA NML		name length
	ifNE +		add 4 if NML != 0
	  ADC #4
endif	STA SVL
	MovlB SVL+1,0
	MovaW TOA,AD

	BLOKR

	LDA SVL
	BEQ DND

	  STA LS+3
	  TAY
	  DEY
-	  LDA LS,Y
	    STA (TMP),Y
	    DEY
	    BPL -

DND	MovaW ADV,AD
	RTS
*** E.Edit
EEDIT	ED1
	MovlB CRSINH,0
	Cmpl HF,'`'	diamond
	ifEQ
	  MovlB ROWCRS,23
	  AJA1MX
	  JMP fEQUAL

endif	IP
	JMP EEDIT
*
IP	INPT20LS
	BMI DER
	  INO
	  RTS
*** CIOV returns error number in Y
DER	JMP IOERR
*
TSTFLL	EPZ BT2
*** Place or delete symbol in symbol table
BLOKR	DTADR12

	EquDif OLL,ADR1,ADR2

	CLC
	MovaB TSTFLL,SYTL
	LDA SYTL+1
	ADC SYMTAB
	STA TSTFLL+1

	SubaW TSTFLL,OLL
	AddaW TSTFLL,SVL
	LDA TSTFLL+1
	CMP RAMTOPSV
	BCS BRERR

	MovaW TMP,ADR2
	AddaW ADR2,SVL
	DetLEN
	CmpaW ADR1,ADR2
	BCC LONG

	 MovER
	 JMP ADJTBLN

LONG	MMOVER

ADJTBLN	SubaW SYTL,OLL
	AddaW SYTL,SVL
	RTS
*** NOT ENOUGH ROOM
BRERR	LDY #9
	JMP IOERR
*
DetLEN	MovaB LEN,SYTL	LEN = SYTL+SYMTAB 
	CLC
	LDA SYTL+1
	ADC SYMTAB
	STA LEN+1

	CmpaW LEN,ADR1
	BCC DLERR
	SubaW LEN,ADR1	LEN -= ADR1
	RTS

DLERR	LDY #$32
	JMP IOERR
	
*** Determine ADR1 and ADR2
DTADR12	ADGTTO
	MovaW SKA,AD	SKA=AD

	FADR1
	
	MovaW ADR2,ADR1	ADR2=ADR1
	MovaW SKA,TOA	SKA=TOA

	FADR1
	BEQ DA12ND

	LDY #3
	LDA (ADR1),Y	entry length
	CLC
	ADC ADR1
	STA ADR1
	BCC DA12ND
	  INC ADR1+1	ADR1 += entry length
DA12ND	RTS

*** D. DELETE
DDELETE	ClearW SVL
	BLOKR
	RTS
	
***A=SCTP, if '<' found, BT1=157, flag: EQ
CKDX	MovlB BT1,156	(156 seems to be arbitary)
	LDX NML		name length
	DEX
	LDA LS,X		last char of name
	STA SCTP		needed for ']' (SGEN408)
	CPX #0		(SGEN411)
	BNE +		(SGEN411)
	  CMP ']'	(SGEN411)
	  BNE +		(SGEN411)
	    MovAW TOA,AD	(SGEN411)
	    PLA		(SGEN411)
	    PLA		(SGEN411)
	    JMP DDELETE	(SGEN411)

+	CMP '<'
	BNE D3

	INC BT1		BT1 = 157: '<' found
D3	TXA		last char is in A
	RTS
	

*
OL	DFB 0

*** S. SAVE
SSAVE	LDA LS
	BNE SAVE1

	LDA SGC
	BEQ SAVE1		

	MovlB JJ,0
	STA LSPOS
S3	MovlB A3,2

-	LDY JJ
	  LDA FTV,Y
	  STA SKA	
	  INY
	  LDA FTV,Y
	  STA SKA+1
	  INC JJ
	  INC JJ
	  PTHW
	  BLK
	  DEC A3
	  BNE -

	PutS \/\

	LDY #0
-	LDA OSV,Y
	  PTCH
	  INY
	  CPY OL
	  BNE -

	LDA JJ
	CMP #4
	BEQ +

	  PutS \>\
+	LDA #CRSUP
	PTCH
	MovlB CRSINH,0
	PRL
	IP
	SAVE1

	LDA JJ
	CMP SGC
	BCS SD

	  JMP S3
SD	RTS

*
SAVE1	adjstDX
	MovlB ICAX1+$10,8
	LDX NML
	DEX
	LDA LS,X
	CMP '>'
	BNE +

	  INC ICAX1+$10
	  DEC NML

+	CHKTOA
	DTADR12
	EquDif SVL,ADR1,ADR2

	OPENLF

	MovlB SFC,$FB
	L7SFC
	ComCiov CPBINR
	BMI SER

	ICBadra ADR2
	ICBlena SVL
	CIOV
	BMI SER
	ComCiov CCLOSE
	RTS
*
SER	JMP IOERR
*
OPENLF	MovlW OPF1+1,SMB
OPF	LDX NML
	LDY #0
OPF1	LDA SMB,Y	".SMB" or ".SRC"
	STA LS,X
	INX
	INY
	CPY #4
	BNE OPF1

	LDX #$10
	ICBadrl LS
	OPR
	BMI SER
	RTS
	
*** Obtain symbols
OOBTAIN	adjstDX
	LDY NML
	STY OL
	DEY
O3	LDA LS,Y		save filename in OSV
	 STA OSV,Y
	 DEY
	 BPL O3

	MovlB ICAX1+$10,4
	MovlB SGC,0
	OPENLF

O1	L7SFC
	ComCiov CGBINR	7
	BPL O5
	CPY #136		END OF FILE
	BNE OER
	RTS
*** BAD SMB-FILE
OE1	LDY #$10
OER	JMP IOERR

O5	Cmpl SFC,$FB
	BNE OE1

	LDX #0
O4	LDY SGC
	LDA AD,X
	STA FTV,Y
	INC SGC
	INX
	CPX #4
	BNE O4

	MovlB LSPOS,0
	STA CRSINH
	LDA AUFG
	BNE O2

 PutW AD
 PutS \ \
 PutW TOA
 PutS \ ` \
 PutW TOA+2
 PutS \ bytes. <Y> to load\
 PRL

 GETC
 CMP 'Y'
 BEQ O2

	JMP DSI

O2	MovlB AUFG,0
	BLOKR
	LDX #$10
	ICBlena SVL
	ICBadra TMP
	CIOV
	BMI LFERR
	AJA1MX
	JMP O1

LFERR	JMP IOERR

*
LNSTP4	DFB 0

SKSTR	CLC
	LDA NML
	ADC #4
	STA LNSTP4

	MovaB ADR1+1,SYMTAB
	MovlB ADR1,0

SKSLP1	LDY #3
	LDA (ADR1),Y
	CMP LNSTP4
	BCC NXT

	LDX NML
	LDY LNSTP4

SKSLP2		DEX
		BMI STFND
		DEY
		LDA (ADR1),Y
		CMP LS,X
		BEQ SKSLP2

NXT	CA1MX
	BCC NXT1

	RTS

NXT1	LDY #3
	LDA (ADR1),Y

	CLC
	ADC ADR1
	STA ADR1
	LDA ADR1+1
	BCC SKSLP1

	INC ADR1+1
	BCS SKSLP1

STFND	WSEC1
	GETC
	CMP #ESC
	BNE NXT

	RTS

*
WSEC	FADR1
WSEC1	MovlB ROWCRS,22
	PUT DLN

	MovlB TOA,$FF
	STA TOA+1
	LADNM

	MovaB ADR,SKA
	STA ADRV
	STA ADV
	MovaB ADR+1,SKA+1
	STA ADRV+1
	STA ADV+1
	RTS
*** A.Address/Symbol search
AAdrSym	LDA LS
	BEQ LSTAN

	JMP SKSTR
LSTAN	MovaW SKA,ADR
	JMP WSEC
*** Put Acc char (X==#$20 E:)
PUTR	LDX #$20
*** Put Acc char
PUTR1	PHA
	MovlBX ICCOM,CPBINR
	MovlBX ICBLEN,0	one character
	STA ICBLEN+1,X
	PLA
	JMP CIOV
*** Display next entry in symbol-table
fPL	IncW ADRV
	MovaW SKA,ADRV

	FADR1
	MovPZ SKA,ADR1
	JMP WSEC
*** Display last entry in symbol-table
fMI	MovaW SKA,ADRV
	FADR1
	MovPZ SKA,PVA
	JMP WSEC

*
PTSTR	PLA
	STA $29
	PLA
	STA $2A

	STX TMP
	LDX #0
-	IncW $29

	  LDA ($29,X)
	  AND #%01111111
	  PTCH
	  LDA ($29,X)
	  BPL -

	LDX TMP
	LDA $2A
	PHA
	LDA $29
	PHA
	RTS

*
DIF	EPZ CNT	???
*** ADDRESS OVERLAP
RER	LDY #2
	JMP IOERR
*** RE-ADDRESS symbols
RReADR	ADGTTO
	MovaW SKA,ADR
	FADR1
	MovaW TMP,ADR1

	LDY #1
	LDA (PVA),Y
	CMP NWA+1
	BNE R3
	DEY
	LDA (PVA),Y
	CMP NWA
R3	BCS RER

	MovlB FG,127
	CmpaW AD,NWA
	BCS R4

	EquDif DIF,NWA,AD
	MovaW SKA,TOA
	IncW SKA
	FADR1A

	CA1MX
	BEQ R9

	LDY #0
	LDA (PVA),Y
	ADC DIF
	STA $20
	INY
	LDA (PVA),Y
	ADC DIF+1

	CMP (ADR1),Y
	BNE R8

	DEY
	LDA $20
	CMP (ADR1),Y

R8	BCC R9
	JMP RER

R9	JMP R5

R4	INC FG
	EquDif DIF,AD,NWA

R5	MovaW ADR1,TMP

RLOOP	LDY #1
	LDA TOA+1
	CMP (ADR1),Y
	BNE R2
	DEY
	LDA TOA
	CMP (ADR1),Y
R2	BCS RA
	JMP DSI

RA	LDY #0
	LDA FG
	BMI RS

	CLC
	LDA (ADR1),Y
	ADC DIF
	STA (ADR1),Y
	INY
	LDA (ADR1),Y
	ADC DIF+1
	STA (ADR1),Y
	JMP RO

RS	SEC
	LDA (ADR1),Y
	SBC DIF
	STA (ADR1),Y
	INY
	LDA (ADR1),Y
	SBC DIF+1
	STA (ADR1),Y

RO	CLC
	LDY #3
	LDA ADR1
	ADC (ADR1),Y
	STA ADR1
	BCC RLOOP
	INC ADR1+1
	BCS RLOOP
**************************************	
*** Get char from keyboard. MI = error
GETC	LDX #$30
	GETR
	BMI skip
	AND #%01111111
skip	RTS
**************************************
*** Get char from keyboard. MI = error
GETR	MovlBX ICBLEN,0
	STA ICBLEN+1,X
	ComCiov CGBINR
	RTS
**************************************
*** Print string ending in 0 to screen
PRINT	PLA
	STA A2
	PLA
	STA A2+1
	STX TMP
	
-	LDX #0
	  IncW A2
	  LDA (A2,X)
	  BEQ +
	  
	  PUTR
	  JMP -

+	LDX TMP
	LDA A2+1
	PHA
	LDA A2
	PHA
	RTS
**************************************

POINT	LDA FLFG
	BNE PO1
	RTS

PO1	EquDif A1,ADR,STAD
	MovaW AX63,DSEC

PO2	LDA A1+1
	CMP #0
	BNE PO2A

	LDA A1
	CMP SECSZ

PO2A	BCC PO3
	SubaB A1,SECSZ
	IncW AX63
	JMP PO2

PO3	CLC
	LDA DBYT
	ADC A1

	BCS PO31	
	CMP SECSZ	
	BCC PO4

PO31	SBC SECSZ
	IncW AX63

PO4	STA AX65

	LDX #$60
	MovlBX ICCOM,37
	POINI
	BPL POND
	JMP IOERR
POND	RTS
**************************************
*** Read BYT from RAM or file
RDBYT	TYA
	PHA
	TXA
	PHA

	LDA FLFG
	BNE RDFILE

	  LDY #0
	  LDX PORTB
	  TXA
	  AND #%11111101
	  STA PORTB

	  LDA (ADR),Y
	  STX PORTB
	  JMP RBTND

RDFILE	MovlB SGFG,0
	POINT

	CmpaW NDAD,ADR
	BCS +

	 MovaW TMP,NDAD
	 IncW TMP
	 RBTI
	 BCS skip

	  CmpaW STAD,TMP
	  BEQ +

	    MovaW ADR,STAD
	    INC SGFG
	    SEC
	    BCS skip

+	GETR

RBTND	CLC
	STA BYT
skip	PLA
	TAX
	PLA
	TAY
	LDA BYT
	RTS
**************************************

WHILO	LDY #3

	LDA (ADR1),Y
	TAX
	DEX
	DEX
	DEX
	DEX

WH1	INY
	LDA (ADR1),Y
	STA LSmin4,Y
	DEX
	BNE WH1

	LDA #EOL
	STA LSmin4+1,Y
	ClearW NWA
	MovlB NMC,1

	INO1

	LDA LS,Y
	RTS
**************************************

ILN	LDX #$10
	INPTLS
	BMI IER

	LDX #$20
	ICBadrl LS
	ICBlenl 127
	ComCiov CPTXTR

	LDA LS
	CMP '0'
	BCS ID

	RTS

ID	JMP DSI

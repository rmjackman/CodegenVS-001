PRMEN	PRINT
	DFB CLS
	ASC "/ . RET BRK  + - = *  <  > ?"
	ASC " ; , (0..9) "! "
*	DFB '"'
	ASC /!" $% ()/
	DFB 0
	RTS
*** Device placeholder
DV	ASC "X:"
	DFB EOL

OPENR	STA DV
	ICBadrl DV
OPR	ComCiov CCLOSE
	MovlBX ICAX1+1,0
	ComCiov COPN
	RTS
*
INPT20LS	LDX #$20
INPTLS	ICBadrl LS
INPL	ICBlenl 127
	ComCiov CGTXTR
	RTS
*** ICBlen = 7, ICBadr = SFC
L7SFC	ICBlenl 7
	ICBadrl SFC
	RTS
	
*** if (STAD<=TOA<=NDAD) CS
TOAINSEG	  CmpaW TOA,STAD
	  BCC TID		TOA < STAD
	  CmpaW NDAD,TOA
TID	  RTS		NDAD < TOA  ie. TOA not in segment


	
SEGNO	DFB 0	


	
	


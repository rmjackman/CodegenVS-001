D0	ASC "D0:*.*"
	DFB EOL

AX63	EQU 844+$60
AX65	EQU 846+$60
**************************************

**** RD6B sets STAD,NDAD,DSEC,DBYT
RD6B	LDX #$60
	GTBT
	CMP #$FF
	STA STAD
	BNE F2

	GTBT
	CMP #$FF
	STA STAD+1
	BNE F3

	GTBT
F2	STA STAD

	GTBT
	STA STAD+1

F3	GTBT
	STA NDAD
	GTBT
	STA NDAD+1

NOTE	ComCiov CNOTE
	BMI FER
	MovaW DSEC,AX63
	MovaB DBYT,AX65
	CLC
	RTS

*** Show bytes in A,H,J,T,S tables ***
fCOMMA	PRINT
	DFB DBS,EOL
	ASC /table/,"   ",/bytes/
	ASC "    ",/in use/
	DFB EOL,0

	LDX #0
	LDY #0
	STY LSPOS
FRE1	STX A2
	STY A3
	LDA ZLB+3,X
	SEC
	SBC ZLB,X
	STA SKA+1
	MovlB SKA,0

	PutS \  \
	LDY A3
	LDA LABTB,Y
	PTCH
	PutTAB
	PTHW

	PutTAB
	LDX A2
	LDA ZLB+1,X
	STA SKA
	LDA ZLB+2,X
	STA SKA+1
	PTHW

	PRL
	LDY A3
	INY
	LDX A2
	INX
	INX
	INX
	LDA ZLB,X
	CMP RAMTOPSV
	BNE FRE1

	RTS

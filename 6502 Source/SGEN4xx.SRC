*** Address-table for Menu
PICTAB	DFW fESC,fARROW,fARROW,fARROW,fARROW
	DFW fBLANK,DECOL1,INCOL1,INPT,DECOL2,INCOL2	
*	DFW fBLANK,INPT,INPT,INPT,INPT,INPT
	DFW INPT,INPT,LBRACK,RBRACK
	DFW fSTAR,fPL,fCOMMA,fMI,fPERIOD,fSLASH
	DFW f6to0,f1to5,f1to5,f1to5,f1to5,f1to5
	DFW f6to0,f6to0,f6to0,f6to0,YY
	DFW fSEMICOL,fLEthan,fEQUAL,fGRthan,fQUEST,SHIFT8	fQUEST: next line
	DFW AAdrSym,BBYTE,CCODE,DDELETE,EEDIT,FFILE
	DFW GGO,HHEAD,IINDEX,JJUNK,KKEYS,LLIST
	DFW MMINLAB,NNEW,OOBTAIN,PPREPARE,QQUIT
	DFW RReADR,SSAVE,TTRACE,UUTILITY,0
* one-line-flag
OLNFG	DFB 0
*#
DECOL1	DEC PKT
	DEC PKT
	JMP DSI
INCOL1	INC PKT
	INC PKT
	JMP DSI
DECOL2	DEC PKT+1
	DEC PKT+1
	JMP DSI
INCOL2	INC PKT+1
	INC PKT+1
	JMP DSI
LBRACK	LDA COLOR2
	ADC #16
	STA PKT+1
	JMP DSI
RBRACK	LDA COLOR2
	SEC
	SBC #16
	STA PKT+1
	JMP DSI
	
	
*#
*** Trace next lines ***

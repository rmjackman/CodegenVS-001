*** Check Type
CKTY	STA $21
	TYA
	PHA
	LDY #$FF

CT11	INY
	STY TPNO
	LDA TypTab,Y
	BEQ SKP3
	CMP $21
	BNE CT11

	DFB $24	(BIT aa changes no values)


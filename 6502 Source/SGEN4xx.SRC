*** List DIR
IINDEX	CLC
	LDA AD		drive #
	ADC '0'		convert to ascii
	STA D0+1		insert in file name

	LDX #$10
	MovlBX ICAX1,6	directory
	ICBadrl D0
	OPR
	BMI IER

I1	ILN
	DEC ROWCRS
	MovlB COLCRS,19	2nd column
	ILN
	CONSOLR
	JMP I1

IER	JMP IOERR

**********************************************************************************
************************ S O U R C G E N Reasembler for Atari 8-Bit **************
**********************************************************************************

* ( Set the TAB of your text editor to 9 for correct display. )
*
* ATMAS-II compatible Source code
* Assemble using the CODEGEN Macro ASSEMBLER for PC
*

* Use the CPFL directive to compare the generated code with another file

*	CPFL SGEN416.LOAorig
	
*	SAVEAS SG.LOA		Not AUTORUN.SYS when using TURBODOS!!!
	APPEND FRAMDISK		only with DOS 2.5 -- not TURBODOS!!!
	
	ADDTOIMG AUTOLOAD.SMB	add AUTOLOAD.SMB to disk image.  (required)
	SMTFILE TEMP.SMB
	SMTTOIMG 		add SMT-file to disk image.  (optional)

* CODEGEN will create a Load-File and save it to an ATR or XFD-disk image file.
* Change the name of the following disk image file ( W1_DD.XFD ) as required:


*	DSKIMAGE W1_DD_test.ATR	TURBO DOS double density image -- empty
*	DSKIMAGE W1_DD.XFD 	TURBO DOS DD Sourcgen loads, 126 free sectors
*	DSKIMAGE FormatedED.XFD	just Turbo DOS, 
*	DSKIMAGE DISK_10_Turbo_DOS_21_test.xfd	no TURBODOS
*	DSKIMAGE NoDOS_ED.XFD
* 	DSKIMAGE DOS25_ED_test.XFD	lots of files		ok
*	DSKIMAGE DOS25.ATR	DOS25 only			ok
*	DSKIMAGE temp.atr		SD DOS25 and DUP
*	DSKIMAGE unknown.xfd	SD DOS25 and DUP		ok
*	DSKIMAGE unknown3.xfd	
*	DSKIMAGE CHACHA_A-temp.XFD		disk full
*	DSKIMAGE AT3_A_ED_test.XFD 	file number mismatch
*	DSKIMAGE AT3_B.XFD
*	DSKIMAGE formatted_empty_ed_test.xfd crashes-First 3 sectors are empty
*	DSKIMAGE T.XFD
*	DSKIMAGE DIRDEFEC.XFD
*	DSKIMAGE TestFF.atr
* CODEGEN will then start your Atari800 emulator and boot the XFD-disk image file.
* Please check the following path and file; change if necessary:

*	DISASS 123456


	RUNEMUL "C:\Program Files (x86)\Atari800WinPLus\Atari800Win.exe"
*	RUNEMUL "C:\Programs stand alone\Altirra\Altirra64.exe"
*	RUNEMUL "C:\Programs stand alone\atari800-5.2.0-win32-sdl\atari800.exe"
*	RUNEMUL "C:\Programs stand alone\Xformer10\xformer10-x64.exe"

* Use the OUT directive to create a text output file with the extension ".LIS"
*            L: Listing will be creatied. Assembly and CPFL mismatches will be shown.
*            LM: Macros will not be expanded, and assembly and CPFL mismatches will not be shown.
*            N: Symbol table will be listed.
*            T: SOURCGEN symbol table will be listed.
* OUT can be placed anywhere in the source code. OUT with no parameters terminates the listing.
	OUT T

	INCLUDE if_while_macros.src
	INCLUDE Macros.SRC
***************************************************************
X	EQU $57	*increase by 1 for extra page in the segment at ORG 5100
*		*The size of the symbol table will be decreased by one page.
***************************************************************
COPN	EQU 3	Disk open
CGTXTR	EQU 5	command get text
CGBINR	EQU 7
CPTXTR	EQU 9
CPBINR	EQU $B
CCLOSE	EQU $C
CPOINT	EQU $25
CNOTE	EQU $26

ESC	EQU $1B
CRSUP	EQU $1C
CLS	EQU $7D
DBS	EQU $7E
TAB	EQU $7F		
EOL	EQU $9b
DLN	EQU $9c
INSLN	EQU $9D
BELL	EQU $FD

CRSINH	EQU $2F0
DSPFLG	EQU $2FE
ICCOM	EQU $342
ICBADR	EQU $344
ICBLEN	EQU $348
ICAX1	EQU $34A
CIOV	EQU $E456


INIT	EQU $600
BEGAD	EQU $6FA

* OS variables
WARMST	EPZ 8
BOOT 	EPZ 9
DOSVEC	EPZ $0A
DOSINI	EPZ $0C
LMARGN	EPZ $52
ROWCRS	EPZ $54
COLCRS	EPZ $55
SAVMSK	EPZ $58	Address of top left character
RAMTOP	EPZ $6A

* Temporary variables
LOCALW1	EPZ $24
LOCALW2	EPZ $26

* SGEN variables
ADR1	EPZ $80	present address in symbol table
ADR2	EPZ $82
LEN	EPZ $84
ERNO	EPZ $86
FFG	EPZ $87	File-flag V3
NDAD	EPZ $88	segment end address
SFC	EPZ $8B	b3 ???
*** (maintain order of AD, TOA and NWA)
AD	EPZ $8C	A-U first input value
TOA	EPZ $8E	A-U 2nd value "to-address"
NWA	EPZ $90	A-U 3rd value (or SVL)
***
SKAV	EPZ $92	SKA save
PVAV	EPZ $94
ADR1V	EPZ $96	ADR1 save
CHC	EPZ $98
NML	EPZ $99	name length
STAD	EPZ $9A	segment begin-address
A1MX	EPZ $9C	A1 max
TV	EPZ $9E
GTC	EPZ $A0	Main menu get char(A-U, f.keys)
HF	EPZ $A1
LSsav	EPZ $A2
STABEPZ	EPZ $A3

ZF	EPZ $A7	head flag
CONSTFG	EPZ $A8	constants flag eg. COPN EQU 3
TXPT	EPZ $A9
EDADV	EPZ $AA	editor address save
KBADV	EPZ $AC	keyboard address save
OLL	EPZ $AE
SCTP	EPZ $B0	section type

SWTP	EPZ $B2	Swap-type
TPNO	EPZ $B3	type no.
LBFG	EPZ $B4	Label flag
STKV	EPZ $B5	Stack-save
ANF	EPZ $B6	Address not found
ADR1OF	EPZ $B7	ADR1 offset flag
XSAV	EPZ $B8	Save X register
PRF	EPZ $B9	printer flag
PREPFG	EPZ $BA	Prepare-flag
AOF	EPZ $BB
SEF	EPZ $BC
BYTSV	EPZ $BD	BYT save
SPV	EPZ $BE
BTC	EPZ $BF	#EOFG-BTC
LFG	EPZ $C1
JF1	EPZ $C2
JF2	EPZ $C3
HIF	EPZ $C4	HI flag
JKF	EPZ $C5	Flag JUNK FROM TO
JKF1	EPZ $C6	Flag JUNK FROM TO 1
HILOFG	EPZ $C7	HI-LO-flag
ZZF	EPZ $C8	second head flag
SKF	EPZ $C9
HIF1	EPZ $CA
SP	EPZ $CB
TF	EPZ $CC	Trace flag
CBF	EPZ $CD	Change-byte flag
C3F	EPZ $CE
EOFG	EPZ $CF	#EOFG-BTC
SAV	EPZ $D0	save ADRV
A1S	EPZ $D2	save ADR1V
SYA	EPZ $D4
NWASV	EPZ $D6	third value e.g. for P:
ADR1SV	EPZ $D8	ADR1-save

TCT	EPZ $DE	counter
BT1	EPZ $E0
BT2	EPZ $E1	(or TSTFLL)
BT3	EPZ $E2  (or TSTFLL+1)

A1	EPZ $E4
A2	EPZ $E6  (or PNT)
A3	EPZ $E8
SKA	EPZ $EA	Seek-Address
ADR	EPZ $EC  Address in RAM 
JJ	EPZ $EE

LSPOS	EPZ $F0	Position in LS
*A4	EPZ $F1

FG	EPZ $F5
BYT	EPZ $F6	value read from RAM or disk
CNT	EPZ $F7  (or CNT)
TMP	EPZ $F9
PVA	EPZ $FB
JMPAD	EPZ $FD


SDLSTL	EQU $230
COLDST	EQU $244
TABMAP	EQU $2A3
INVFLG	EQU $2B6
SHFLOK	EQU $2BE
COLOR0	EQU $2C4
COLOR1	EQU $2C5
COLOR2	EQU $2C6
COLOR3	EQU $2C7
COLOR4	EQU $2C8
KRPDEL	EQU $2D9
KEYREP	EQU $2DA
DBYTLO	EQU $308	 Sector size
CONSOL	EQU $D01F
VCOUNT	EQU $D40B
**


	ORG $4D00

BEGIN	LDA #$C0
	CMP RAMTOP
	BEQ YL0

	BCS YL1

	STA RAMTOP
*
YL0	LDX #OKTXT:HI
	LDA #OKTXT

	JSR TITLE
	RTS

YL1	LDA #ERRTXT
	LDX #ERRTXT:HI
	JSR TITLE
ERROR	JMP ERROR

TITLE	STA TXTADR
	STX TXTADR+1
	LDY VCOUNT
	CPY #$7A
	BNE TITLE

	LDY #0
	STY COLOR2
	LDY #$C
	STY COLOR1
?
	LDA #NEWDLST
	LDX #NEWDLST:HI
	STA SDLSTL
	STX SDLSTL+1
	RTS

NEWDLST	DFB $70,$70
	DFB $70,$70,$70,$70,$70,$42
	DFW TTEXT
	DFB $70,7,$70,2,$70,$70,$42
TXTADR	DFW OKTXT	or errtxt
	DFB $41
	DFW NEWDLST

TTEXT	ASC %RE-ASSEMBLER for the%
	ASC % ATMAS-II assembler %
	ASC %   SOURCGEN V.4.2   %
	ASC % Copyright 1988-2024%
	ASC % by Richard Jackman %

OKTXT	ASC %    www.richard-jack%

	ASC %man.de/atari_xl     %

ERRTXT	ASC $requires 48K- Press $
	ASC $OPTION when booting.$

	DFB 0

*



SVL	EPZ NWA

PORTB	EQU $D301

	ORG $2E0
	DFW GENBEG	RUNAD
	DFW BEGIN	INITAD

*** BLAB	X*256 hardware write-only -- max $56 bytes

	ORG X*256+$56	$5756	


*** If found, could be D:,F:,P:,S:etc ***
*** If ":" not found, "D:" is assumed ***
adjstDX	LDA ':'
	CMP LS+1
	BEQ adjND
	  CMP LS+2	e.g. "D2:"
	  BEQ adjND

	LDY NML		length without "D:"
	INC NML
	INC NML		+2
	LDX NML		length with "D:"

adjLP	LDA LS,Y		Make space for "D:"
	  STA LS,X	
	  DEX
	  DEY
	  BPL adjLP

	LDA 'D'		Insert "D:"
	STA LS
	LDA ':'
	STA LS+1

adjND	RTS	

*	LDY 0		write filename
*adj1	LDA LS,Y
*	PTCH
*	INY
*	CPY NML
*	BNE adj1
	
*	GETC
*	RTS
*********************************************************

SK	EQU $100

*segment 2200 4c1F -- now 4c07

SCREEN	EQU $4C20
CRAMTOP	EQU $50
FKTB	EQU $5000	20 bytes
FLV	EQU $5000+20	File-Save (15 bytes)

LS	EQU $5000+$23	Input line
LSmin4	EQU $5000+35-4
LN	EQU $5090
OSV	EQU $50E0	Obtained File-save
FTV	EQU $50F0

*segment 5100 56FF -- now 56E2
*segment 5756 577E

* Room for 32 segments (4 bytes per segment)
SEGTAB	EQU X*256+$80		$5780

OUTMENSV	EQU $BC00	Buffer for 1st 4 lines on screen

*******************************************************************

	ORG $2200

GENBEG	JMP BEG

DFBLEN	DFB 6	DFBsequence length
ASCLEN	DFB 21	ASCstring length
PKT	DFB 9	COLOR1	
	DFB 192	COLOR2
	DFB 226	COLOR4
	DFB 20	KRPDEL
	DFB 3	KEYREP	
*** 'write-only' registers between $D000 and $D4FF.
DLB	DFB X		57
DLE	DFW 0
*** Head Label table begin Hi byte
ZLB	DFB X+1		58
ZLE	DFW 0
BLB	DFB X+4		5b
BLE	DFW 0
*** J-label table begin Hi bytef
JLB	DFB X+$C		63	
*** J-label # bytes in use
JLE	DFW 0
TLB	DFB X+$11	68
TLE	DFW 0
SYMTAB	DFB X+$17	6f
*** symbol table length
SYTL	DFW 0
RAMTOPSV	DFB $BC		Don't change this!


*** DDDZZZHHHJJJTTT
LBTB	ASC "DDDZZZHHHJJJTTT"
LOFST	DFW 0
SGFG	DFB 0
ADRV	DFW 0
FLFG	DFB 0
DFG	DFB 0
MNLB	DFW $80
ADV	DFW 0
*** table of sec type characters
TypTab	ASC ".(;!'\#,"		'?' changed to ','
	DFB '"'
	ASC "=-%$*&<_|@[]"
	ASC /=-/
*	DFB 0,0	SG32
	DFB 0	SG40
*** Table of sec type pointers
TyPtrTb	DFW TXTty,NormTy,NormTy,NormTy,NormTy,ASCty,DFBty,DFBty
	DFW StrTy
	DFW DFWeqTy,DFWmiTy,BinTy,StrTy,ORGty
	DFW NormTy,NormTy,DFWmiTy,DFWeqTy,NormTy,NormTy,NormTy
	DFW DFWeqTy,DFWmiTy,0

ANFV	DFB 0
J9FG	DFB 0
ODF	DFB 0
*** Tab map
TBMP	DFB 0,$40,$20,$10,$08
BGFG	DFB 1
LODAUTFG DFB 0

BEG	CLD

	MovaW JDOS+1,DOSINI
	MovlW DOSINI,JDOS
	LDX #$FF
	STX WARMST
	INX
	STX COLDST
	INX
	STX BOOT
	LDA BGFG
	BEQ BG1

	MovlB A1MX,0		a1mx = SYMTAB
	MovaB A1MX+1,SYMTAB
	MovlB FLV,0
	STA CBF

BG1	TSX
	STX STKV

	MovlB RAMTOP,CRAMTOP
*** $C: update mode
	OpenX $20,12,'E'
*** 4: read only
	OpenX $30,4,'K'

	LDX #4
-	LDA TBMP,X
	  STA TABMAP,X
	  DEX
	  BPL -

	MovlB COLOR1,5
	MovlB LMARGN,0
	STA BGFG
	STA SWTP
	STA ZF
	fSLASH

*Loop begin
DSI	LDX STKV
	TXS

	LDA LODAUTFG
	BNE +
	  INC LODAUTFG
	  NNEW
*** Colors and cursor
+	MovaB COLOR1,PKT
	MovaB COLOR2,PKT+1
	MovaB COLOR4,PKT+2
	MovaB KRPDEL,PKT+3
	MovaB KEYREP,PKT+4

	J600

	LDA CBF
	BEQ +
	LDA FLFG
	BEQ +

	  MovlB OPD1+1,4
	  OPFL
*** initialize zero page variables
+	LDX #EOFG-BTC
	LDA #0			
-	STA BTC,X
	DEX
	BPL -

	AJA1MX

	LDA ZF
	BEQ skip

	  DEC ZF
	  INC ZZF
	  LHEAD
	  LDA FFG
	  BEQ +
	    RESTSEG
+	  JMP API

skip	LDA DFG
	BEQ DSI1

	TAX
	Cmpl NWASV,$A
	BEQ skip
	Cmpl LS,'D'
	BNE skip
	  LDA #0	
	  STA ICBLEN,X	
	  STA ICBLEN+1,X
loop	    DEC A1		fill with $FF
	    BEQ skip
	    LDA #$FF
	    CIOV
	    BPL loop
	  JMP IOERR

skip	ComCiov CCLOSE
DSI1	MovlB PRF,0
	STA CRSINH
	STA DSPFLG
	STA PREPFG
	STA DFG
	Dsta TOA
	STA INVFLG
	STA COLCRS
	STA SCTP
	
	MovlB ICAX1+$20,12
	MovlB SHFLOK,64
	MovlB ROWCRS,23
	LDX #$70
	ComCiov CCLOSE	close printer
	PRINT
	DFB DLN,'?',0	print prompt: ?
		
	INPT

	JMP DSI		loop end
**********************************************************

*** Check segment
CKSG	CmpaW AD,STAD
	BCC CKSD
	CmpaW NDAD,AD
CKSD	RTS
*
API1	PRINT
	DFB EOL,0
API2	ClearW TOA

API	LDA FFG
	BEQ +

	  F1STSEG
	
+	LDA AD
         STA ADR
         STA ADV
         
         LDA AD+1
         STA ADR+1
         STA ADV+1
	
	LDA ZZF
	BEQ +

	  PTORG
	  PutW ADR
	  PRL
	  PRL
+	MovlB LSPOS,0
	FTY
	CHKTOA
	ITLB

APLOOP	LDX STKV
	TXS
	LDA EOFG
	BNE APD

	LDA SGFG
	BEQ +

	  PRL
	  PRL
	  PTORG
	  PutW STAD
	  PRL
	  PRL
	  FTY
	  ITLB

+	MovlB HILOFG,0
	STA LBFG
	STA J9FG
	LDA FLFG
	BEQ +

	  TOAINSEG

	  BCC skip		NDAD < TOA  ie. TOA not in segment

+	  CmpaW TOA,ADR
	  BCS skip			ADR <= TOA

	    LDA ZZF		ADR > TOA
	    BEQ APD
	    
	      PutW BTC
	      PutS \ bytes\
	      WRL
APD	      JMP DSI

skip	MovaB SKA,ADR
         STA ADRV 	
	MovaB SKA+1,ADR+1
         STA ADRV+1  
	
	
	CONSOLR

	LDA OLNFG
	BEQ +

	  DEC OLNFG
	  LDA OLNFG
	  BEQ APD
	
+	APINS

	BCC +
	  JMP APLOOP

+	MovlB BT1,156
	WCM1
	ADNM1
	MovlB SKF,0
	LDA CBF
	BNE +
	  LDA FG4
	  BMI AP1
+	PTFG4
	LDA CBF
	BNE +
	  JMP WI3

+	DEC CRSINH
	PRINT
	DFB CRSUP,TAB,0
	MovaW LEN,ADR
	INPP
	LDA #$FF
	Dsta TOA
	MovaW ADR,LEN
	BC
	RDBYT
	PRINT
	DFB CRSUP,0
	PTFG4
WI3	INCADRw
	JMP APLOOP

AP1	INCADRw
	LDA SCTP
	SWTYP
	CKTY
	BCC NormTy

	  LDA TPNO
	  ASL
	  TAX
	  LDA TyPtrTb,X
	  STA XX+1
	  LDA TyPtrTb+1,X
	  STA XX+2
XX	  XX
	  JMP AP2

NormTy	INC LBFG

	PutTAB
	PTOPCD

	LDA BYT
	TAX
	AND #$1F
	STA JJ
	TAY

	BBB

	PRL
	LDX TF
	BEQ +
	Cmpl BT1,32	jsr no
	  BEQ DOTRACE
	  Cmpl JJ,16
	  BEQ DOTRACE
	  LDA SKF
+	BNE DOTRACE
	  JMP APLOOP

******************************
DOTRACE	PRINT
	  ASC /<R><T><*><SPACE><RET>/
	  DFB 0
	  GETC
	  BPL +
	  JMP ALERR
	  
+	  PHA
	  PRINT
	  DFB DLN,0
	  PLA
	  CMP #ESC
	  BNE +
	    DEC TF
	    JMP DSI1
+	  CMP ' '
	  BEQ AP3
	  CMP 'R'
	  BEQ RT1
	  CMP '*'
	  BNE +
	    JMP TR1

+	  CMP 'T'		trace
	  BNE DOTRACE

	Cmpl BT1,32	jsr no
	BNE +

	LDY SP
	LDA ADR
	STA SK,Y
	INY
	LDA ADR+1
	STA SK,Y
	INY
	JMP APF

+	CMP #108
	BEQ APERR
	CMP #64
	BEQ APERR
	CMP #96
	BNE +

RT1	  LDY SP
	  BEQ APERR
	  
	  DEY
	  LDA SK,Y
	  STA SKA+1
	  DEY
	  LDA SK,Y
	  STA SKA
APF	  STY SP
	  STY SPV
+	MovaB AD,SKA
	STA TV
	MovaB AD+1,SKA+1
	STA TV+1
	PutS \*****\
	LDA SP
	LSR
	PHB
	PRL
	JMP API
AP2	PRL
AP3	JMP APLOOP
*** TRACE NOT POSSIBLE
APERR	LDY #$F
ALERR	JMP IOERR
*
PTORG	PRL
	PutTAB
	PutS \ORG $\
	RTS
*
ORGty	DecW ADR
	PutTAB
	PutS \ORG *+$\
	ClearW TCT
-	IncW TCT
	CKNA
	BCC -
	
	PutW TCT
	JMP PRL
*
DFWTY	LDA BYT
	PHA
	CKNA1
	BCS +

	  LDA ADR
	  AND #1
	  CMP ODF
	  BNE skip

+	    PLA
	    STA BYT
	    PLA
	    PLA
	    MovlB TCT,1
	    JMP DFBT1

skip	LDA SCTP
	BMI +

	MovaB SKA+1,BYT
	PLA
	STA SKA
	JMP skip

+	MovaB SKA,BYT
	PLA
	STA SKA+1

skip	INCADRw
	PutTAB
	PutS \DFW \
	MovlB CHC,0
	INC LBFG
	RTS
*
DFWmiTy	DFWTY
	IncW SKA
	ADNM2
	PutS \-1\
	JMP WCM2
*
DFWeqTy	DFWTY
	LDA SKA
	BNE DWD
	LDA SKA+1
	BNE DWD

	PutS \0\
	RTS

DWD	JMP B3D

*
NORTZ	ASC "%"
INVTZ	ASC "$"
*
StrTy	AOI
	BPL WSCTL	screen cntrl char found

	  CMP '"'
	  BEQ STT1
	  AND #%01100000	is ASCII
	  BNE WASC

STT1	PTDFB
-	LDA BYTSV
	JMP PHB
* Write DFB and screen control char
WSCTL	PTDFB
* Write screen control char	
WSCTL1	STA SKA
	MovlB SKA+1,0
	FADR1
	BPL -
	CKCONSTY
	BNE -
	Wadnm
	RTS

WASC	PTAS
	LDA BYT
	BMI ASCINV

	LDA NORTZ
	PTCH

loop	LDA BYT
	  BMI ASCD

	  PTCH
	  CKNA
	  BCS ASCD

	  AOI
	  BPL ASCD

	  AND #%01100000
	  BEQ ASCD

	  DEC TCT
	  BNE loop

ASCD	LDA NORTZ
	AND #%01111111
	JMP PTCH
*
ASCINV	LDA INVTZ
	AND #%01111111
	PTCH

AV6	LDA BYT
	BPL AVND
	AND #%01111111
	PTCH

	CKNA
	BCS AVND

	AOI
	BPL AVND

	AND #%01100000
	BEQ AVND

	DEC TCT
	BNE AV6

AVND	LDA INVTZ
	JMP PTCH
*
AOI	MovaB BYTSV,BYT
	MovlB NORTZ,'"'
	MovlB INVTZ,'/'
	Cmpl SCTP,'"'
	BEQ CkScrCtl

	MovlB NORTZ,'%'
	MovlB INVTZ,'$'
	
	LDA BYT
	LDX #0
-	CMP #32
	  BCC +
	  INX
	  SBC #32
	  JMP -

+	ADC ASTB,X
	STA BYT
*** Is BYT a screen control char? MI:not found
CkScrCtl	LDA BYT
	LDX #FLerrTb-ESCchTB	=16

-	DEX
	BMI +
	  CMP ESCchTB,X
	  BNE -

+	RTS
*
*******************************************************  
TXTB1	DFB $0D,$0A
TXTB2	DFB EOL,0
TXTty	MovlB TCT,40	line of text
	DecW ADR

loop	LDA BYT

	  LDY #TXTB2-TXTB1
-	  DEY
	    BMI +
	    CMP TXTB1,Y
	    BNE -
	
	  LDA TXTB2,Y
	  BEQ skip		skip cha

+	    CMP #EOL
	    BEQ cont

	    PTCH
	    DEC TCT
	    BEQ cont

skip	  CKNA
	  BCS TXTD
	  BCC loop

cont	INCADRw

TXTD	RTS

*** DFB Character
DFBty	MovaB TCT,DFBLEN	length of DFB-sequence
DFBT1	DecW ADR
	PTDFB
DFBloop	LDA SCTP
	CMP '#'
	BEQ DFBphb
	
	  LDA BYT
	  CkScrCtl
	  BEQ DFBsym

	  LDA BYT
	  BMI DFBphb

	    AND #%01100000
	    BEQ DFBphb
	
	      PutS \'\	put character
	      LDA BYT
	      PTCH
	      PutS \'\
	      JMP NXTbyt

DFBphb	LDA BYT
	PHB
	JMP NXTbyt
	
DFBsym	WSCTL1
	
NXTbyt	DEC TCT
	  BEQ +

	    CKNA
	    BCS DFBchD
	    PutS \,\
	    JMP DFBloop

+	INCADRw
DFBchD	RTS
	
* Check next ADR

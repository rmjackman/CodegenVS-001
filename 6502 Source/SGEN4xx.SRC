	LDA JKF
	BEQ JD

	STX XV
	STY YV

	DEC JKF
	MovlB LSPOS,0
	MovaW SKA,ADR
	FADR1A
	BEQ JJ1

	MovlB LSPOS,0
	LDX BT1
	CPX #162		(ldx #nn ?)
	BEQ J6

	LDA JJ
	BEQ J7

	CMP #9
	BEQ J6
	BNE J5

J7	TXA
	BPL J5

J6	PutS \# \
J5	LADNM1

JJ1	WJLTL
	BCC J4

	ANO1
	BEQ J3

	PutS \ ok\
	JMP J3

J4	WIS BLB
	BCC JJ2

	PTHW
	BLK
	WBL1

J3	PRL
JJ2	INC JKF

	LDX XV
	LDY YV

JD	INC LBFG
	RTS

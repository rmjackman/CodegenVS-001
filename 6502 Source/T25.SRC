* RUNEMUL "C:\Program Files (x86)\Atari800WinPLus\Atari800Win.exe"	RUNEMUL "C:\Programs Stand Alone\Altirra-4.21\Altirra64.exe"	ADDTOIMG MEM.SAV	ADDTOIMG HELP.X	ADDTOIMG THELP.X 	OUT LEOL	EQU $9BICCOM	EQU $342ICBAL	EQU $344ICBAH	EQU $345ICBLL	EQU $348ICBLH	EQU $349ICAX1	EQU $34AICAX2	EQU $34BCIOV	EQU $E456COPEN	EQU 3CCLSE	EQU 12CGTXT	EQU 5CPTXT	EQU 9CGBIN	EQU 7CPBIN	EQU 11CDRAW	EQU $11ATACHR	EQU $2FBROWCRS	EPZ $54	COLCRS	EPZ $55STICK0	EQU $0278STRIG0	EQU $284GR	MACRO S	LDA #S	GRAPHR	MENDPOS	MACRO X,Y	MovlW COLCRS,X	LDA #0	STA COLCRS+1	MovlB ROWCRS,Y	MENDPLOT	MACRO X,Y	POS X,Y	PLOTR	MENDDRTO	MACRO X,Y	POS X,Y	DRTOR	MENDOPEN	MACRO K,AX1,AX2,FI	JMP OP1@F@	ASC FI	DFB EOLOP1@	LDX #K	MovlBX ICAX1,AX1	MovlBX ICAX2,AX2	MovlBX ICCOM,COPEN	MovlWX ICBAL,F@	CIOV	MENDCLOSE	MACRO N	LDX #N	MovlBX ICCOM,CCLSE	CIOV	MENDPRINT	MACRO N,LAB	LDX #N	MovlWX ICBAL,LAB	PRINTR	MENDPRINTSN	MACRO STRI	JMP P2@P1@	ASC STRI	DFB EOLP2@	PRINT 0,P1@	MENDINPUT	MACRO N,LAB	LDX #N	MovlBX ICCOM,CGTXT	MovlWX ICBAL,LAB	MovlWX ICBLL,127	CIOV	MENDBPUT	MACRO K,BUF,L	LDX #K	MovlBX ICCOM,CPBIN	LDA L	STA ICBLL,X	LDA L+1	STA ICBLH,X	MovlWX ICBAL,BUF	CIOV	MENDMovlB	MACRO A,N	LDA #N	STA A	MENDMovlBX	MACRO A,N	LDA #N	STA A,X	MENDMovaB	MACRO A,N	LDA N	STA A	MENDMovlWX	MACRO A,V	MovlBX A,V	MovlBX A+1,V:H	MENDMovlW	MACRO A,V	MovlB A,V	MovlB A+1,V:H	MENDMovaW	MACRO A,N	MovaB A,N	MovaB A+1,N+1	MEND************* A R I T H M E T I C *********IncW	MACRO A	INC A	BNE E@	INC A+1E@	MENDDecW	MACRO A	DEC A	LDA A	CMP #$FF	BNE E@	DEC A+1E@	MENDAddlB	MACRO A,I	LDA #I	CLC	ADC A	STA A	BCC E@	INC A+1E@	MENDAddaB	MACRO A,I	LDA I	CLC	ADC A	STA A	BCC E@	INC A+1E@	MENDAddaW	MACRO A,I	LDA I	CLC	ADC A	STA A	LDA I+1	ADC A+1	STA A+1	MENDSublB	MACRO A,D	LDA A	SEC	SBC #D	STA A	BCS E@	DEC A+1E@	MENDSubaB	MACRO A,D	LDA A	SEC	SBC D	STA A	BCS E@	DEC A+1E@	MENDSubaW	MACRO A,B	SEC	LDA A	SBC B	STA A	LDA A+1	SBC B+1	STA A+1	MEND	SublW	MACRO A,D	SEC	LDA A	SBC #D	STA A	LDA A+1	SBC #D:H	STA A+1	MEND	CmplW	MACRO A,B	LDA A+1	CMP #B:H	BNE E@	LDA A	CMP #BE@	MENDCmpaW	MACRO A,B	LDA A+1	CMP B+1	BNE E@	LDA A	CMP BE@	MENDMOVE	MACRO OA,A2,L	MovaW ADR1,OA	MovaW ADR2,A2	MovaW LEN,L	MOVER	MEND	****** End of macros *************LMARGN	EPZ 82SAVMSK	EPZ 88KEYDEF	EPZ 121RAMTOP	EPZ $6ACH	EQU 764 keycode of last pressed keyBRKKY	EQU 566CRSINH	EQU 752CHBAS	EQU 756PORTB	EQU $D301SKCTL   EQU $D20E Disable the POKEY key click directlyNOKEY	EPZ 208*ADR1	EPZ $80 ADR2	EPZ $82LEN	EPZ $84*TMP	EQU $86*NL	EQU $88     ; new line reload valueLOC	EPZ $E0YA	EPZ $E2SV	EPZ $E4XA	EPZ $E6	cursor position in test bufferWA	EPZ $E8YY	EQU $EEDIF	EQU $F0CHR	EQU $F1TEA	EPZ $F2	Text end address ('pointer')CNT	EQU $F4*TEMP	EPZ $F6*CRAMTOP	EQU $40CLS	EQU $F420	ORG $2E0	DFW JMPBEG*** code seg 2200 to 2AF9 ***cTXAD	EQU $4000	text buffer addresscMXA	EQU $7FFF-64-80	64 alligns cMXA with end of logical line*	80 bytes beyond cMXA are needed for INSLNcSAVBF	EQU $7FFF-64-80+1+80*			64+80-1-80 = 63 free bytescWORD	EQU $8000	$7B00+$500cPRBF	EQU $8010	print buffercCBLKBUF	EQU $8100	copy-block buffer cSSP bytescSSP	EQU 960		screen size (SSP also exists)	ORG $8100+960 to 92EAJMPBEG	JMP BEGINDLLNBF	DFW $81A0	$7CA0+$500	max 80SSP	DFW 960		screen spacePRVXA	DFW $4000VECTOR	DFW 0KCD	DFB 0ESCFLG	DFB 0*** status lineSTATLN	DFB 1		show bankBANK	DFB $FFDBSFLG	ASC % 2%EFLG	ASC % D%INSFLG	ASC % I%OFLG	ASC % O%CAPSFLG	ASC % C%INVFLG	ASC % U% MSFLAG	DFB 0		mouse flagEXPFLG	DFB 0		export flagLL	DFW 40ROW	DFB 0COL	DFB 0LOGROW	DFB 0LOGCOL	DFB 0VCNT1	DFB 0VCNT2	DFB 0N40	DFW 40FFLG	DFB 0STKSV	DFB 0PTBSV	DFB 0BKYSV	DFW 0TABMAP	ASC ".......X.......X.......X.......X.......X" 	ASC ".......X.......X.......X.......X.......X"ENG	DFB 1,21	ASC "zZyY	DFB 0GER	DFB 11,10	ASC "yYzZ"CHARBUF	ASC "?"************************************	B E G I N	************************************BEGIN	MovaB PTBSV,PORTB	TSX	STX STKSV	MovlB RAMTOP,CRAMTOP	#$40	MovaW BKYSV,BRKKY	MovlW BRKKY,BKTP		LDA SKCTL Disable the POKEY key click directly	AND #%11111110  ; clear bit 0	STA SKCTL	        	SCTLRET	NBKTP	CLI	LDA #$80	PHACLSE	PLA	SEC	SBC #$10	BEQ START	TAX	PHA	MovlBX ICCOM,CCLSE	CIOV	JMP CLSESTART	GR 0	OPEN $30,8,0,"S:"	OPEN $00,12,0,"E:"	CLRCSR	OPEN $20,4,0,"K:"	VORBERT	MovlB CHBAS,204	international character set	MovlB LMARGN,0RSTXA	MovaW XA,PRVXA*** Loop begin ***LPBG	LDX STKSV	TXS	MovlB EXPFLG,0	CLOSE $40	MovaW PRVXA,XA	MovaW PORTB,BANK*	LDA cTXAD*	CMP #255		Altirra*	BNE +*	  DLTXBF		delete text buffer	+	CmplW XA,cTXAD	BCS skip	MovlW XA,cTXADskip	CmplW WA,cTXAD	BCS LB2	MovlW WA,cTXADLB2	MovlW ADR1,cMXA	SubaW ADR1,SSP	IncW ADR1	CmpaW ADR1,WA	BCS TXTEND	MovaW WA,ADR1TXTEND	CmplW XA,cMXA	end of text buffer?	BCC SCROLUP	no	  MovlW XA,cMXA	yes	  MovlW WA,cMXA	  SubaW WA,SSP	  IncW WASCROLUP	MovaW ADR1,WA	AddlB ADR1,80	CmpaW XA,ADR1		BCS CHECKWA	SubaB WA,LL	JMP SCROLUPCHECKWA	CmplW WA,cTXAD	BCS SCROLDN	MovlW WA,cTXADSCROLDN	MovaW ADR2,WA	AddaW ADR2,SSP	SublB ADR2,80	CmpaW XA,ADR2	BCC INSMODE	     	CmplW XA,cMXA-80		BCS INSMODE	If less than 2 lines from bottom	AddaB WA,LL	scroll	JMP SCROLDNINSMODE	MovaW ADR2,SAVMSK	AddaW ADR2,SSP	status line	LDY #0		column of first item	LDX #0loop	LDA STATLN,X	flag	PHP	INX	LDA STATLN,X	STA (ADR2),Y	character	PLP		flag	BEQ INSMK	CPX #1		bank	BEQ INSMK		LDA STATLN,X	ORA #%10000000	invert if flag on	STA (ADR2),YINSMK	INY*	INY	INX	CPX #14		7 items	BCC loop	CmpaW TEA,XA	BCS MOVSCR	N1MOVSCR	LDA FFLG	BEQ INVUPLNED		MovaW ADR1,XA		ADR1 = XA		MovaW LOC,XA		LOC = XA		SublW LOC,cTXAD		LOC -= cTXAD		CmplW LOC,20		BCC LNE1		MovlW LOC,20LNE1		SubaB ADR1,LOC		MOVE ADR1,SAVMSK,N40		MovaW YA,SAVMSK		AddaB YA,LOC		LDA #0		JMP CLRBARINVUP	MovaW YY,XA	SubaW YY,WA	MovaW YA,YY	AddaW YA,SAVMSK	LDX #$FF	MovaW LOC,YYNXTLGRW	INX	MovaB LOGCOL,LOC	SubaW LOC,LL	BCS NXTLGRW	STX LOGROW 	MOVE WA,SAVMSK,SSP	LDA OFLG	BEQ WMK	MovaW TEA,XA	SubaB TEA,LOGCOL	AddaB TEA,LLWMK	MovaW LOC,TEA	SubaW LOC,WA	CmpaW LOC,SSP	BCS DTCOL 	AddaW LOC,SAVMSK	LDY #0	LDA #220	STA (LOC),Y	DTCOL	LDX #$FF	MovaW LOC,YYNXTROW	INX	MovaB COL,LOC	SubaW LOC,N40	BCS NXTROW	STX ROW 	TXACLRBAR	LDX LL	CPX #40	BEQ VC1	AND #%11111110VC1	ASL	ASL	CLC	ADC #12	STA VCNT1	ADC #4	CPX #40	BEQ VCEND	ADC #4VCEND	STA VCNT2		LDY #0	LDA (YA),Y	CLC	ADC #128	STA (YA),Y	Cursor on	MovlB $D302,52	PACTL activates joystick	MovlB STICK0,%00001111	MovlB CH,255GETLP	LDA #1		assume mouse/joystick input	STA MSFLAG	MSFLAG = 1 (default)	LDY CH		load keyboard code (255 = none)	CPY #255		check if key available	BEQ +	  KEYPRESS	branch if key not pressed	  JMP LPBG; === Joystick / Fire handling ===+	LDA STRIG0	read STRIG0 (0 = pressed)	BEQ +		if pressed -> joystick/mouse	  LDY #202		pseudo key (special)	  JMP GETLP	SETVECT+	LDA STICK0	read joystick state	  CMP #%00001111	no direction?	  BEQ GETLP	yes -> poll again	  * Mouse delay - X	LDX #40DELAY1  LDY #0              ; inner counter (256 iterations)DELAY2  DEY        BNE DELAY2        DEX        BNE DELAY1	PHA		save stick state	AND #%00000001	test UP	BNE +		if not UP -> next	  UP		dispatch	  +	PLA		restore stick state	PHA	AND #%00000010	test DOWN	BNE +		if not DOWN -> next	  DOWN		dispatch+	PLA		restore stick state	PHA	AND #%00000100	test LEFT	BNE +		if not LEFT -> next	  LDA COL	  BEQ +	  LEFT		dispatch+	PLA		restore stick state	AND #%00001000	test RIGHT	BNE +	  LDA COL	  CMP #39	  BEQ +		  RIGHT		dispatch	+	JMP LPBGKEYPRESS	STY KCD		store key code	MovlB CH,255	clear CH (ack key)	DEC MSFLAG	MSFLAG = 0 (keyboard input)*	JSR $FCD8	CLICK	LDY KCDSETVECT	STY KCD	CPY #192	BCC SEEKKCD		TYA	SBC #200	ASL 	TAX	LDA SCTABLE,X	STA VECTOR	LDA SCTABLE+1,X	STA VECTOR+1PUSHRA	LDA #K0-1:H	PHA	LDA #K0-1:L	PHA	LDA #0	STA ESCFLG	JMP (VECTOR)K0	RTSSEEKKCD	LDX #$FDloop	INX	INX	INX	LDA KCDTAB,X	BEQ DETASC 	CMP KCD	BNE loop	LDA KCDTAB+1,X	STA VECTOR	LDA KCDTAB+2,X	STA VECTOR+1	PUSHRA	JMP LPBGDETASC	LDA (KEYDEF),Y	CMP #NOKEY	BNE +	JMP GETLP+	STA CHR	LDA EFLG	BEQ skip	LDX #$FFloop	INX		English/German	LDA ENG,X	BEQ skip	CMP CHR	BNE loop	LDA GER,X	character found:	STA CHRskip	LDA ESCFLG	BMI WRITE	LDX #$FDSEEKCH1	INX	INX	INX	LDA EDCHTAB,X	BEQ WRITE	CMP CHR	BNE SEEKCH1	LDA EDCHTAB+1,X	STA VECTOR	LDA EDCHTAB+2,X	STA VECTOR+1	PUSHRA	JMP LPBGWRITE	LDA INSFLG	BEQ WR1	INSWR1	LDY #0	STY ESCFLG	STY ROWCRS	STY COLCRS	LDA (SAVMSK),Y	PHA	LDA CHR	CMP 'a'	BCC INVTEST	CMP #123		'z'+1	BCS INVTEST	SEC	SBC CAPSFLGINVTEST	ORA INVFLG	STA CHR		MovlW LEN,1	BPUT $30,CHR,LEN	LDY #0	LDA (SAVMSK),Y	STA (XA),Y	PLA	STA (SAVMSK),Y	RIGHT	JMP LPBG*KCDTAB	DFB 3	DFW UP	DFB 4	DFW DOWN	DFB 19	DFW LEFT	DFB 20	DFW RIGHT	DFB 166	DFW WDFORBAC	DFB 167	DFW WDFORBAC	DFB 39	DFW INV	DFB 103	DFW SHFTINV	DFB 124	DFW SHFTCAPS	DFB 60	DFW CAPS	DFB 140	DFW CTLRET	DFB 188	DFW CTLCAPS	DFB 12	DFW RET	DFB 97	DFW SHFTBLK	DFB 0*CTLRET	SubaB XA,LOGCOL	RTS*RET	CTLRET	AddaB XA,LL	RTS*INV	LDA #0	STA INVFLG	RTS*SHFTINV	LDA #128	STA INVFLG	RTS*CAPS	LDA #0	STA CAPSFLG	RTS*SHFTCAPS	LDA #32	STA CAPSFLG	RTS*CTLCAPS	LDA #96	STA CAPSFLG	RTS*WDFORBAC	LDY KCD	STY LOC		MovaW ADR1,XA	SublB ADR1,2NXTPOS	LDA #167	CMP LOC	BEQ FORWARD	DecW ADR1	LEFT	CmplW ADR1,cTXAD	BNE TEST	BEQ FOUNDFORWARD	IncW ADR1	RIGHT	CmplW ADR1,cMXA	BEQ FOUNDTEST	LDY #1			LDA (ADR1),Y	AND #%01111111	BNE NXTPOS	INY	LDA (ADR1),Y	AND #%01111111	BNE FOUND	LDY #0	LDA (ADR1),Y	AND #%01111111	BNE FOUND	BEQ NXTPOSFOUND	RTS* Starts at Key code 200SCTABLE	DFW O,0,P,U,SCTLRET,I,SCTLMIN	DFW SCTLEQU,0,0,0,0,0,0,0,0	DFW SCTL4,0,SCTL3,SCTL6	DFW SCTLESC,SCTL5,SCTL2,SCTL1	DFW SCTLCOM,SCTLBLK,SCTLPER	DFW N,0,M,SCTLSTRK,SCTLINV,R,E	DFW E,YYY,SCTLTAB,T,W,Q,SCTL9,0	DFW SCTL0,SCTL7,SCTLDBS	DFW SCTL8,SCTLCLR,SCTLINS	DFW F,H,D,0,SCTLCAP,G,SSCTLESC	RTS	(not available in emulators)SCTLINV	RTS	(not available in emulators)SCTL1	WNDW	PRINTSN "ERASE BANK? Y/N"	GET	CMP 'Y	BNE skipDLTXBF	MovlW ADR1,cTXAD	LDX #$40		length of text buffer: high	LDY #0	TYAloop	DEY	STA (ADR1),Y	BNE loop	  INC ADR1+1	  DEX	  BNE loopskip	SCTLRET	RTSO	LDA #1	EOR OFLG	STA OFLGSCTL0	RTS	illegal for emulators*SCTLRET	LDA #cTXAD	STA XA	STA WA	LDA #cTXAD:H	STA XA+1	STA WA+1	RTSI	LDA #1	EOR INSFLG	STA INSFLG	RTS*	RTSSCTL3	RTSSCTL7	RTSSCTLSTRK	LDA LOGCOL	BEQ +	  M+	COB	RTSXASV	DFW 0SCTL5	MovaW XASV,XA	RTSSCTL6	MovaW XA,XASVSCTLBLK	RTSSCTLCAP	SubaB YA,LOGCOL	LDY #38	MovlB DIF,$FF-	INY	INC DIF	LDA (YA),Y	BNE -	MovaW ADR1,YA	AddaB ADR1,DIF	MovaW LEN,LL	MovaW ADR2,YA	MovaW LOC,ADR2	MOVER	MovaW ADR2,LOC	LDA #0	LDY LL	LDX DIF-	BEQ SCP2	DEY	STA (ADR2),Y	DEX	JMP -SCP2	GET	RTS* Pointer to end of text bufferN	MovlB OFLG,0N1	MovlW TEA,cMXA	RTS	*** S-Ctl <.>SCTLPER	CTLRETCOB	AddaB XA,LL	CmpaW XA,TEA	BCC CO2	SubaB XA,LL 	RTSCO2	LDY #0	LDA (XA),Y	BNE CO1	CTLDBS	JMP COBCO1	DecW XA	LDY #0	LDA (XA),Y	PHP	IncW XA	PLP	BEQ COB	MovlB KCD,166	WDFORBAC	RTS*SCTLCLR	MovaW XA,XASV	RTS*R	WNDW	PRINTSN "REALINE? Y/N"	GET	CMP 'Y	BNE R6		MovaW LOC,XA	CTLRET	TEUP-	AddaB XA,LL	CmpaW XA,TEA	BCC -	MovaW SV,XAR1	SubaB SV,LL	MovaW XA,SV	CmpaW LOC,XA	BCC R2	MovaW XA,LOCR6	RTSR2	DecW XA	LDY #0	LDA (XA),Y	BEQ SPACE	CMP #223	BEQ HYPH	IncW XA	IncW TEA		INS	DecW XA	JMP R1SPACE	CTLDBS	JMP R2HYPH	CTLDBS	JMP R1*E	LDA #1	EOR EFLG	STA EFLG	RTSSCTLTAB	RTS* insert-block beginSCTL8	MovaW INSBGAD,XA	RTS* insert=block endSCTL9	CmpaW XA,INSBGAD	BCC SC0END	MovaW LEN,XA	IncW LEN	SubaW LEN,INSBGAD	CmplW LEN,cCBLKMXL	BCC SC01	MovlW LEN,cCBLKMXLSC01	MovaW CBLKLEN,LEN	MovaW ADR1,INSBGAD	MovlW ADR2,cCBLKBUF	MOVERSC0END	RTSSCTL2	LDA #1	EOR DBSFLG	STA DBSFLG	RTSSCTLDBS	INSLN	MOVE DLLNBF,XA,LL	RTSSCTL4	LDA LL	CMP #80	BNE SC81	MovlB LL,40	RTSSC81	MovlB LL,80	RTSQ	CLOSE $20	CLOSE $30	GR 0	CLRCSR	MovaW BRKKY,BKYSV	MovaB PORTB,PTBSV	LDX STKSV	TXS	RTSSCTLINS	MovaW LEN,SAVMSK	AddaW LEN,SSP	SubaW LEN,YA	CmpaW LEN,CBLKLEN	BCC DISPLAY 	MovaW LEN,CBLKLENDISPLAY	MovlW ADR1,cCBLKBUF	MovaW ADR2,YA	MOVER	GET	CMP #EOL	BNE SCINSEND	MovlW ADR1,cCBLKBUF	MovaW ADR2,XA	MOVERSCINSEND	RTS*F	LDA FFLG	EOR #128	STA FFLG	CLS	RTS***BANKTAB	DFB $FF	DFB $EF,$EB,$E7,$E3	DFB $AF,$AB,$A7,$A3	DFB $6F,$6B,$67,$63	DFB $2F,$2B,$27,$23H	WNDW	PRINTSN "<A> Main RAM   <B>-<E> 130XE Bank"	PRINTSN "<F-I> <J-M> <N-Q> COMPY SHOP Bank"	loop	GET	AND #%11011111	CMP 'A'	BCC loop	CMP 'R'	BCS loop		SEC	SBC 'A'	TAX	LDA BANKTAB,X	STA BANK	STA PORTB	STA SCREEN+960	JMP LPBG	***SCTLCOM	LDY #0	LDA #221	STA (XA),Y	IncW XA	RTS*RW	DFW 0MGN	DFB 0G	CTLRET	GR 22	MovlB ATACHR,1	PLOT 0,0	DRTO 0,95	DRTO 136,95	DRTO 136,0	DRTO 0,0		PLOT 0,0	LDY #0	STY RW	STY RW+1DO1	STY CNTDO2	LDA (XA),Y	BEQ ENDPL	CMP #221	BNE PLOTP	INC RW	BNE ENDPLPLOTP	CLC	LDA #8	ADC RW	ADC RW	CMP #159	BCS END	STA COLCRS	SEC	LDA #87	SBC CNT	SBC MGN	STA ROWCRS	LDX #$60	LDA ATACHR	CIOV	LDY #0ENDPL	IncW XA	CmpaW XA,TEA	BCS END		INC CNT	LDA CNT	CMP LL	BNE DO2	INC RW	LDA RW	CLC	ADC DBSFLG	STA RW	BNE DO1END	GETGND	JMP BKTP	*WL	DFW 0WNDW	MovaW ADR1,SAVMSK	MovlW LEN,120	CLEAR	MovlW VCNT1,$1A00	POS 0,0	RTS*S	WNDW	MovlW ADR1,cWORD	MovaW ADR2,SAVMSK	AddlB ADR2,40	MovaW LOC,ADR2	MovaW LEN,WL	MOVER	PRINTSN "SEARCH"	INPUT $00,cWORD	LDY #$FFloop	INY	LDA cWORD,Y	CMP #EOL	BEQ S2	LDA (LOC),Y	STA cWORD,Y	JMP loopS2	STY WLW	IncW XA	CmpaW XA,TEA	BCC W1	JMP RSTXAW1	LDY #0loop	LDA cWORD,Y	CMP #EOL	BEQ WND	CMP (XA),Y	BNE W	INY	BNE loopWND	RTS*ABV	EQU $543SHFTBLK	LDY #0loop	DecW XA	LDA (XA),Y	BNE loop	IncW XA	LDA (XA),Y	BNE +	RTS+	MovlB ABV,143loop	LDA (XA),Y	PHP	INY	STA ABV,Y	PLP	BNE loop	MovlB PORTB,$6F	MovlW LOC,$3999	???????A3	IncW LOC	LDA LOC+1	BMI AEND	LDY #$FFloop	INY	LDA ABV,Y	BEQ skip	CMP (LOC),Y	BNE A3		BEQ loopskip	CMP (LOC),Y	BNE A3	LDX #0loop	INY	LDA (LOC),Y	CMP #143	BEQ skip	STA ABV,X	INX	BNE loopskip	MovaB PORTB,BANK	LDY #0	STX CNT	LDX #0loop	LDA ABV,X	STA (XA),Y 	IncW XA	INX	DEC CNT	BNE loopAEND	RTS*P	MovaW TEA,XA	RTSSCTLMIN	SubaW XA,SSP	SubaW WA,SSP	RTSSCTLEQU	AddaW WA,SSP	AddaW XA,SSP	RTSU	LDY #0		Underline	LDA (XA),Y	CLC	ADC #128	STA (XA),Y	RIGHT	RTSYYY	LDY #0		Upper case to lower case	LDA (XA),Y	TAX	AND #%01111111	CMP #33	BCC YEND	CMP #59	BCS YEND	TXA	ADC #64	STA (XA),Y		YEND	RIGHT	RTS*EDCHTAB	DFB 28	ASCII codes	DFW UP	DFB 29	DFW DOWN	DFB 30	DFW LEFT	DFB 31	DFW RIGHT	DFB 126	DFW DBS	DFB 127	DFW TAB	DFB 254	DFW CTLDBS	DFB 255	DFW INS	DFB 156	DFW DELLN	DFB 157	DFW INSLN	DFB 27	DFW ESC	DFB 158	DFW CTLTAB	DFB 159	DFW SHFTTAB	DFB 125	DFW CTLCLR	DFB 0*CTLCLR	MovaW LEN,SSP	AddaW LEN,SAVMSK	SubaW LEN,YA	MovaW ADR1,YA	MovaW DIF,TEA	SubaW DIF,XA	CmpaW LEN,DIF	BCC +	MovaW LEN,DIF+	CLEAR	GET	CMP #EOL	BNE +	MovaW LEN,TEA	SubaW LEN,XA	MovaW ADR1,XA	CLEAR+	RTS*CTLTAB	LDA #0	BEQ SETTAB*SHFTTAB	LDA 'XSETTAB	LDX LOGCOL	STA TABMAP,X	RTS*TAB	LDX LOGCOLloop	INX	CPX LL	BNE +	LDX #0+	IncW XA	LDA TABMAP,X	CMP 'X'	BNE loop	RTS*ESC	LDA #128	STA ESCFLG	RTS*UP	CmplW XA,cTXAD+40	stop cursor jump to begin	BCC +	SublB XA,40+	RTS*DOWN	CmplW XA,cMXA-40	stop cursor jump to end	BCS +	AddlB XA,40+	RTS*LEFT	DecW XA	RTS*RIGHT	IncW XA	RTS	ORG $2200DBS	LEFT	CmplW XA,cTXAD	BCC +	LDA #0	TAY	STA (XA),Y	LDA INSFLG	BEQ +	CTLDBS	+	RTS*M	LDA LL	SEC	SBC LOGCOL	STA DIF		INSCHS		LDY #0	MovaW LOC,XA	DecW LOC	LDA (LOC),Y	BEQ +	LDA #223	STA (XA),Y+	AddaB XA,DIF	RTS	** Insert lineINSLN	MovaB DIF,LL	DIF = LL	CTLRETINSCHS	MovaW ADR1,TEA	SubaB ADR1,DIF	ADR1 = TEA - DIF	LDY DIF		Y = DIF	DEYloop	LDA (ADR1),Y	make sure there is an empty line	BNE IERR			in front of TEA	DEY	BPL loop	MovaW ADR2,XA	AddaB ADR2,DIF	DecW ADR2	MovaW LEN,TEA	SubaW LEN,ADR2	MovaW ADR1,XA	DecW ADR1	MMOVER	MovaW ADR1,XA	DecW ADR1	CLRCHS	RTS*IERR	JMP $F556IERR	JMP LPBG     *DELLN	RET	CmpaW TEA,XA	PHP	SubaB XA,LL	PLP	BCC IERR	LDY LLloop	DEY	BMI DLN2	LDA (XA),Y	BEQ loop	MOVE XA,DLLNBF,LLDLN2	MovaW DIF,LLDELCHS	MovaW ADR1,XA	AddaB ADR1,DIF	MovaW LEN,TEA	SubaW LEN,ADR1	MovaW ADR2,XA	MOVER	MovaW ADR1,TEA	DecW ADR1	SubaB ADR1,DIF	CLRCHS	RTS*INS	MovlB DIF,1	CmplW XA,cMXA-1	BCS +	INSCHS+	RTS*CTLDBS	MovlB DIF,1	CmplW XA,cMXA-1	BCS +	DELCHS+	RTS*** move block of length LEN from ARD1 to ADR2MOVER	LDY #0	LDX LEN+1	BEQ MVREMI	length < 256MVBLK	LDA (ADR1),Y	   move block	STA (ADR2),Y	INY	BNE MVBLK	go to remainder when Y is zero	INC ADR1+1	INC ADR2+1	DEX	BNE MVBLKMVREMI	LDA LEN	BEQ MVNDloop	LDA (ADR1),Y	move remainder	STA (ADR2),Y	INY	CPY LEN	BNE loopMVND	RTS**** minus move block of length LEN from ARD1 to ADR2MMOVER	AddaW ADR1,LEN	AddaW ADR2,LEN	LDX LEN+1	INX	LDY #$FFMMVBLK	DEC ADR1+1	DEC ADR2+1	DEX	BEQ MMVREMloop	LDA (ADR1),Y	STA (ADR2),Y	DEY	BNE loop	LDA (ADR1),Y	STA (ADR2),Y	DEY	BMI MMVBLKMMVREM	LDX #0loop	CPX LEN	BEQ MMVEND	break if EQ	LDA (ADR1),Y	STA (ADR2),Y	DEY	INX	BNE loopMMVEND	RTS*CLRCHS	LDY DIF	LDA #0loop	STA (ADR1),Y	DEY	BNE loop	RTS*LNPNT	EQU ADR1PBFPNT	EQU LENULFLG	EQU ADR2ACTLL	EQU ADR2+1T	WNDW	PRINTSN "<1>Atari800Win PLus   <2>Export TEMP.TX"	PRINTSN "<3>Atari 1027 Printer <4>Import TEMP.TX"	PRINTSN "<5>Exit"loop	GET	CMP '1	BNE +	  JMP TZ+	CMP '2	BNE +	  JMP EXPORT+	CMP '3	BNE +	  JMP T1+	CMP '4	BNE +	  JMP IMPATA+	CMP '5	BNE loop	  RTS	*** 1027 Printer (Do not change this code, as it can no longer be tested.)T1	MovaW BRKKY,BKYSV	CLOSE $40	OPEN $40,8,0,"P:"		CTLRET	TEUP	LDY #0	STY LNPNT	STY PBFPNT	LDA #27		ESC	PUTPBUF	LDA #23		International characters on	PUTPBUF	LPRINTTYPLOOP	MOVE XA,SAVMSK,LL	LDY #0	STY LNPNT	STY PBFPNT	STY ULFLG	LDY LLDETACTLL	DEY	BMI DTC2	LDA (XA),Y	BEQ DETACTLL	DTC2	INY	STY ACTLLNXTPCH	LDY LNPNT	  DO	CPY ACTLL	BEQ DETLEN	LDA (XA),Y		INC LNPNT	LDX #0	CMP #223	BNE ATLP	LDA '-	BNE UNLNATLP	CMP #32	BCC TYPE2 	INX	SBC #32		JMP ATLPTYPE2	ADC ASCTAB,X	UNLN	BMI UNDRLN	LDX ULFLG	BPL PTB	STA ULFLG	ULOFF	LDA ULFLG	BPL PTBUNDRLN	LDX ULFLG	BMI PTB	STA ULFLG	ULON	LDA ULFLGPTB	PUTPBUF		JMP NXTPCH	  LOOPDETLEN	LDX DBSFLGPUTEOL	LDA #155	PUTPBUF	DEX	BEQ PUTEOL	AddaB XA,LL	LPRINT		printer or disk	CmpaW XA,TEA	BCS TYPEND		JMP TYPLOOP	LOOPTYPEND	RTSPUTPBUF	LDY PBFPNT	CMP #157	BNE PTBF1	LDA #155PTBF1	STA cPRBF,Y	INC PBFPNT	RTSLPRINT	LDA #0		printer or disk	STA PBFPNT+1	BPUT $40,cPRBF,PBFPNT	BPL + 	  JMP LPBG+	RTSULON	LDA #27	PUTPBUF	LDA #25	PUTPBUF	RTSULOFF	LDA #27	PUTPBUF	LDA #26	PUTPBUF	RTS************************************************EXPORT	OPEN $40,8,0,"D:TEMP.TX"EXPORT1	MovlB EXPFLG,1	BNE +TZ	OPEN $40,8,0,"P:"+	MovaW BRKKY,BKYSV	CTLRET		to line begin	TEUP	LDY #0	STY LNPNT	STY PBFPNT	TYPLOOPZ	MOVE XA,SAVMSK,LL	LDY #0	STY LNPNT	STY PBFPNT	STY ULFLG		LDY LL-	DEY		determine actual line length	  BMI DTC2Z	  LDA (XA),Y	BEQ -	DTC2Z	INY	STY ACTLL	actual line lengthNXTPCHZ	LDY LNPNT	  DO	CPY ACTLL	BEQ DETLENZ	LDA (XA),Y		INC LNPNT	LDX #0	CMP #223		inverted right arrow	BNE ATLPZ	  LDA '-'	hyphen	  BNE PTBZATLPZ	CMP #32	  BCC + 	  INX	  SBC #32		JMP ATLPZ+	ADC ASCTAB,X	PTBZ	LDY EXPFLG	BEQ +	  PUTPBUF	no char conversion	  JMP NXTPCHZ	LOOP	  +	PUTPBUFZ		Atari char -> PC char	JMP NXTPCHZ	LOOPDETLENZ	LDX DBSFLGPUTEOLZ	LDA #157	PUTPBUFZ		Atari char -> PC char	DEX	BEQ PUTEOLZ	LPRINT		printer or disk	AddaB XA,LL	CmpaW XA,TEA	BCS TYPENDZ		JMP TYPLOOPZ	LOOPTYPENDZ	JMP BKTP*** single char Atari->PC charPUTPBUFZ	LDY PBFPNT	CMP #157		inverted down arrow	BNE +	  LDA #155	convert to EOL	  BNE PUTBF1Z	BRA+	AND #%01111111	inverted chars normal	CMP #27	BCS skip	TAX	LDA ANSITAB,X	skip	CMP #123		atari'A'umlaut	BNE +	LDA #196		ansi 'A'umlaut	BNE PUTBF1Z+	CMP #96		atari'i' accented	BNE PUTBF1Z	LDA #237		ansi 'i' accentedPUTBF1Z	STA cPRBF,Y	INC PBFPNT	RTS****************************************************DONE    RTSBUF     DFB 0************************************************ANSITAB	DFB 225,249,209,201,231,244,242,236	DFB 163,239,252,228,214,250,243,246	DFB 220,226,251,238,233,232,241,234	DFB 229,224,197					   ASCTAB	DFB 32,64,0,96,160,192,128,224INSBGAD	DFW 0CBLKLEN	DFW 0cCBLKMXL	EQU $960COLPF1	EQU $D017WSYNC	EQU $D40AVCOUNT	EQU $D40BNMIEN	EQU $D40EVDSLST	EQU $200SDLSTL	EQU $230VORBERT	SublB SAVMSK,40	MovaW SCREEN,SAVMSK	MovlW SDLSTL,NEWDLST	MovlB NMIEN,$40	MovlW VDSLST,DLIPGM	MovlB NMIEN,$C0		RTSDLIPGM	PHA	LDA VCOUNT	STA WSYNC	CMP VCNT1	BCS skip	MovlW COLPF1,$C009	BNE ENDIskip	CMP VCNT2	BCS skip	MovlW COLPF1,$120B	BNE ENDIskip	MovlW COLPF1,$C009ENDI	PLA	RTINEWDLST	DFB $70,$70,$F0	DFB 66+$80SCREEN	DFW 0	DFB $82,$82,$82,$82,$82	DFB $82,$82,$82,$82,$82	DFB $82,$82,$82,$82,$82	DFB $82,$82,$82,$82,$82	DFB $82,$82,$82,$F0,$82	DFB 65	DFW NEWDLSTCLRCSR	MovlB 709,9	MovlB 710,192	MovlB 712,226	MovlB 729,20	MovlB 730,3	RTS*DEVS	ASC "S:"GRAPHR	PHA	CLOSE $60	PLA	STA ICAX2,X	AND #$F0	EOR #$10	ORA #$0C	STA ICAX1,X	MovlBX ICCOM,COPEN	MovlWX ICBAL,DEVS	CIOV	RTS*GET	LDX #$20	MovlBX ICCOM,CGBIN	LDA #0	STA ICBLL,X	STA ICBLH,X	CIOV	RTS*CLEAR	LDA #0	TAY	STA (ADR1),Y	MovaW ADR2,ADR1	IncW ADR2	DecW LEN	MOVER	RTS* Move pointer from end of text buffer to end of textTEUP	LDY #0loop	DecW TEA	LDA (TEA),Y	BEQ loop	IncW TEA	RTS*PLOTR	LDX #$60	MovlBX ICCOM,CPBIN	LDA #0	STA ICBLL,X	STA ICBLH,X	LDA ATACHR	CIOV	RTS*DRTOR	LDX #$60	MovlBX ICCOM,CDRAW	MovlBX ICAX1,CCLSE	MovlBX ICAX2,0	CIOV	RTS*PRINTR	MovlBX ICCOM,CPTXT	MovlWX ICBLL,120	CIOV	RTS*MENUE	ASC /L/,"OAD    "  	DFB 4,CGBIN	DFW SAVLOD	ASC /S/,"AVE    "	DFB 8,CPBIN	DFW SAVLOD	ASC /D/,"IR     "	DFB 6,0	DFW DIR	ASC /R/,"ENAME  "	DFB 0,$20	DFW RENAME	ASC /E/,"RASE   "	DFB 0,$21	DFW ERASE	ASC /P/,"ROTECT "	DFB 0,$23	DFW PROT	ASC /U/,"NPROT. "	DFB 0,$24	DFW UNPROT	ASC /I/,"mport  "  	DFB 4,CGBIN	DFW IMPTLP	ASC /X/,"port   "	DFB 8,CPBIN	DFW EXPORT1	DFB 0cMENITL	EQU 8cNUMATR	EQU 4D	GR 0	CLOSE $00	OPEN $00,12,0,"E:"	CLRCSR	MovlB cPRBF,'*'	MovlB cPRBF+1,155	MovlW ADR1,MENUE+24	    MENUE + 2*(cMENITL+cNUMATR)	DOCMND		won't return (pla, pla)NXTITM	LDY #0	LDA (ADR1),Y	BEQ PICK	PRMNIT	AddlB ADR1,cMENITL+cNUMATR	JMP NXTITM 	PICK	PRINTSN ""	GET	STA CHR	MovlW ADR1,MENUEFINDIT	LDY #0	LDA (ADR1),Y	AND #%01111111	BEQ PICK	CMP CHR	BEQ ITFND	AddlB ADR1,cMENITL+cNUMATR	JMP FINDITITFND	POS 0,22	PRMNIT			print item found	LDA CHR	CMP 'S'			load?	BNE skip		  LDA cSAVBF	  BEQ skip		No file was loaded	  PRINT 0,cSAVBF		Print Name of loaded file	  	  POS 7,22		Set cursor	  MovlW ICBLL,0		0 for single character	  MovlB ICCOM,$0B		PUT CHAR / PUT RECORD	  LDA '?	  CIOV			Activate cursorskip	INPUT $00,cPRBF		input from keyboard	LDA CHR	CMP 'L'			load?	BNE skip	  LDY #0-	  LDA cPRBF,Y	  STA cSAVBF,Y	  INY	  CMP #155	  BNE -skip	NOPDOCMND	CLOSE $40	adjstDX        	LDX #$40	LDY #cMENITL	LDA (ADR1),Y	STA ICAX1,X	MovlBX ICAX2,0	MovlBX ICCOM,COPEN	MovlWX ICBAL,cPRBF	CIOV	LDY #cMENITL+1	LDA (ADR1),Y	STA ICCOM,X	CMP #CPBIN	SAVE?	BNE skip* SAVE		LDY #0loop	DecW TEA		marker to end of text to be saved	LDA (TEA),Y	BEQ loop	IncW TEA		first space after last character to be saved			CmplW XA,cTXAD	cursor at begining of text buffer_	BEQ skip		PRINTSN @Cursor is not at text begin. Save anywayY/N?@	GET	CMP 'Y'	BEQ skip	BKTP	skip	LDY #cMENITL+2	LDA (ADR1),Y	STA VECTOR 		INY	LDA (ADR1),Y	STA VECTOR+1	LDA #M0-1:H	PHA	LDA #M0-1:L	PHA	JMP (VECTOR)M0	CIOV		MovaB PORTB,BANK	CLOSE $40	BKTP*SAVLOD	LDX #$40	LDA XA	STA ICBAL,X	LDA XA+1	STA ICBAH,X	MovaW LEN,TEA	SubaW LEN,XA	LDA LEN	STA ICBLL,X	LDA LEN+1	STA ICBLH,X	RTSRENAME	RTSERASE	RTSPROT	RTSUNPROT	RTSDIRLN	INPUT $40,cPRBF	BMI skip	PRINT $00,cPRBF	RTSskip	PRINTSN ""	MovlW ADR1,MENUE	PLA	PLA	JMP NXTITM	DIR	CLSloop	DIRLN	DEC ROWCRS	MovlB COLCRS,19	DIRLN	JMP loopPRMNIT	LDX #$00	MovlBX ICCOM,CPBIN	LDA #cMENITL	STA ICBLL,X	LDA #0	STA ICBLH,X	LDA ADR1	STA ICBAL,X	LDA ADR1+1	STA ICBAH,X	CIOV	BMI DOSERR	  	RTSDOSERR	STY CHR	MovlW LEN,1	CLS	BPUT $00,CHR,LEN	GET	BKTP	DFB 0****************************************** Routines from SGEN ******************* If ":" not found, "D:" is assumed ****** If found, could be D:,F:,P:,S:etc ***adjstDX	LDA ':'	CMP cPRBF+1	BEQ skip	CMP cPRBF+2	BEQ skip	LDY #30	ample length	LDX #32loop	LDA cPRBF,Y		'X'	  STA cPRBF,X		  DEX	  DEY	  BPL loop	LDA 'D'	STA cPRBF	LDA ':'	STA cPRBF+1skip	LDY #1loop	INY		LDA cPRBF,Y	CMP '.'	BNE +	  RTS+	CMP #155	BNE loop		LDA '.'	STA cPRBF,Y	INY		LDA CHR	CMP 'X	BNE +	  BEQ skip  +	CMP 'I	BNE +skip	  LDA 'T	  STA cPRBF,Y	  INY	  +	LDA 'X'	STA cPRBF,Y	INY	LDA #155	STA cPRBF,Y		RTS	#PHB	PHA	CMP #10	BCC PHB2	PT \$\	STX XSAV	PLAPHB1	PHA	LSR	LSR	LSR	LSR	BEQ PHB2	TAX	LDA HXTB,X	PTCHPHB2	PLA	AND #%00001111	TAX	LDA HXTB,X	PTCH	LDX XSAV	RTS	HXTB	ASC "0123456789ABCDEF"XSAV	DFB 0************************************BLK	LDA ' 'PTCH	STX TMP	LDX LPTR	STA LN,X	INC LPTR	LDA LPTR	CMP LPTRMX	BEQ PCHER	INC CHC	LDX TMP	DEC A1	BEQ PTCND	MovaB A1,SECSZPTCND	RTS#      ; =============================================; Open file D:TEMP.TX; =============================================IMPATA	CLOSE $40	OPEN $40,4,0,"D:TEMP.TX"         BPL IMPTLP         JMP OPENERR; Main loopIMPTLP   LDX #$40	LDA #127		maximum line length         STA ICBLL,X         LDA #$00         STA ICBLH,X         LDA #$05            ; GET RECORD         STA ICCOM,X         LDA XA         STA ICBAL,X         LDA XA+1         STA ICBAH,X         JSR CIOV         BMI EOF; Get actual length	LDX #$40         LDA ICBLL,X         STA LEN; Check if last byte is EOL ($9B)	BEQ +          ; safety (empty line)	TAY                 ; Y = LEN	DEY                 ; Y = LEN-1	LDA (XA),Y	CMP #$9B	BNE +	DEC LEN             ; discard EOL; Convert in-place ATASCII to screen code+        LDY #$00convloop LDA (XA),Y         JSR ATASCR         STA (XA),Y         INY         CPY LEN         BNE convloop; Advance XA pointer         CLC         LDA XA         ADC LEN         STA XA         LDA XA+1         ADC #$00         STA XA+1; Fill remaining bytes with zeros if shorter than LL         LDA LL         SEC         SBC LEN         BEQ nextline         STA LENfilloop  LDA #$00         LDY #$00         STA (XA),Y         IncW XA         DEC LEN         BNE filloopnextline JMP IMPTLP; ATASCII to Screen Code conversion (value in A)ATASCR   CMP #$20         BCC add40         CMP #$40         BCC sub20         CMP #$60         BCC sub20         CMP #$80         BCC skip         CMP #$A0         BCC add40         CMP #$C0         BCC sub20         CMP #$E0         BCS skipsub20    SEC         SBC #$20         RTSadd40    CLC         ADC #$40skip     RTS; End of fileEOF      LDX #$40         LDA #$0C            ; CLOSE         STA ICCOM,X         JSR CIOV         RTS; Show error number at top-left of screenOPENERR  STY $02C0          ; temporarily save error code         LDY #$00         LDA $02C0         STA (SAVMSK),Y      ; display error number at top-left         RTS*** Put Acc char
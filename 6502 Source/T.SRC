*	CPFL T.O
	OUT T

 XFDIMAGE W1_DD.XFD
 RUNEMUL "C:\Program Files (x86)\Atari800WinPLus\Atari800Win.exe"


EOL	EQU $9B

ICCOM	EQU $342
ICBAL	EQU $344
ICBAH	EQU $345
ICBLL	EQU $348
ICBLH	EQU $349
ICAX1	EQU $34A
ICAX2	EQU $34B

CIOV	EQU $E456


*	OUT
COPEN	EQU 3
CCLSE	EQU 12
CGTXT	EQU 5
CPTXT	EQU 9
CGBIN	EQU 7
CPBIN	EQU 11
CDRAW	EQU $11

ATACHR	EQU $2FB
ROWCRS	EPZ $54	
COLCRS	EPZ $55
STICK0	EQU $0278

GR	MACRO S
	LDA #S
	GRAPHR
	MEND

POS	MACRO X,Y
	MovlW COLCRS,X
	MovlB ROWCRS,Y
	MEND

PLOT	MACRO X,Y
	POS X,Y
	PLOTR
	MEND

DRTO	MACRO X,Y
	POS X,Y
	DRTOR
	MEND

OPEN	MACRO K,AX1,AX2,FI
	JMP OP1@
F@	ASC FI
	DFB EOL
OP1@	LDX #K
	MovlBX ICAX1,AX1
	MovlBX ICAX2,AX2
	MovlBX ICCOM,COPEN
	MovlWX ICBAL,F@
	CIOV
	MEND

CLOSE	MACRO N
	LDX #N
	MovlBX ICCOM,CCLSE
	CIOV
	MEND

PRINT	MACRO N,LAB
	LDX #N
	MovlWX ICBAL,LAB
	PRINTR
	MEND
	
	
PRINTSN	MACRO STRI
	JMP P2@
P1@	ASC STRI
	DFB EOL
P2@	PRINT 0,P1@
	MEND

PRINTS	MACRO STRI
	JMP P2@
P1@	ASC STRI
P2@	LDX #0
	MovlWX ICBAL,P1@
	MovlBX ICCOM,11		CPBINR
	MovlWX ICBLL,P2@-P1@
	CIOV
	MEND

INPUT	MACRO N,LAB
	LDX #N
	MovlBX ICCOM,CGTXT
	MovlWX ICBAL,LAB
	MovlWX ICBLL,127
	CIOV
	MEND

BPUT	MACRO K,BUF,L
	LDX #K
	MovlBX ICCOM,CPBIN
	LDA L
	STA ICBLL,X
	LDA L+1
	STA ICBLH,X
	MovlWX ICBAL,BUF
	CIOV
	MEND

MovlB	MACRO A,N
	LDA #N
	STA A
	MEND

MovlBX	MACRO A,N
	LDA #N
	STA A,X
	MEND

MovaB	MACRO A,N
	LDA N
	STA A
	MEND

MovlWX	MACRO A,V
	MovlBX A,V
	MovlBX A+1,V:H
	MEND

MovlW	MACRO A,V
	MovlB A,V
	MovlB A+1,V:H
	MEND

MovaW	MACRO A,N
	MovaB A,N
	MovaB A+1,N+1
	MEND

************* A R I T H M E T I C *********

IncW	MACRO A
	INC A
	BNE E@
	INC A+1
E@	MEND

DecW	MACRO A
	DEC A
	LDA A
	CMP #$FF
	BNE E@
	DEC A+1
E@	MEND

AddlB	MACRO A,I
	LDA #I
	CLC
	ADC A
	STA A
	BCC E@
	INC A+1
E@	MEND

AddaB	MACRO A,I
	LDA I
	CLC
	ADC A
	STA A
	BCC E@
	INC A+1
E@	MEND

AddaW	MACRO A,I
	LDA I
	CLC
	ADC A
	STA A
	LDA I+1
	ADC A+1
	STA A+1
	MEND

SublB	MACRO A,D
	LDA A
	SEC
	SBC #D
	STA A
	BCS E@
	DEC A+1
E@	MEND

SubaB	MACRO A,D
	LDA A
	SEC
	SBC D
	STA A
	BCS E@
	DEC A+1
E@	MEND

SubaW	MACRO A,B
	SEC
	LDA A
	SBC B
	STA A
	LDA A+1
	SBC B+1
	STA A+1
	MEND

DCMPLI	MACRO A,B
	LDA A+1
	CMP #B:H
	BNE E@
	LDA A
	CMP #B
E@	MEND

DCMP	MACRO A,B
	LDA A+1
	CMP B+1
	BNE E@
	LDA A
	CMP B
E@	MEND

MOVE	MACRO OA,A2,L
	MovaW ADR1,OA
	MovaW ADR2,A2
	MovaW LEN,L
	MOVER
	MEND	

*
LMARGN	EQU 82
SAVMSK	EQU 88
KEYDEF	EQU 121
CH	EQU 764 keycode of last pressed key
BRKKY	EQU 566
CHBAS	EQU 756
PORTB	EQU $D301

NOKEY	EQU 208

*
ADR1	EPZ $80 
ADR2	EPZ $82
LEN	EPZ $84

LOC	EPZ $E0
YA	EPZ $E2
SV	EPZ $E4
XA	EPZ $E6
WA	EPZ $E8

YY	EQU $EE
DIF	EQU $F0
CHR	EQU $F1
TEA	EPZ $F2
CNT	EQU $F4
TEMP	EPZ $F6
*

CLS	EQU $F420



	ORG $2E0
	DFW JMPBEG

	ORG $8000

JMPBEG	JMP BEGIN

BANK	DFB $67 
SSP	DFW 960
TXAD	DFW $4000
PRVXA	DFW $4000
MXA	DFW $7CFF-1056	** 96-960
VECTOR	DFW 0
KCD	DFB 0
ESCFLG	DFB 0

DBSFLG	DFB 0,146
EFLG	DFB 0,165
INSFLG	DFB 0,169
OFLG	DFB 0,175
CAPSFLG	DFB 0,190
INVFLG	DFB 0,143 EQU 694

LL	DFW 40
ROW	DFB 0
COL	DFB 0
LOGROW	DFB 0
LOGCOL	DFB 0
VCNT1	DFB 0
VCNT2	DFB 0
N40	DFW 40
FFLG	DFB 0
STKSV	DFB 0
PTBSV	DFB 0
BKYSV	DFW 0

TABMAP	ASC ".......X.......X.......X.......X.......X" 
	ASC ".......X.......X.......X.......X.......X"
ENG	DFB 1,21
	ASC "zZyY
	DFB 0
GER	DFB 11,10
	ASC "yYzZ"

***********************************
*	B E G I N	*

***********************************
BEGIN	MovaB PTBSV,PORTB

	TSX
	STX STKSV

	MovaW BKYSV,BRKKY
	MovlW BRKKY,BKTP

	SCTLRET
	N


BKTP	CLI

	LDA #$80
	PHA

CLSE	PLA
	SEC
	SBC #$10
	BEQ START
	TAX
	PHA
	MovlBX ICCOM,CCLSE
	CIOV
	JMP CLSE

START	GR 0
	OPEN $30,8,0,"S:"
	OPEN $50,12,0,"E:"
	CLRCSR
	OPEN $20,4,0,"K:"

	VORBERT

	MovlB CHBAS,204

	MovlB LMARGN,0

RSTXA	MovaW XA,PRVXA

LPBG	LDX STKSV
	TXS

	CLOSE $40
	MovaW PRVXA,XA

	MovaW PORTB,BANK
	DCMP XA,TXAD
	BCS skip
	MovaW XA,TXAD

skip	DCMP WA,TXAD
	BCS LB2
	MovaW WA,TXAD

LB2	MovaW ADR1,MXA
	SubaW ADR1,SSP
	IncW ADR1
	DCMP ADR1,WA
	BCS TXTEND
	MovaW WA,ADR1

TXTEND	DCMP XA,MXA
	BCC SCROLUP
	MovaW XA,MXA
	MovaW WA,MXA
	SubaW WA,SSP
	IncW WA

SCROLUP	MovaW ADR1,WA
	AddlB ADR1,80
	DCMP XA,ADR1	

	BCS CHECKWA
	SubaB WA,LL
	JMP SCROLUP

CHECKWA	DCMP WA,TXAD
	BCS SCROLDN
	MovaW WA,TXAD

SCROLDN	MovaW ADR2,WA
	AddaW ADR2,SSP
	SublB ADR2,80
	DCMP XA,ADR2
	BCC INSMODE
	AddaB WA,LL
	JMP SCROLDN

INSMODE	MovaW ADR2,SAVMSK
	AddaW ADR2,SSP

	LDY #20
	LDX #0

loop	LDA DBSFLG,X
	PHP
	INX
	STA (ADR2),Y
	PLP
	BEQ INSMK

	LDA DBSFLG,X
	STA (ADR2),Y

INSMK	INY
	INY
	INX
	CPX #12
	BCC loop

	DCMP TEA,XA
	BCS MOVSCR
	N1

MOVSCR	LDA FFLG
	BEQ INVUP

LNED		MovaW ADR1,XA		ADR1 = XA

		MovaW LOC,XA		LOC = XA
		SubaW LOC,TXAD		LOC -= TXAD
		DCMPLI LOC,20
		BCC LNE1
		MovlW LOC,20

LNE1		SubaB ADR1,LOC

		MOVE ADR1,SAVMSK,N40

		MovaW YA,SAVMSK
		AddaB YA,LOC
		LDA #0
		JMP CLRBAR

INVUP	MovaW YY,XA
	SubaW YY,WA
	MovaW YA,YY
	AddaW YA,SAVMSK

	LDX #$FF
	MovaW LOC,YY
NXTLGRW	INX
	MovaB LOGCOL,LOC
	SubaW LOC,LL
	BCS NXTLGRW
	STX LOGROW 

	MOVE WA,SAVMSK,SSP

	LDA OFLG
	BEQ WMK

	MovaW TEA,XA
	SubaB TEA,LOGCOL
	AddaB TEA,LL

WMK	MovaW LOC,TEA
	SubaW LOC,WA
	DCMP LOC,SSP
	BCS DTCOL 
	AddaW LOC,SAVMSK
	LDY #0
	LDA #220
	STA (LOC),Y	

DTCOL	LDX #$FF
	MovaW LOC,YY
NXTROW	INX
	MovaB COL,LOC
	SubaW LOC,N40
	BCS NXTROW
	STX ROW 

	TXA
CLRBAR	LDX LL
	CPX #40
	BEQ VC1
	AND #%11111110
VC1	ASL
	ASL
	CLC
	ADC #12
	STA VCNT1
	ADC #4
	CPX #40
	BEQ VCEND
	ADC #4

VCEND	STA VCNT2	

	LDY #0
	LDA (YA),Y
	CLC
	ADC #128
	STA (YA),Y	Cursor on

	MovlB $D302,52	PACTL activates joystick
	MovlB STICK0,%00001111
	MovlB CH,255
GETLP	  LDY CH
	  CPY #255
	  BNE KEYPRESS
	JMP GETLP

	  LDA $284		STRIG0	stick trigger		
	  BEQ skip		if 0, trigger is pressed
*	  LDY #202		????
	  JMP GETLP SETVECT 
	
skip	  LDA STICK0

	  CMP #%00001111
	  BEQ GETLP
	
	TAY
	AND #%00000001
	BNE skip
	LDY #3		 UP
	JMP SETVECT
	
skip	TYA
	AND #%00000010
	BNE skip
	LDY #4		 DOWN
	JMP SETVECT
	
skip	TYA
	AND #%00000100
	BNE skip
	LDY #19		 LEFT
	JMP SETVECT
	

skip	LDY #20		 RIGHT
	JMP SETVECT
	

KEYPRESS	STY KCD
	MovlB CH,255

*	JSR $FCD8	CLICK

	LDY KCD

SETVECT	STY KCD
	CPY #192
	BCC SEEKKCD	
	TYA
	SBC #200
	ASL 
	TAX

	LDA SCTABLE,X
	STA VECTOR
	LDA SCTABLE+1,X
	STA VECTOR+1

PUSHRA	LDA #K0-1:H
	PHA
	LDA #K0-1:L
	PHA
	LDA #0
	STA ESCFLG
	JMP (VECTOR)
K0	JMP LPBG

SEEKKCD	LDX #$FD
loop	INX
	INX
	INX
	LDA KCDTAB,X
	BEQ DETASC 
	CMP KCD
	BNE loop

	LDA KCDTAB+1,X
	STA VECTOR
	LDA KCDTAB+2,X
	STA VECTOR+1
	JMP PUSHRA

DETASC	LDA (KEYDEF),Y
	CMP #NOKEY
	BNE skip
	JMP GETLP

skip	STA CHR

	LDA EFLG
	BEQ CC

	LDX #$FF
loop	INX		English/German
	LDA ENG,X
	BEQ CC
	CMP CHR
	BNE loop
	LDA GER,X	character found:
	STA CHR

CC	LDA ESCFLG
	BMI WRITE
	LDX #$FD
SEEKCH1	INX
	INX
	INX
	LDA EDCHTAB,X
	BEQ WRITE
	CMP CHR
	BNE SEEKCH1

	LDA EDCHTAB+1,X
	STA VECTOR
	LDA EDCHTAB+2,X
	STA VECTOR+1
	JMP PUSHRA

WRITE	LDA INSFLG
	BEQ WR1
	INS

WR1	LDY #0
	STY ESCFLG
	STY ROWCRS
	STY COLCRS
	LDA (SAVMSK),Y
	PHA

	LDA CHR
	CMP #97
	BCC INVTEST
	CMP #123
	BCS INVTEST
	SEC
	SBC CAPSFLG

INVTEST	ORA INVFLG

	STA CHR	

	MovlW LEN,1
	BPUT $30,CHR,LEN

	LDY #0
	LDA (SAVMSK),Y
	STA (XA),Y
	PLA
	STA (SAVMSK),Y

	RIGHT

	JMP LPBG

*
KCDTAB	DFB 3
	DFW UP
	DFB 4
	DFW DOWN
	DFB 19
	DFW LEFT
	DFB 20
	DFW RIGHT
	DFB 166
	DFW WDFORBAC
	DFB 167
	DFW WDFORBAC
	DFB 39
	DFW INV
	DFB 103
	DFW SHFTINV
	DFB 124
	DFW SHFTCAPS
	DFB 60
	DFW CAPS
	DFB 140
	DFW CTLRET
	DFB 188
	DFW CTLCAPS
	DFB 12
	DFW RET
	DFB 97
	DFW SHFTBLK
	DFB 0
*
CTLRET	SubaB XA,LOGCOL
	RTS
*
RET	CTLRET
	AddaB XA,LL
	RTS

*
INV	LDA #0
	STA INVFLG
	RTS

*
SHFTINV	LDA #128
	STA INVFLG
	RTS


*
CAPS	LDA #0
	STA CAPSFLG
	RTS

*
SHFTCAPS	LDA #32
	STA CAPSFLG
	RTS

*
CTLCAPS	LDA #96
	STA CAPSFLG
	RTS

*
WDFORBAC	LDY KCD
	STY LOC	

	MovaW ADR1,XA
	SublB ADR1,2

NXTPOS	LDA #167
	CMP LOC
	BEQ FORWARD

	DecW ADR1
	LEFT
	DCMP ADR1,TXAD
	BNE TEST
	BEQ FOUND

FORWARD	IncW ADR1
	RIGHT
	DCMP ADR1,MXA
	BEQ FOUND

TEST	LDY #1		
	LDA (ADR1),Y
	AND #%01111111
	BNE NXTPOS

	INY
	LDA (ADR1),Y
	AND #%01111111
	BNE FOUND

	LDY #0
	LDA (ADR1),Y
	AND #%01111111
	BNE FOUND
	BEQ NXTPOS

FOUND	RTS

*
SCTABLE	DFW O,0,P,U,SCTLRET,I,SCTLMIN
	DFW SCTLEQU,0,0,0,0,0,0,0,0
	DFW SCTL4,0,SCTL3,SCTL6
	DFW SCTLESC,SCTL5,SCTL2,SCTL1
	DFW SCTLCOM,SCTLBLK,SCTLPER
	DFW N,0,M,SCTLSTRK,SCTLINV,R,E
	DFW E,Y,SCTLTAB,TZ,W,Q,SCTL9,0
	DFW SCTL0,SCTL7,SCTLDBS
	DFW SCTL8,SCTLCLR,SCTLINS
	DFW F,H,D,0,SCTLCAP,G,S

O	LDA #1
	EOR OFLG
	STA OFLG
	RTS

*
SCTLRET	LDA TXAD
	STA XA
	STA WA
	LDA TXAD+1
	STA XA+1
	STA WA+1
	RTS


I	LDA #1
	EOR INSFLG
	STA INSFLG
	RTS

SCTL4	RTS



SCTL3	RTS

SCTL6	MovlB BANK,$63
	RTS

SCTLESC	RTS

SCTL5	MovlB BANK,$6F
	RTS

SCTL7	MovlB BANK,$67
	RTS

SCTL1	RTS

SCTLSTRK	LDA LOGCOL
	BEQ SCS1
	M
SCS1	COB
	RTS

XASV	DFW 0
SCTLINV	MovaW XASV,XA
	RTS

SCTLCAP	SubaB YA,LOGCOL

	LDY #38
	MovlB DIF,$FF
loop	INY
	INC DIF
	LDA (YA),Y
	BNE loop

	MovaW ADR1,YA
	AddaB ADR1,DIF
	MovaW LEN,LL
	MovaW ADR2,YA

	MovaW LOC,ADR2

	MOVER
	MovaW ADR2,LOC

	LDA #0
	LDY LL
	LDX DIF

loop	BEQ SCP2
	DEY
	STA (ADR2),Y
	DEX
	JMP loop

SCP2	GET
	RTS

*
N	MovlB OFLG,0
N1	MovaW TEA,MXA
	RTS
*
SCTLPER	CTLRET
COB	AddaB XA,LL
	DCMP XA,TEA
	BCC CO2
	SubaB XA,LL 
	RTS

CO2	LDY #0
	LDA (XA),Y
	BNE CO1

	CTLDBS
	JMP COB

CO1	DecW XA
	LDY #0
	LDA (XA),Y
	PHP
	IncW XA
	PLP
	BEQ COB

	MovlB KCD,166
	WDFORBAC
	RTS
*
SCTLCLR	MovaW XA,XASV
	RTS
*
R	WNDW
	PRINTSN "REALINE? Y/N"
	GET
	CMP 'Y
	BNE R6	

	MovaW LOC,XA
	CTLRET
	TEUP

loop	AddaB XA,LL
	DCMP XA,TEA
	BCC loop

	MovaW SV,XA

R1	SubaB SV,LL
	MovaW XA,SV
	DCMP LOC,XA
	BCC R2
	MovaW XA,LOC
R6	RTS

R2	DecW XA
	LDY #0
	LDA (XA),Y
	BEQ SPACE

	CMP #223
	BEQ HYPH

	IncW XA
	IncW TEA	
	INS
	DecW XA
	JMP R1

SPACE	CTLDBS
	JMP R2

HYPH	CTLDBS
	JMP R1

*
E	LDA #1
	EOR EFLG
	STA EFLG
	RTS

SCTLTAB	RTS


SCTL9	MovaW INSBGAD,XA
	RTS

SCTL0	DCMP XA,INSBGAD
	BCC SC0END

	MovaW LEN,XA
	IncW LEN
	SubaW LEN,INSBGAD
	DCMPLI LEN,CBLKMXL
	BCC SC01

	MovlW LEN,CBLKMXL
SC01	MovaW CBLKLEN,LEN
	MovaW ADR1,INSBGAD
	MovlW ADR2,CBLKBUF

	MOVER
SC0END	RTS





SCTL2	LDA #1
	EOR DBSFLG
	STA DBSFLG
	RTS

SCTLDBS	INSLN
	MOVE DLLNBF,XA,LL
	RTS


SCTL8	LDA LL
	CMP #80
	BNE SC81

	MovlB LL,40
	RTS

SC81	MovlB LL,80
	RTS

Q	CLOSE $20
	CLOSE $30
	GR 0
	CLRCSR
	MovaW BRKKY,BKYSV
	MovaB PORTB,PTBSV
	LDX STKSV
	TXS
	RTS



SCTLINS	MovaW LEN,SAVMSK
	AddaW LEN,SSP
	SubaW LEN,YA
	DCMP LEN,CBLKLEN
	BCC DISPLAY 

	MovaW LEN,CBLKLEN
DISPLAY	MovlW ADR1,CBLKBUF
	MovaW ADR2,YA
	MOVER
	GET
	CMP #EOL
	BNE SCINSEND

	MovlW ADR1,CBLKBUF
	MovaW ADR2,XA
	MOVER
SCINSEND	RTS
*
F	LDA FFLG
	EOR #128
	STA FFLG
	CLS
	RTS

H	MovlB BANK,$6B
	RTS

SCTLCOM	LDY #0
	LDA #221
	STA (XA),Y
	IncW XA
	RTS
*
RW	DFW 0
MGN	DFB 0

G	CTLRET
	GR 22
	MovlB ATACHR,1
	PLOT 0,0
	DRTO 0,95
	DRTO 136,95
	DRTO 136,0
	DRTO 0,0	
	PLOT 0,0


	LDY #0
	STY RW
	STY RW+1

DO1	STY CNT

DO2	LDA (XA),Y
	BEQ ENDPL
	CMP #221
	BNE PLOTP
	INC RW
	BNE ENDPL

PLOTP	CLC
	LDA #8
	ADC RW
	ADC RW
	CMP #159
	BCS END
	STA COLCRS

	SEC
	LDA #87
	SBC CNT
	SBC MGN
	STA ROWCRS

	LDX #$60
	LDA ATACHR
	CIOV

	LDY #0
ENDPL	IncW XA
	DCMP XA,TEA
	BCS END	

	INC CNT
	LDA CNT
	CMP LL
	BNE DO2

	INC RW
	LDA RW
	CLC
	ADC DBSFLG
	STA RW
	BNE DO1

END	GET

GND	JMP BKTP	
*
WL	DFW 0

WNDW	MovaW ADR1,SAVMSK
	MovlW LEN,120
	CLEAR
	MovlW VCNT1,$1A00
	POS 0,0
	RTS
*
S	WNDW
	MovlW ADR1,WORD

	MovaW ADR2,SAVMSK
	AddlB ADR2,40
	MovaW LOC,ADR2
	MovaW LEN,WL
	MOVER

	PRINTSN "SEARCH"
	INPUT $50,WORD

	LDY #$FF
loop	INY
	LDA WORD,Y
	CMP #EOL
	BEQ S2

	LDA (LOC),Y
	STA WORD,Y
	JMP loop

S2	STY WL

W	IncW XA
	DCMP XA,TEA
	BCC W1

	JMP RSTXA

W1	LDY #0
loop	LDA WORD,Y
	CMP #EOL
	BEQ WND

	CMP (XA),Y
	BNE W

	INY
	BNE loop
WND	RTS
*
ABV	EQU $543

SCTLBLK	RTS

SHFTBLK	LDY #0
loop	DecW XA
	LDA (XA),Y
	BNE loop

	IncW XA
	LDA (XA),Y
	BNE skip
	RTS

skip	MovlB ABV,143

loop	LDA (XA),Y
	PHP
	INY
	STA ABV,Y
	PLP
	BNE loop

	MovlB PORTB,$6F
	MovlW LOC,$3999

A3	IncW LOC
	LDA LOC+1
	BMI AEND

	LDY #$FF
loop	INY
	LDA ABV,Y
	BEQ skip

	CMP (LOC),Y
	BNE A3	
	BEQ loop

skip	CMP (LOC),Y
	BNE A3

	LDX #0
loop	INY
	LDA (LOC),Y
	CMP #143
	BEQ skip

	STA ABV,X
	INX
	BNE loop

skip	MovaB PORTB,BANK
	LDY #0
	STX CNT
	LDX #0

loop	LDA ABV,X
	STA (XA),Y 
	IncW XA
	INX
	DEC CNT
	BNE loop

AEND	RTS
*
P	MovaW TEA,XA
	RTS

SCTLMIN	SubaW XA,SSP
	SubaW WA,SSP
	RTS

SCTLEQU	AddaW WA,SSP
	AddaW XA,SSP
	RTS

U	LDY #0		Underline
	LDA (XA),Y
	CLC
	ADC #128
	STA (XA),Y
	RIGHT
	RTS

Y	LDY #0		Upper case to lower case
	LDA (XA),Y
	TAX
	AND #%01111111
	CMP #33
	BCC YEND
	CMP #59
	BCS YEND
	TXA
	ADC #64
	STA (XA),Y		
YEND	RIGHT
	RTS
*
EDCHTAB	DFB 28
	DFW UP
	DFB 29
	DFW DOWN
	DFB 30
	DFW LEFT
	DFB 31
	DFW RIGHT
	DFB 126
	DFW DBS
	DFB 127
	DFW TAB
	DFB 254
	DFW CTLDBS
	DFB 255
	DFW INS
	DFB 156
	DFW DELLN
	DFB 157
	DFW INSLN
	DFB 27
	DFW ESC
	DFB 158
	DFW CTLTAB
	DFB 159
	DFW SHFTTAB
	DFB 125
	DFW CTLCLR

	DFB 0
*
CTLCLR	MovaW LEN,SSP
	AddaW LEN,SAVMSK
	SubaW LEN,YA
	MovaW ADR1,YA

	MovaW DIF,TEA
	SubaW DIF,XA
	DCMP LEN,DIF
	BCC CCL1

	MovaW LEN,DIF

CCL1	CLEAR
	GET
	CMP #EOL
	BNE CCLND
	MovaW LEN,TEA
	SubaW LEN,XA
	MovaW ADR1,XA
	CLEAR
CCLND	RTS
*
CTLTAB	LDA #0
	BEQ SETTAB
*
SHFTTAB	LDA 'X
SETTAB	LDX LOGCOL
	STA TABMAP,X
	RTS

*
TAB	LDX LOGCOL

loop	INX
	CPX LL
	BNE skip
	LDX #0

skip	IncW XA
	LDA TABMAP,X
	CMP 'X'
	BNE loop
	RTS
*
ESC	LDA #128
	STA ESCFLG
	RTS
*
UP	SublB XA,40
	DCMP XA,TXAD
	BCS skip
	AddlB XA,40
	
skip	RTS
	
	

DOWN	AddlB XA,40
	RTS

LEFT	MovaW TEMP,XA
loop	SublB TEMP,40
	DCMP TXAD,TEMP
	BEQ LFTND
	BCS skip
	
	BCC loop
skip	DecW XA
LFTND	RTS

RIGHT	MovaW TEMP,XA
	IncW TEMP
loop	SublB TEMP,40
	DCMP TXAD,TEMP
	BEQ LFTND
	BCS skip
	
	BCC loop

skip	IncW XA








* OUT L
	RTS

	ORG $2200,$1F00
* OUT

DBS	LEFT
	DCMP XA,TXAD
	BCC DBSND

	LDA #0
	TAY
	STA (XA),Y
	LDA INSFLG
	BEQ DBSND
	CTLDBS	
DBSND	RTS
*
M	LDA LL
	SEC
	SBC LOGCOL
	STA DIF	
	INSCHS	

	LDY #0
	MovaW LOC,XA
	DecW LOC
	LDA (LOC),Y
	BEQ MG1
	LDA #223
	STA (XA),Y
MG1	AddaB XA,DIF
	RTS	
*

INSLN	MovaB DIF,LL
	CTLRET
INSCHS	MovaW ADR1,TEA
	SubaB ADR1,DIF
	LDY DIF
	DEY
loop	LDA (ADR1),Y
	BNE IERR
	DEY
	BPL loop

	MovaW ADR2,XA
	AddaB ADR2,DIF
	DecW ADR2
	MovaW LEN,TEA

	SubaW LEN,ADR2
	MovaW ADR1,XA
	DecW ADR1
	MMOVER

	MovaW ADR1,XA
	DecW ADR1
	CLRCHS
	RTS

IERR	JSR $F556
	LPBG
*
DELLN	RET
	DCMP TEA,XA
	PHP
	SubaB XA,LL
	PLP
	BCC IERR

	LDY LL
loop	DEY
	BMI DLN2

	LDA (XA),Y
	BEQ loop
	
	MOVE XA,DLLNBF,LL

DLN2	MovaW DIF,LL

DELCHS	MovaW ADR1,XA
	AddaB ADR1,DIF
	MovaW LEN,TEA
	SubaW LEN,ADR1
	MovaW ADR2,XA
	MOVER

	MovaW ADR1,TEA
	DecW ADR1
	SubaB ADR1,DIF
	CLRCHS
	RTS
*
INS	MovlB DIF,1
	INSCHS
	RTS
*
CTLDBS	MovlB DIF,1
	DELCHS
	RTS
*
MOVER	LDY #0
	LDX LEN+1
	BEQ MVREMI

MVBLK	LDA (ADR1),Y	   move block
	STA (ADR2),Y
	INY
	BNE MVBLK

	INC ADR1+1
	INC ADR2+1
	DEX
	BNE MVBLK

MVREMI	LDA LEN
	BEQ MVND

loop	LDA (ADR1),Y	move remainder
	STA (ADR2),Y
	INY
	CPY LEN
	BNE loop
MVND	RTS
*
MMOVER	AddaW ADR1,LEN
	AddaW ADR2,LEN

	LDX LEN+1
	INX
	LDY #$FF

MMVBLK	DEC ADR1+1
	DEC ADR2+1
	DEX
	BEQ MMVREM
loop	LDA (ADR1),Y
	STA (ADR2),Y
	DEY
	BNE loop

	LDA (ADR1),Y
	STA (ADR2),Y
	DEY
	BMI MMVBLK

MMVREM	LDX #0
loop	CPX LEN
	BEQ MMVEND	break if EQ
	LDA (ADR1),Y
	STA (ADR2),Y
	DEY
	INX
	BNE loop
MMVEND	RTS

*
CLRCHS	LDY DIF
	LDA #0
loop	STA (ADR1),Y
	DEY
	BNE loop
	RTS
*
LNPNT	EQU ADR1
PBFPNT	EQU LEN
ULFLG	EQU ADR2
ACTLL	EQU ADR2+1

T	WNDW
	PRINTSN "TYPE? Y/N"
	GET
	CMP 'Y
	BEQ T1	
	RTS

T1	MovaW BRKKY,BKYSV
	CLOSE $40
	OPEN $40,8,0,"P:"
	CTLRET
	TEUP

	LDY #0
	STY LNPNT
	STY PBFPNT

	LDA #27
	PUTPBUF
	LDA #23
	PUTPBUF
	LPRINT

TYPLOOP	MOVE XA,SAVMSK,LL

	LDY #0
	STY LNPNT
	STY PBFPNT
	STY ULFLG

	LDY LL

DETACTLL	DEY
	BMI DTC2
	LDA (XA),Y
	BEQ DETACTLL	

DTC2	INY
	STY ACTLL

NXTPCH	LDY LNPNT	  DO
	CPY ACTLL
	BEQ DETLEN
	LDA (XA),Y	
	INC LNPNT

	LDX #0

	CMP #223
	BNE ATLP
	LDA '-
	BNE UNLN

ATLP	CMP #32
	BCC TYPE2 
	INX
	SBC #32	
	JMP ATLP

TYPE2	ADC ASCTAB,X	
UNLN	BMI UNDRLN

	LDX ULFLG
	BPL PTB

	STA ULFLG
	ULOFF
	LDA ULFLG
	BPL PTB

UNDRLN	LDX ULFLG
	BMI PTB

	STA ULFLG
	ULON
	LDA ULFLG

PTB	PUTPBUF	
	JMP NXTPCH	  LOOP

DETLEN	LDX DBSFLG
PUTEOL	LDA #155
	PUTPBUF
	DEX
	BEQ PUTEOL
	AddaB XA,LL

	LPRINT

	DCMP XA,TEA
	BCS TYPEND	
	JMP TYPLOOP	LOOP

TYPEND	RTS

PUTPBUF	LDY PBFPNT
	CMP #157
	BNE PTBF1
	LDA #155
PTBF1	STA PRBF,Y
	INC PBFPNT
	RTS

LPRINT	LDA #0
	STA PBFPNT+1
	BPUT $40,PRBF,PBFPNT
	BPL LPR1

	LPBG

LPR1	RTS

ULON	LDA #27
	PUTPBUF
	LDA #25
	PUTPBUF
	RTS

ULOFF	LDA #27
	PUTPBUF
	LDA #26
	PUTPBUF
	RTS

************************************************

TZ	WNDW
	PRINTSN "TYPE? Y/N"
	GET
	CMP 'Y
	BEQ T1Z	
	RTS

T1Z	MovaW BRKKY,BKYSV
	CLOSE $40
	OPEN $40,8,0,"P:"
	CTLRET
	TEUP

	LDY #0
	STY LNPNT
	STY PBFPNT

	

TYPLOOPZ	MOVE XA,SAVMSK,LL

	LDY #0
	STY LNPNT
	STY PBFPNT
	STY ULFLG
	
	LDY LL

DETACTLZ	DEY
	BMI DTC2Z
	LDA (XA),Y
	BEQ DETACTLZ	

DTC2Z	INY
	STY ACTLL

NXTPCHZ	LDY LNPNT	  DO
	CPY ACTLL
	BEQ DETLENZ
	LDA (XA),Y	
	INC LNPNT

	LDX #0

	CMP #223		inverted right arrow
	BNE ATLPZ
	LDA '-
	BNE PTBZ

ATLPZ	CMP #32
	BCC TYPE2Z 
	INX
	SBC #32	
	JMP ATLPZ

TYPE2Z	ADC ASCTAB,X	


PTBZ	PUTPBUFZ	
	JMP NXTPCHZ	  LOOP

DETLENZ	LDX DBSFLG
PUTEOLZ	LDA #157
	PUTPBUFZ
	DEX
	BEQ PUTEOLZ
	AddaB XA,LL

	LPRINT

	DCMP XA,TEA
	BCS TYPENDZ	
	JMP TYPLOOPZ	LOOP

TYPENDZ	RTS

PUTPBUFZ	LDY PBFPNT
	CMP #157		inverted down arrow
	BNE PTBF1Z
	LDA #10
	BNE PTBF2Z
PTBF1Z	AND #%01111111	inverted chars normal
	CMP #27
	BCS PTBF2Z
	TAX
	LDA ANSITAB,X
	
PTBF2Z	CMP #123		 atari'A'umlaut
	BNE PTBF3Z
	LDA #196		 ansi'A'umlaut
PTBF3Z	STA PRBF,Y
	INC PBFPNT
	RTS


************************************************
ANSITAB	DFB 225,249,209,201,231,244,242,236
	DFB 163,239,252,228,214,250,243,246
	DFB 220,226,251,238,233,232,241,234
	DFB 229,224,197
ASCTAB	DFB 32,64,0,96,160,192,128,224
INSBGAD	DFW 0
CBLKLEN	DFW 0
CBLKMXL	EQU $960
CBLKBUF	EQU $7C00
WORD	EQU $7B00
PRBF	EQU $7B10
DLLNBF	DFW $7CA0

COLPF1	EQU $D017
WSYNC	EQU $D40A
VCOUNT	EQU $D40B
NMIEN	EQU $D40E
VDSLST	EQU $200
SDLSTL	EQU $230

VORBERT	SublB SAVMSK,40
	MovaW SCRENE,SAVMSK
	MovlW SDLSTL,NEWDLST

	MovlB NMIEN,$40
	MovlW VDSLST,DLIPGM
	MovlB NMIEN,$C0	
	RTS

DLIPGM	PHA
	LDA VCOUNT
	STA WSYNC
	CMP VCNT1
	BCS skip
	MovlW COLPF1,$C009
	BNE ENDI


skip	CMP VCNT2
	BCS skip
	MovlW COLPF1,$120B
	BNE ENDI

skip	MovlW COLPF1,$C009

ENDI	PLA
	RTI


NEWDLST	DFB $70,$70,$F0
	DFB 66+$80
SCRENE	DFW 0
	DFB $82,$82,$82,$82,$82
	DFB $82,$82,$82,$82,$82
	DFB $82,$82,$82,$82,$82
	DFB $82,$82,$82,$82,$82
	DFB $82,$82,$82,$F0,$82
	DFB 65
	DFW NEWDLST

CLRCSR	MovlB 709,9
	MovlB 710,192
	MovlB 712,226
	MovlB 729,20
	MovlB 730,3
	RTS
*
DEVS	ASC "S:"

GRAPHR	PHA
	CLOSE $60
	PLA
	STA ICAX2,X
	AND #$F0
	EOR #$10
	ORA #$0C
	STA ICAX1,X
	MovlBX ICCOM,COPEN
	MovlWX ICBAL,DEVS
	CIOV
	RTS
*
GET	LDX #$20
	MovlBX ICCOM,CGBIN
	LDA #0
	STA ICBLL,X
	STA ICBLH,X
	CIOV
	RTS
*
CLEAR	LDA #0
	TAY
	STA (ADR1),Y
	MovaW ADR2,ADR1
	IncW ADR2
	DecW LEN
	MOVER
	RTS

*
TEUP	LDY #0
loop	DecW TEA
	LDA (TEA),Y
	BEQ loop
	
	IncW TEA
	RTS
*
PLOTR	LDX #$60
	MovlBX ICCOM,CPBIN
	LDA #0
	STA ICBLL,X
	STA ICBLH,X
	LDA ATACHR
	CIOV
	RTS
*
DRTOR	LDX #$60
	MovlBX ICCOM,CDRAW
	MovlBX ICAX1,CCLSE
	MovlBX ICAX2,0
	CIOV
	RTS
*
PRINTR	MovlBX ICCOM,CPTXT
	MovlWX ICBLL,120
	CIOV
	RTS
*
MENUE	ASC /L/,"OAD    "  
	DFB 4,CGBIN
	DFW SAVLOD

	ASC /S/,"AVE    "
	DFB 8,CPBIN
	DFW SAVLOD

	ASC /D/,"IR     "
	DFB 6,0
	DFW DIR

	ASC /R/,"ENAME  "
	DFB 0,$20
	DFW RENAME

	ASC /E/,"RASE   "
	DFB 0,$21
	DFW ERASE

	ASC /P/,"ROT.   "
	DFB 0,$23
	DFW PROT

	ASC /U/,"NPROT. "
	DFB 0,$24
	DFW UNPROT

	DFB 0

MENITL	EQU 8
NUMATR	EQU 4

D	GR 0
	CLOSE $50
	OPEN $50,12,0,"E:"
	CLRCSR
	MovlB PRBF,'*'
	MovlB PRBF+1,155
	MovlW ADR1,MENUE+24	    MENUE + 2*(MENITL+NUMATR)
	DOCMND		won't return (pla, pla)
**	
NXTITM	LDY #0

	LDA (ADR1),Y
	BEQ PICK

	PRMNIT
	AddlB ADR1,MENITL+NUMATR
	JMP NXTITM 	

PICK	PRINTSN ""
	GET
	STA CHR
	MovlW ADR1,MENUE

FINDIT	LDY #0
	LDA (ADR1),Y
	AND #%01111111
	BEQ PICK
	CMP CHR
	BEQ ITFND

	AddlB ADR1,MENITL+NUMATR
	JMP FINDIT

ITFND	PRMNIT			print item found
	INPUT $50,PRBF		input from keyboard
DOCMND	CLOSE $40
	adjstDX
	LDX #$40
	LDY #MENITL
	LDA (ADR1),Y
	STA ICAX1,X
	MovlBX ICAX2,0
	MovlBX ICCOM,COPEN
	MovlWX ICBAL,PRBF
	CIOV


	
	LDY #MENITL+1
	LDA (ADR1),Y
	STA ICCOM,X
	CMP #CPBIN	SAVE?
	BNE skip
	
	LDY #0
loop	DecW TEA		marker to end of text
	LDA (TEA),Y
	BEQ loop
	IncW TEA
	DCMP TXAD,XA
	BEQ skip
	
	PRINTSN @Cursor is not at text begin. Save anywayY/N?@
	GET
	CMP 'Y'
	BEQ skip
	BKTP
	
skip	LDY #MENITL+2
	LDA (ADR1),Y
	STA VECTOR 	
	INY
	LDA (ADR1),Y
	STA VECTOR+1

	LDA #M0-1:H
	PHA
	LDA #M0-1:L
	PHA
	JMP (VECTOR)

M0	CIOV	
	MovaB PORTB,BANK
	CLOSE $40
	BKTP
*
SAVLOD	LDX #$40
	LDA XA
	STA ICBAL,X
	LDA XA+1
	STA ICBAH,X

	MovaW LEN,TEA
	SubaW LEN,XA
	LDA LEN
	STA ICBLL,X
	LDA LEN+1
	STA ICBLH,X
	RTS

RENAME	RTS
ERASE	RTS
PROT	RTS
UNPROT	RTS
*
DIRLN	INPUT $40,PRBF
	BMI skip
	PRINT $50,PRBF
	RTS
skip	PRINTSN ""
	MovlW ADR1,MENUE
	PLA
	PLA
	JMP NXTITM
*
DIR	CLS
loop	DIRLN
	DEC ROWCRS
	MovlB COLCRS,19
	DIRLN
	JMP loop
*
PRMNIT	LDX #$50
	MovlBX ICCOM,CPBIN
	LDA #MENITL
	STA ICBLL,X
	LDA #0
	STA ICBLH,X
	LDA ADR1
	STA ICBAL,X
	LDA ADR1+1
	STA ICBAH,X
	CIOV
	BMI DOSERR
	RTS

DOSERR	STY CHR
	MovlW LEN,1
	CLS
	BPUT $50,CHR,LEN
	GET
	BKTP

	DFB 0

***************************************
*** Routines from SGEN ****************

*** If ":" not found, "D:" is assumed ***
*** If found, could be D:,F:,P:,S:etc ***

adjstDX	LDA ':'
	CMP PRBF+1
	BEQ skip
	CMP PRBF+2
	BEQ skip

	LDY #30	ample length
	LDX #32

loop	LDA PRBF,Y		'X'
	  STA PRBF,X	
	  DEX
	  DEY
	  BPL loop

	LDA 'D'
	STA PRBF
	LDA ':'
	STA PRBF+1

skip	LDY #1
loop	INY	
	LDA PRBF,Y
	CMP '.'
	BEQ skip
	CMP #155
	BNE loop
	
	LDA '.'
	STA PRBF,Y
	INY
	LDA 'X'
	STA PRBF,Y
	INY
	LDA #155
	STA PRBF,Y	
skip	RTS	

#
PHB	PHA
	CMP #10
	BCC PHB2
	PT \$\
	STX XSAV
	PLA
PHB1	PHA
	LSR
	LSR
	LSR
	LSR
	BEQ PHB2
	TAX
	LDA HXTB,X
	PTCH
PHB2	PLA
	AND #%00001111
	TAX
	LDA HXTB,X
	PTCH
	LDX XSAV
	RTS
	
HXTB	ASC "0123456789ABCDEF"
XSAV	DFB 0

************************************

BLK	LDA ' '
PTCH	STX TMP
	LDX LPTR
	STA LN,X
	INC LPTR

	LDA LPTR
	CMP LPTRMX
	BEQ PCHER

	INC CHC
	LDX TMP
	DEC A1
	BEQ PTCND

	MovaB A1,SECSZ

PTCND	RTS
#
* RUNEMUL "C:\Program Files (x86)\Atari800WinPLus\Atari800Win.exe"
	RUNEMUL "C:\Programs Stand Alone\Altirra-4.21\Altirra64.exe"	;DAW
*	RUNEMUL "C:\Programme non install\Altirra-4.40\Altirra64.exe"	;Acustica
	ADDTOIMG MEM.SAV
	ADDTOIMG HELP.X
	ADDTOIMG TAIABR.X
	ADDTOIMG TBHELP.TX
	VERIFY
	CPFL TEMP.SYS
	OUT X		XASM.LAB
*	OUT LM
*	OUT LMT
	OUT T		SOURCGEN symbol table
EOL     EQU $9B

ICCOM	= $342
ICBAL	EQU $344
ICBAH	EQU $345
ICBLL	EQU $348
ICBLH	EQU $349
ICAX1	EQU $34A
ICAX2	EQU $34B

CIOV	EQU $E456

COPEN	EQU 3
CCLSE	EQU 12
CGTXT	EQU 5
CPTXT	EQU 9
CGBIN	EQU 7
CPBIN	EQU 11
CDRAW	EQU $11


ATACHR	EQU $2FB
ROWCRS	EPZ $54	
COLCRS	EPZ $55
STICK0	EQU $0278
STRIG0	EQU $284

	INCLUDE if_while_macros.src
	INCLUDE Macros.SRC

GR	MACRO S
	LDA #S
	GRAPHR
	MEND

POS	MACRO X,Y
	MovlW COLCRS,X
	LDA #0
	STA COLCRS+1
	MovlB ROWCRS,Y
	MEND

PLOT	MACRO X,Y
	POS X,Y
	PLOTR
	MEND

DRTO	MACRO X,Y
	POS X,Y
	DRTOR
	MEND

OPEN	MACRO K,AX1,AX2,FI
	JMP OP1@
F@	ASC FI
	DFB EOL
OP1@	LDX #K
	MovlBX ICAX1,AX1
	MovlBX ICAX2,AX2
	MovlBX ICCOM,COPEN
	MovlWX ICBAL,F@
	CIOV
	MEND

CLOSE	MACRO N
	LDX #N
	MovlBX ICCOM,CCLSE
	CIOV
	MEND

PRINT	MACRO N,LAB
	LDX #N
	MovlWX ICBAL,LAB
	PRINTR
	MEND

PRINTSN	MACRO STRI
	JMP P2@
P1@	ASC STRI
	DFB EOL
P2@	PRINT 0,P1@
	MEND

INPUT	MACRO N,LAB
	LDX #N
	MovlBX ICCOM,CGTXT
	MovlWX ICBAL,LAB
	MovlWX ICBLL,127
	CIOV
	MEND

BPUT	MACRO K,BUF,L
	LDX #K
	MovlBX ICCOM,CPBIN
	LDA L
	STA ICBLL,X
	LDA L+1
	STA ICBLH,X
	MovlWX ICBAL,BUF
	CIOV
	MEND

MOVE	MACRO OA,A2,L
	MovaW ADR1,OA
	MovaW ADR2,A2
	MovaW LEN,L
	MOVER
	MEND
	
MMOVE	MACRO OA,A2,L
	MovaW ADR1,OA
	MovaW ADR2,A2
	MovaW LEN,L
	MMOVER
	MEND	
****** End of macros ************
*
WARMST	EPZ 8
BOOT 	EPZ 9
DOSVEC	EPZ $0A
DOSINI	EPZ $0C
LMARGN	EPZ 82
SAVMSC	EPZ 88
KEYDEF	EPZ 121
RAMTOP	EPZ $6A
COLDST	EQU $244
CH	EQU 764 keycode of last pressed key
BRKKY	EQU 566
INVFLG	EQU 694
SHFLOK	EQU 702
NOCLIK	EQU 731
CRSINH	EQU 752
CHBAS	EQU 756
PORTB	EQU $D301
SKCTL	EQU $D20E Disable the POKEY key click directly
NOKEY	EPZ 208


*
ADR1	EPZ $80 
ADR2	EPZ $82
LEN	EPZ $84
TMP	EPZ $86

MOUSEMD	EPZ $88
LASTTRG	EPZ $89

LOC	EPZ $E0
YA	EPZ $E2
SV	EPZ $E4
XA	EPZ $E6	cursor position in text buffer
WA	EPZ $E8  window address (section of text buffer on screen)

YY	EPZ $EE
DIF	EPZ $F0
CHR	EPZ $F1
TEA	EPZ $F2	Text end address ('pointer')
CNT	EPZ $F4
PBPTR	EPZ $F6	current position in cPRBF

LNPNT	EPZ $F8
PBFPNT	EPZ $FA
ULFLG	EPZ $FC
ACTLL	EPZ $FD


*

CLS	EQU $F420

	ORG $2E0
	DFW JMPBEG

*** code seg 2200 to 2AF9 ***

cTXAD	EQU $4000	text buffer address
cMXA	EQU $7BFF	alligns cMXA with end of logical line, exactly 16*960
cTXBUFSZ EQU cMXA-cTXAD+1
*	80 bytes beyond cMXA are needed for INSLN
cSAVBF	EQU $7BFF+80
*			$400-80 = free bytes
cWORD	EQU $8000	$7B00+$500
cPRBF	EQU $8010	print buffer
cCBLKBUF	EQU $8100	copy-block buffer cSSP bytes

cSSP	EQU 960		screen size (SSP also exists)

	ORG $8100+960 to 92EA

JMPBEG	JMP BEGIN

DLLNBF	DFW $81A0	$7CA0+$500	max 80


SSP	DFW 960		screen space
PRVXA	DFW $4000	default: text buffer begin.
VECTOR	DFW 0
KCD	DFB 0
ESCFLG	DFB 0
BANK	DFB $FF
*** status line
STATLN	DFB 1		show bank
BANKCH	ASC $A$
	DFB 1		show page
PAGECH	ASC $A$
	DFB 1		show pointer pos
TEACH	ASC $A$
DBSFLG	ASC % 2%
EFLG	ASC % D%
INSFLG	ASC % I%
OFLG	ASC % O%
CAPSFLG	ASC % C%
INVFG	ASC % U%
SCTL7FG	ASC % 7%

C2FLG	ASC % 2%
C3FLG	ASC % 3% 
C4FLG	ASC % 4% 
C5FLG	ASC % 5%
C6FLG	ASC % 6%
C7FLG	ASC % 7%
C8FLG	ASC % 8%
C9FLG	ASC % 9%
C0FLG	ASC % 0%
 
 
MSFLAG	DFB 0		mouse flag
EXPTFLG	DFB 0		export flag
LL	DFW 40
ROW	DFB 0
COL	DFB 0
LOGROW	DFB 0
LOGCOL	DFB 0
VCNT1	DFB 0
VCNT2	DFB 0
N40	DFW 40
FFLG	DFB 0
STKSV	DFB 0
PTBSV	DFB 0
BKYSV	DFW 0

TABMAP	ASC ".......X.......X.......X.......X.......X" 
	ASC ".......X.......X.......X.......X.......X"
ENG	DFB 1,21
	ASC "zZyY
	DFB 0
GER	DFB 11,10
	ASC "yYzZ"
CHARBUF	ASC "?"
***********************************
*	B E G I N	*

***********************************

BEGIN	CLD

	MovaW JDOS+1,DOSINI
	MovlW DOSINI,JDOS
	LDX #$FF
	STX WARMST
	INX
	STX COLDST
	INX
	STX BOOT	


	MovaB PTBSV,PORTB

BG1	TSX
	STX STKSV

	MovaW BKYSV,BRKKY
	MovlW BRKKY,BKTP
	
	LDA SKCTL Disable the POKEY key click directly
	and #%11111110  ; clear bit 0
	STA SKCTL	
        
	SCTLRET
	N

BKTP	CLI

	LDA #$80
	PHA

CLSE	PLA
	SEC
	SBC #$10
	BEQ START
	TAX
	PHA
	MovlBX ICCOM,CCLSE
	CIOV
	JMP CLSE

START	GR 0
*	OPEN $30,8,0,"S:"
	OPEN $00,12,0,"E:"
	CLRCSR
	OPEN $20,4,0,"K:"

	VORBERT

	MovlB CHBAS,204	;international character set
	MovlB LMARGN,0


*** Loop begin ***
LPBG	LDX STKSV
	TXS
* limit TEA
	CmplW TEA,cMXA+1
	BCC +
	  MovaW TEA,cMXA+1
	
+	MovlB EXPTFLG,0
* default values for menues	
	STA INVFLG	;uninverted
	MovlB SHFLOK,64	;upper case
*	
	CLOSE $40
	MovaW PRVXA,XA

	MovaB PORTB,BANK
	
	CmplW XA,cTXAD
	BCS skip
	MovlW XA,cTXAD
* show only from text buffer begin
skip	CmplW WA,cTXAD
	BCS LB2
	MovlW WA,cTXAD
* show only to text buffer end
LB2	MovlW ADR1,cMXA
	SubaW ADR1,SSP
	IncW ADR1
	CmpaW ADR1,WA
	BCS TXTEND
	  MovaW WA,ADR1

TXTEND	CmplW XA,cMXA	end of text buffer?
	BCC SCROLUP	no
	  MovlW XA,cMXA	yes
	  MovlW WA,cMXA
	  SubaW WA,SSP
	  IncW WA

SCROLUP	MovaW ADR1,WA
	AddlB ADR1,80
	CmpaW XA,ADR1	

	BCS CHECKWA
	SubaB WA,LL
	JMP SCROLUP

CHECKWA	CmplW WA,cTXAD
	BCS SCROLDN
	MovlW WA,cTXAD

SCROLDN	MovaW ADR2,WA
	AddaW ADR2,SSP
	SublB ADR2,80
	CmpaW XA,ADR2
	BCC +	     
	CmplW XA,cMXA-80	
	BCS +	If less than 2 lines from bottom
	AddaB WA,LL	scroll
	JMP SCROLDN

+	CmpaW TEA,XA

	BCS MOVSCR

	N1
	  
	 
MOVSCR	LDA FFLG
	BEQ INVUP

LNED		MovaW ADR1,XA		ADR1 = XA

		MovaW LOC,XA		LOC = XA
		SublW LOC,cTXAD		LOC -= cTXAD
		CmplW LOC,20
		BCC LNE1
		MovlW LOC,20

LNE1		SubaB ADR1,LOC

		MOVE ADR1,SAVMSC,N40

		MovaW YA,SAVMSC
		AddaB YA,LOC
		LDA #0
		JMP CLRBAR

INVUP	MovaW YY,XA
	SubaW YY,WA
	MovaW YA,YY
	AddaW YA,SAVMSC

	LDX #$FF
	MovaW LOC,YY
NXTLGRW	INX
	MovaB LOGCOL,LOC
	SubaW LOC,LL
	BCS NXTLGRW
	STX LOGROW 

	MOVE WA,SAVMSC,SSP

	LDA OFLG
	BEQ +
* pointer to next line begin
	MovaW TEA,XA
	SubaB TEA,LOGCOL
	AddaB TEA,LL

+	LDA C9FLG		SCTL7FG
	BEQ +	;deactivated- paste-text dropouts on column-2
	  PTRTEOP  ;activated- pointer drops when char on column-39

+	STATchas

	MovaW LOC,TEA
	SubaW LOC,WA
	CmpaW LOC,SSP
	BCS DTCOL 
	AddaW LOC,SAVMSC
	LDY #0
	LDA #220
	STA (LOC),Y	

DTCOL	LDX #$FF
	MovaW LOC,YY
NXTROW	INX
	MovaB COL,LOC
	SubaW LOC,N40
	BCS NXTROW
	STX ROW 

	TXA
CLRBAR	LDX LL
	CPX #40
	BEQ VC1
	AND #%11111110
VC1	ASL
	ASL
	CLC
	ADC #12
	STA VCNT1
	ADC #4
	CPX #40
	BEQ VCEND
	ADC #4

VCEND	STA VCNT2	

	LDY #0
	LDA (YA),Y
	CLC
	ADC #128
	STA (YA),Y	Cursor on

	MovlB $D302,52	PACTL activates joystick
	MovlB STICK0,%00001111
	MovlB CH,255
	
; === Mouse Mode Toggle Setup ===
	LDA #1
	STA MSFLAG      ; MSFLAG = 1 (default)
	LDA #0
	STA MOUSEMD     ; MOUSEMD = 0 (mouse mode off by default)
	STA LASTTRG     ; LASTTRG = 0 (for edge detection)
GETLP  ;Test: comment directly after a label  

testsp	equ 1    ;Test: GETLP skips this line
	LDA #1		assume mouse/joystick input
	STA MSFLAG	MSFLAG = 1 (default)
	LDY CH		load keyboard code (255 = none)
	CPY #255		check if key available
	BEQ +
	  KEYPRESS	branch if key not pressed
	  JMP LPBG
	  
+	LDA STRIG0      ; read left mouse button / fire
	CMP LASTTRG
	BEQ +
	LDA STRIG0
	BNE +      ; button not pressed

; Toggle mouse mode
	LDA MOUSEMD
	EOR #1
	STA MOUSEMD	  
	  
; === Joystick / Fire handling ===
+	LDA STRIG0	read STRIG0 (0 = pressed)
	BEQ +		if pressed -> joystick/mouse
	  LDY #202		pseudo key (special)
	  JMP GETLP	SETVECT



+	LDA STICK0	read joystick state
	  CMP #%00001111	no direction?
	  BEQ GETLP	yes -> poll again
	  
* Mouse delay - X
	LDX #30
DELAY1   LDY #0               inner counter (256 iterations)
DELAY2   DEY
         BNE DELAY2
         DEX
         BNE DELAY1

	PHA		save stick state
	AND #%00000001	test UP
	BNE +		if not UP -> next
	  UP		dispatch
	  
+	PLA		restore stick state
	PHA
	AND #%00000010	test DOWN
	BNE +		if not DOWN -> next
	  DOWN		dispatch

+	PLA		restore stick state
	PHA
	AND #%00000100	test LEFT
	BNE +		if not LEFT -> next
	  LDA COL
	  BEQ +
	  LEFT		dispatch

+	PLA		restore stick state
	AND #%00001000	test RIGHT
	BNE +
	  LDA COL
	  CMP #39
	  BEQ +	
	  RIGHT		dispatch
	
+	JMP LPBG

KEYPRESS	STY KCD		store key code
	MovlB CH,255	clear CH (ack key)
	DEC MSFLAG	MSFLAG = 0 (keyboard input)

*	JSR $FCD8	CLICK

	LDY KCD

SETVECT	STY KCD
	CPY #192
	BCC SEEKKCD	
	TYA
	SBC #200
	ASL 
	TAX

	LDA SCTABLE,X
	STA VECTOR
	LDA SCTABLE+1,X
	STA VECTOR+1

PUSHRA	LDA #>K0-1
	PHA
	LDA #<K0-1
	PHA
	LDA #0
	STA ESCFLG
	JMP (VECTOR)
K0	RTS

SEEKKCD	LDX #$FD
loop	INX
	INX
	INX
	LDA KCDTAB,X
	BEQ DETASC 
	CMP KCD
	BNE loop

	LDA KCDTAB+1,X
	STA VECTOR
	LDA KCDTAB+2,X
	STA VECTOR+1
	PUSHRA
	JMP LPBG

DETASC	LDA (KEYDEF),Y
	CMP #NOKEY
	BNE +
	JMP GETLP

+	STA CHR

	LDA EFLG
	BEQ skip

	LDX #$FF
loop	INX		English/German
	LDA ENG,X
	BEQ skip
	CMP CHR
	BNE loop
	LDA GER,X	character found:
	STA CHR

skip	LDA ESCFLG
	  BMI WRITE
	  
	LDX #$FD
loop	INX
	INX
	INX
	LDA CtlChTab,X
	BEQ WRITE

	CMP CHR
	BNE loop

	LDA CtlChTab+1,X
	STA VECTOR
	LDA CtlChTab+2,X
	STA VECTOR+1
	PUSHRA
	JMP LPBG

WRITE	CmpTeaXA	
	LDA INSFLG
	BEQ .1
	  INS

.1	LDY #0
	STY ESCFLG

	LDA CHR

	CMP #'a'
	BCC INVTEST
	CMP #'z'+1
	BCS INVTEST
	SEC
	SBC CAPSFLG

INVTEST	ORA INVFG
	STA CHR	
	ATAtoSCR		new conversion code!!!
	STA (XA),Y
	RIGHT
	JMP LPBG
	
*
CmpTeaXA	CmpaW TEA,XA
	BNE +
	  FREELINE	;TEA = XA
	  JMP .end

+	BCS .end		;TEA > XA
	LDA SCTL7FG
	BEQ +
	  PTRTEOP	;TEA < XA
	  JMP .end
+	N1
.end	RTS

KCDTAB	DFB 3
	DFW UP		F1-200XL
	DFB 4
	DFW DOWN		F2-1200XL
	
	DFB 19		F3-1200XL
	DFW LEFT
	DFB 20		F4-1200XL
	DFW RIGHT
	
	DFB 166
	DFW WDFORBAC	CTRL- /
	DFB 167
	DFW WDFORBAC	CTRL-INV
	
	DFB 39
	DFW INV		INV
	DFB 103
	DFW SHFTINV	SHIFT-INV free
	
	DFB 124
	DFW SHFTCAPS	SHIFT-CAPS free
	DFB 60
	DFW CAPS		CAPS
	
	DFB 140
	DFW CTLRET	CTRL-RETURN
	DFB 188
	DFW CTLCAPS	CTRL-CAPS free
	
	DFB 12
	DFW RET		Return
	DFB 97
	DFW SHFTBLK
	
	DFB 152
	DFW CTL4
	DFB 154
	DFW CTL3
	DFB 155
	DFW CTL6
	DFB 157
	DFW CTL5
	DFB 158
	DFW CTL2
*DFB 159
*DFW CTL1
	DFB 176
	DFW CTL9
	DFB 178
	DFW CTL0
	DFB 179
	DFW CTL7
	DFB 181
	DFW CTL8
	
	
	DFB 0
	

CTL2	LDA #1
	EOR C2FLG
	STA C2FLG
	RTS
CTL3	LDA #1
	EOR C3FLG
	STA C3FLG
	RTS
CTL4	LDA #1
	EOR C4FLG
	STA C4FLG
	RTS
CTL5	LDA #1
	EOR C5FLG
	STA C5FLG
	RTS
CTL6	LDA #1
	EOR C6FLG
	STA C6FLG
	RTS
CTL7	LDA #1
	EOR C7FLG
	STA C7FLG
	RTS
CTL8	LDA #1
	EOR C8FLG
	STA C8FLG
	RTS
CTL9	LDA #1
	EOR C9FLG
	STA C9FLG
	SubaB TEA,LL
	RTS	
CTL0	LDA #1
	EOR C0FLG
	STA C0FLG
	AddaB TEA,LL
	RTS	
*
CTLRET	SubaB XA,LOGCOL
	RTS
*
RET	LDA INSFLG
	BEQ +
	  NWPARAGR
+	AddaB XA,LL
	PTRTEOP
	CTLRET
	RTS

*
INV	LDA #128
	EOR INVFG
	STA INVFG
	RTS

*
*SHFTINV	RTS


*
CAPS	LDA #32
	EOR CAPSFLG
	STA CAPSFLG
	RTS

*
SHFTCAPS	RTS

*
CTLCAPS	RTS

*
WDFORBAC	LDY KCD
	STY LOC	

	MovaW ADR1,XA
	SublB ADR1,2

NXTPOS	LDA #167
	CMP LOC
	BEQ FORWARD

	DecW ADR1
	LEFT
	CmplW ADR1,cTXAD
	BNE TEST
	BEQ FOUND

FORWARD	IncW ADR1
	RIGHT
	CmplW ADR1,cMXA
	BEQ FOUND

TEST	LDY #1		
	LDA (ADR1),Y
	AND #%01111111
	BNE NXTPOS

	INY
	LDA (ADR1),Y
	AND #%01111111
	BNE FOUND

	LDY #0
	LDA (ADR1),Y
	AND #%01111111
	BNE FOUND
	BEQ NXTPOS

FOUND	RTS

* Starts at Key code 200
SCTABLE	DFW O,0		Pointer to beginning ot next line
	DFW P		Pointer to present line
	DFW U		Underline / remove underlining
	DFW SCTLRET	Text begin
	DFW I		Toggle Insert mode
	DFW SCTLMIN	Page up
	DFW SCTLEQU	Page down
	DFW 0,0,0,0,0,0,0,0	--------------------
	DFW SCTL4,0	Toggle 40/80 character line
	DFW SCTL3	Pointer to end of text
	DFW SCTL6	Return to saved cursor position
	DFW SCTLESC	;(unavailable in emulators)
	DFW SCTL5	Save cursor position
	DFW SCTL2	Double spacing
	DFW SCTL1	Clear text buffer (for this bank)
	DFW SCTLCOM	Insert blank line on print-out
	DFW SCTLSPC	Shift line to check it
	DFW SCTLPER	Cursor to last word in line
	DFW N,0		Pointer to end of text buffer
	DFW M		Margin / hyphenate
	DFW SCTLSTRK	Word wrap  (SCTL-<M>,<.>)
	DFW SCTLINV	;(unavailable in emulators)
	DFW R,0		Realine
	DFW E		English/German keyboard
	DFW YYY		;(unavailable in emulators)
	DFW SCTLTAB	;(unassigned)
	DFW T		Type
	DFW W		Repeat search
	DFW Q		QUIT
	DFW SCTL9,0	Block end
	DFW SCTL0	;(unavailable in emulators)
	DFW SCTL7	Pointer to end of paragraph
	DFW SCTLDBS	Restore deleted line
	DFW SCTL8	Block begin
	DFW SCTLCLR	;(unassigned)
	DFW SCTLINS	Copy block
	DFW F		Line editor
	DFW H		Banks
	DFW D,0		DOS
	DFW SCTLCAP	;(unavailable in emulators)
	DFW G		Graphics
	DFW S		Search
*	DFW A		unavailable

SCTLESC	RTS	(unvailable in emulators)
SCTLINV	RTS	(unvailable in emulators)
YYY	RTS	(unvailable in emulators)
***********************
****** SCTL1 **********
***********************
SCTL1	WNDW
	PRINTSN "ERASE BANK? Y/N"
	CONFIRM
	DLTXBF
	
	JMP BKTP
	
**************************	
*** Erase text buffer ***
**************************
DLTXBF	MovlW TMP,cMXA-$100	erase bottom up
	N
	LDY #0
	STY C2FLG
*	LDX #(cMXA+1-cTXAD):H	;Codegen Error: missing opening parenthisis
*	LDX cMXA:H+1-cTXAD:H	;Codegen Error: illegal operand
*	LDX #cMXA+1-cTXAD:H	;This works, but breaks DISASS, which expects ':L' to follow.
*	LDX #cTXBUFSZ:H		;Works, but breaks DISASS
	LDX #$3C			;#cMXA+1-cTXAD:H
	TYA
loop	DEY			start with cMXA-1
	STA (TMP),Y
	BNE loop
	  DEC TMP+1
	  DEX
	  BNE loop
	SCTLRET
	RTS
	
***********************	
********* O ***********
***********************
O	LDA #1
	EOR OFLG
	STA OFLG
	BEQ +
	  LDA #0
	  STA SCTL7FG
+	RTS
***	
SCTL0	RTS	illegal for emulators

*
SCTLRET	LDA #cTXAD
	STA XA
	STA WA
	LDA #cTXAD:H
	STA XA+1
	STA WA+1
	PTRTEOP
	RTS


I	LDA #1
	EOR INSFLG
	STA INSFLG
	RTS

SCTL7	LDA #1
	EOR SCTL7FG
	STA SCTL7FG
	BEQ +
	LDA #0
	STA OFLG
+	PTRTEOP
	RTS
	
*****************************
* pointer to end of paragraph
*****************************
PTRTEOP	LDA SCTL7FG	C8FLG
	BNE +
	  RTS
+	MovaW TEA,XA
	SubaB TEA,LOGCOL	;pointer to line begin

	LDA #0
	STA OFLG
	LDA C2FLG
	  BNE C7LP2
	  
*** Ctrl-2 on: Test for double space. ***
C7LP1	LDY LL		;40
	LDX #5
	INY		;41
	INY
-	DEY 		;41 40 39 38
	DEX		;4  3  2  1
	BEQ skip
	LDA (TEA),Y	;a e l _
	BNE -		;char found
	  DEY	 	;space found
	  DEX		;0
	  BEQ skip
	  LDA (TEA),Y
	  BNE -		;char found
loop	    AddaB TEA,LL	;2nd space found
	    RTS
skip	AddaB TEA,LL	;no EOL
	JMP C7LP1
	
*** Ctrl-2 off: Test for empty line. ***
C7LP2	LDY LL		;40
-	DEY 		;39
	BMI skip		;whole line empty
	LDA (TEA),Y
	BEQ -
	    CMP #221	;inverse down-arrow
	    BEQ loop
	    AddaB TEA,LL
	    JMP C7LP2
skip	RTS
*********************************
SCTLSTRK	LDX #1
	STX SCTL7FG
	DEX
	STX C2FLG
	PTRTEOP

	LDA LOGCOL
	BEQ +
	  M
+	COB

	PTRTEOP
	RTS
*********************************
##
SCTLSTRK	CTLRET
	AddaB XA,LL
	CmpaW XA,TEA
	BCC +
	SubaB XA,LL

*	PTRTEOP
	DOWN
	RTS
	
+	SubaB XA,LL
	LDA LOGCOL
	BEQ +
	  M
+	COB

	RTS
##
******************************
XASV	DFW 0
SCTL5	MovaW XASV,XA
	RTS

SCTL6	MovaW XA,XASV
SCTLTAB	RTS


SCTLSPC	MovaW TMP,SCREEN
	AddlB SCREEN,10
	GET
	MovaW SCREEN,TMP
	RTS

##
******************************************
SCTLSPC	SubaB YA,LOGCOL

	LDY #38
	MovlB DIF,$FF
-	INY
	INC DIF
	LDA (YA),Y
	BNE -

	MovaW ADR1,YA
	AddaB ADR1,DIF
	MovaW LEN,LL
	MovaW ADR2,YA

	MovaW LOC,ADR2

	MOVER
	MovaW ADR2,LOC

	LDA #0
	LDY LL
	LDX DIF

-	BEQ SCP2
	DEY
	STA (ADR2),Y
	DEX
	JMP -

SCP2	GET
	RTS
##
*** Pointer to end of text buffer
N	MovlB OFLG,0
	STA SCTL7FG
N1	MovlW TEA,cMXA+1
	RTS
##	
*** Three empty lines between pointer and final character
SCTL3	MovlB OFLG,0	
	MovlW ADR1,cMXA-$100	erase bottom up
	LDX #$3C			length of text buffer: high
	LDY #0
	TYA
loop	DEY			start with cMXA-1
	LDA (ADR1),Y
	BNE skip			character found, exit
	TYA
	BNE loop
	  DEC ADR1+1
	  DEX
	  BNE loop
skip	STY ADR1
	INC ADR1+1
	CLC
	AddlB ADR1,120		three lines
	MovaW TEA,ADR1
	RTS
##
TEACOL	DFB 0
SCTL3	LDY #0
	STY OFLG
	STY SCTL7FG
loop	LDX LL
-	DecW TEA
	LDA (TEA),Y
	BNE +		character found, exit
	  DEX
	  BNE -
	  BEQ loop
	
+	DEX
	STX TEACOL

	SubaB TEA,TEACOL
	MovaW XA,TEA
	AddaB TEA,LL
	RTS

*****************	
*** S-Ctl <.> ***
*****************
SCTLPER	CTLRET
COB	AddaB XA,LL
	CmpaW XA,TEA
	BCC +
	SubaB XA,LL

	RTS

+	LDY #0
	LDA (XA),Y
	BNE +

	CTLDBS
	JMP COB

+	DecW XA
	LDY #0
	LDA (XA),Y
	PHP
	IncW XA
	PLP
	BEQ COB

	MovlB KCD,166	;CTRL-/
	WDFORBAC
	RTS
*
SCTLCLR	RTS
*
*R	WNDW
*	PRINTSN "REALINE? Y/N"
*	CONFIRM

R	MovaW LOC,XA
	CTLRET
*	TEUP
	LDX #1
	STX C2FLG
	PTRTEOP

-	AddaB XA,LL
	CmpaW XA,TEA
	BCC -

	MovaW SV,XA	;SV = XA

R1	SubaB SV,LL	;SV += LL
	MovaW XA,SV	;XA = S
	CmpaW LOC,XA	
	BCC R2
*	MovaW XA,LOC
	MovaW XA,TEA
*	CTLRET

	JMP LPBG

R2	DecW XA
	LDY #0
	LDA (XA),Y
	BEQ SPACE

	CMP #223
	BEQ HYPH

	IncW XA
	IncW TEA	
	INS
	DecW XA
	JMP R1

SPACE	CTLDBS
	JMP R2

HYPH	CTLDBS
	JMP R1

*
E	LDA #1
	EOR EFLG
	STA EFLG
	RTS

SCTLCAP	RTS

* insert-block begin
SCTL8	MovaW INSBGAD,XA
	RTS
* insert=block end
SCTL9	CmpaW XA,INSBGAD
	BCC SC0END

	MovaW LEN,XA
	IncW LEN
	SubaW LEN,INSBGAD
	CmplW LEN,cCBLKMXL
	BCC SC01

	MovlW LEN,cCBLKMXL
SC01	MovaW CBLKLEN,LEN
	MovaW ADR1,INSBGAD
	MovlW ADR2,cCBLKBUF

	MOVER
SC0END	RTS





SCTL2	LDA #1
	EOR DBSFLG
	STA DBSFLG
	RTS

SCTLDBS	INSLN
	MOVE DLLNBF,XA,LL
	RTS


SCTL4	LDA LL
	CMP #80
	BNE SC81

	MovlB LL,40
	RTS

SC81	MovlB LL,80
	RTS

Q	CLOSE $20
*	CLOSE $30
	GR 0
	CLRCSR
	MovaW BRKKY,BKYSV
	MovaB PORTB,PTBSV
	LDX STKSV
	TXS
	RTS



SCTLINS	MovaW LEN,SAVMSC
	AddaW LEN,SSP
	SubaW LEN,YA
	CmpaW LEN,CBLKLEN
	BCC DISPLAY 

	MovaW LEN,CBLKLEN
DISPLAY	MovlW ADR1,cCBLKBUF
	MovaW ADR2,YA
	MOVER
	GET
	CMP #EOL
	BNE SCINSEND

	MovlW ADR1,cCBLKBUF
	MovaW ADR2,XA
	MOVER
SCINSEND	RTS
*
F	LDA FFLG
	EOR #128
	STA FFLG
	CLS
	RTS
***
BANKTAB	DFB $FF
	DFB $EF,$EB,$E7,$E3
	DFB $AF,$AB,$A7,$A3
	DFB $6F,$6B,$67,$63
	DFB $2F,$2B,$27,$23

H	WNDW
	PRINTSN "<A> Main RAM   <B>-<E> 130XE Bank"
	PRINTSN "<F-I> <J-M> <N-Q> COMPY SHOP Bank"
	
loop	GET
	AND #%11011111
	CMP 'A'
	BCC loop
	CMP 'R'
	BCS loop
	
	TAY		save A
	SEC
	SBC 'A'
	TAX
	LDA BANKTAB,X
	STA BANK

	TYA		restore A
	SEC
	SBC #32		convert to screen code
	ORA #%10000000	invert
	STA BANKCH	status line
	
	JMP BKTP

***
SCTLCOM	LDY #0
	LDA #221
	STA (XA),Y
	IncW XA
	RTS
*
RW	DFW 0
MGN	DFB 0

G	CTLRET
	GR 22
	MovlB ATACHR,1
	PLOT 0,0
	DRTO 0,95
	DRTO 136,95
	DRTO 136,0
	DRTO 0,0	
	PLOT 0,0


	LDY #0
	STY RW
	STY RW+1

DO1	STY CNT

DO2	LDA (XA),Y
	BEQ ENDPL
	CMP #221
	BNE PLOTP
	INC RW
	BNE ENDPL

PLOTP	CLC
	LDA #8
	ADC RW
	ADC RW
	CMP #159
	BCS END
	STA COLCRS

	SEC
	LDA #87
	SBC CNT
	SBC MGN
	STA ROWCRS

	LDX #$60
	LDA ATACHR
	CIOV

	LDY #0
ENDPL	IncW XA
	CmpaW XA,TEA
	BCS END	

	INC CNT
	LDA CNT
	CMP LL
	BNE DO2

	INC RW
	LDA RW
	CLC
	ADC DBSFLG
	STA RW
	BNE DO1

END	GET

GND	JMP BKTP	
*
WL	DFW 0


WNDW	LDA C3FLG
	BNE WNDW2

	  MovaW ADR1,SAVMSC
	  MovlW LEN,120
	  CLEAR
	  MovlW VCNT1,$1A00
	  POS 0,0
	  RTS
* Alternative compatible with enhanced text in Altirra
WNDW2	GR 0
	CLOSE $00
	OPEN $00,12,0,"E:"

	CLRCSR
	RTS
*	
S	WNDW

	MovlW ADR1,cWORD

	MovaW ADR2,SAVMSC
	AddlB ADR2,40
	MovaW LOC,ADR2
	MovaW LEN,WL
	MOVER

	PRINTSN "SEARCH"
	INPUT $00,cWORD

	LDY #$FF
loop	INY
	LDA cWORD,Y
	CMP #EOL
	BEQ S2

	LDA (LOC),Y
	STA cWORD,Y
	JMP loop

S2	STY WL

W	IncW XA
	CmpaW XA,TEA
	BCC W1
	  MovaW XA,PRVXA
	  JMP LPBG

W1	LDY #0
loop	LDA cWORD,Y
	CMP #EOL
	BEQ WND

	CMP (XA),Y
	BNE W

	INY
	BNE loop
WND	RTS
*
ABV	EQU $543


SHFTBLK	LDY #0
loop	DecW XA
	LDA (XA),Y
	BNE loop

	IncW XA
	LDA (XA),Y
	BNE +
	RTS

+	MovlB ABV,143

loop	LDA (XA),Y
	PHP
	INY
	STA ABV,Y
	PLP
	BNE loop

	MovlB PORTB,$6F
	MovlW LOC,$3FFF

A3	IncW LOC
	LDA LOC+1
	BMI AEND

	LDY #$FF
loop	INY
	LDA ABV,Y
	BEQ skip

	CMP (LOC),Y
	BNE A3	
	BEQ loop

skip	CMP (LOC),Y
	BNE A3

	LDX #0
loop	INY
	LDA (LOC),Y
	CMP #143
	BEQ skip

	STA ABV,X
	INX
	BNE loop

skip	MovaB PORTB,BANK
	LDY #0
	STX CNT
	LDX #0

loop	LDA ABV,X
	STA (XA),Y 
	IncW XA
	INX
	DEC CNT
	BNE loop

AEND	RTS
*
P	MovaW TEA,XA
	RTS

SCTLMIN	SubaW XA,SSP
	SubaW WA,SSP
	PTRTEOP
	RTS

SCTLEQU	AddaW WA,SSP
	AddaW XA,SSP
	PTRTEOP
	RTS

SHFTINV	LDY #0		Underline
	LDA (XA),Y
	CLC
	ADC #128
	STA (XA),Y
	RIGHT
	RTS

U	LDY #0		Upper case to lower case
	LDA (XA),Y
	TAX
	AND #%01111111
	CMP #33
	BCC YEND
	CMP #59
	BCS YEND
	TXA
	ADC #64
	STA (XA),Y		
YEND	RIGHT
	RTS
************************************	
* Control-Character Tab ASCII codes	
************************************
CtlChTab	DFB 27
	DFW ESC
	DFB 28
	DFW UP
	DFB 29
	DFW DOWN
	DFB 30
	DFW LEFT
	DFB 31
	DFW RIGHT
	
	DFB 125
	DFW CTLCLR	
	DFB 126
	DFW DBS
	DFB 127
	DFW TAB

*	    155 RET
	DFB 156
	DFW DELLN	-SHIFT-BCKSP
	DFB 157
	DFW INSLN	-SHIFT->
	DFB 158
	DFW CTLTAB	-CTRL-TAB
	DFB 159
	DFW SHFTTAB	-SHIFT-TAB

*	    253 CTRL-2
	DFB 254
	DFW CTLDBS	-CTRL-BCKSP
	DFB 255
	DFW INS		-CTRL- >


	DFB 0
*
CTLCLR	MovaW LEN,SSP
	AddaW LEN,SAVMSC
	SubaW LEN,YA
	MovaW ADR1,YA

	MovaW DIF,TEA
	SubaW DIF,XA
	CmpaW LEN,DIF
	BCC +

	MovaW LEN,DIF

+	CLEAR
	GET
	CMP #EOL
	BNE +
	MovaW LEN,TEA
	SubaW LEN,XA
	MovaW ADR1,XA
	CLEAR
+	RTS
*
CTLTAB	LDA #0
	BEQ SETTAB
*
SHFTTAB	LDA 'X
SETTAB	LDX LOGCOL
	STA TABMAP,X
	RTS

*
TAB	LDX LOGCOL

loop	INX
	CPX LL
	BNE +
	LDX #0

+	IncW XA
	LDA TABMAP,X
	CMP 'X'
	BNE loop
	RTS
*
ESC	LDA #128
	STA ESCFLG
	RTS
*
UP	CmplW XA,cTXAD+40	;inhibit cursor-jump to begin
	BCC +
	SublB XA,40
	PTRTEOP
+	RTS
*
DOWN	CmplW XA,cMXA-40	;inhibit cursor-jump to end
	BCS +
	AddlB XA,40
	PTRTEOP
+	RTS
*
LEFT	Cmpl LOGCOL,39
	BNE +
	  PTRTEOP
*	  IncW TEA
+	DecW XA
	RTS
*
RIGHT	Cmpl LOGCOL,0
	BNE +
	  PTRTEOP
+	IncW XA
	RTS




	ORG $2200


DBS	LEFT
	CmplW XA,cTXAD
	BCC +

	LDA #0
	TAY
	STA (XA),Y
	LDA INSFLG
	BEQ +
	CTLDBS	
+	RTS

*********************
*** New paragraph ***
*********************
NWPARAGR	LDA LL
	SEC
	SBC LOGCOL
	STA DIF	
	INSCHS
	RTS	
*************************************
*** Push word to next line, *********
*** hyphenate when not word begin ***
*************************************
M	NWPARAGR
	LDY #0
	MovaW LOC,XA
	DecW LOC
	LDA (LOC),Y
	BEQ +
	LDA #223	;inverse right arrow
	STA (XA),Y
+	AddaB XA,DIF
	RTS
##	
*****************************************
*** Insert line (new and independent) ***
*****************************************
INSLN	MovaB DIF,LL	
	CKLASTLN
	CTLRET
	MovaW ADR1,XA
	MovaW ADR2,XA
	AddaB ADR2,LL
	MovlW LEN,cMXA+1
	SubaW LEN,ADR2
	
	MMOVER
	
	AddaB TEA,LL
	
* Fill cursor line with blanks (cursor at line begin)	
	LDY LL
	LDA #0
-	DEY
	STA (XA),Y
	BNE -
	
	RTS
##	
* Check that the last DIF bytes of text buffer are 0.
CKLASTLN	LDX DIF
	MovlW ADR1,cMXA+1
	SubaB ADR1,LL
	LDY LL
-	DEX
	BMI +
	DEY
	LDA (ADR1),Y
	BEQ -
	  BELL
	  JMP BKTP
+	RTS
	

* This INSL uses INSCHS. There is a problem with end of text buffer

INSLN	MovaB DIF,LL	DIF = LL
	CTLRET
	
* Insert characters(DIF)
INSCHS	CKLASTLN
	MovaW ADR1,TEA		
	SubaB ADR1,DIF	ADR1 = TEA - DIF
	LDY DIF		Y = DIF
	DEY
loop	LDA (ADR1),Y
	BEQ +
	  FREELINE
	  JMP SHIFTEXT
+	DEY
	BPL loop
* Shift the remainder of paragraph right towards pointer.
SHIFTEXT	LDA C7FLG
	BEQ +
	  RTS
+	MovaW ADR2,XA
	AddaB ADR2,DIF
	DecW ADR2	ADR2 = XA + DIF - 1
	
	MovaW LEN,TEA 
	SubaW LEN,ADR2	LEN = TEA - ADR2
	
	MovaW ADR1,XA	ADR1 = XA - 1
	DecW ADR1
	
	MMOVER

	MovaW ADR1,XA
	DecW ADR1	ADR1 = XA - 1
	
	CLRCHS		;space created
	RTS

*FREELINE	JSR $F556	ring bell

*Free the pointer line, and move pointer down a line
FREELINE	LDA C6FLG
	BEQ +
	  RTS
+	MovaW ADR1,TEA
	MovaW ADR2,TEA
	AddaB ADR2,LL
	CmplW ADR2,cMXA	;TEA at last line of text buffer?
	BCC +
	  AddaB TEA,LL	;move pointer down one line
	  RTS
+	MovlW LEN,cMXA
	SubaW LEN,ADR2
*			Mmove TEA,TEA+LL,CMXA-TEA-LL
	MMOVER		;Move block down a line
*Fill line with spaces
	LDY LL		40
	LDA #0
	DEY		39
loop	STA (TEA),Y
	DEY
	BPL loop

	LDA #0
	STA OFLG
	AddaB TEA,LL	;move pointer down one line
	RTS

************************************	
*** Delete Line ********************	
************************************
*	TMP saves TEA

DELLN	MovaW TMP,TEA	
	MovlW TEA,cMXA+1
	AddaB XA,LL
	CTLRET
	CmpaW TEA,XA
	PHP
	SubaB XA,LL
	PLP
	BCS + 
	 FREELINE
	 MovaW TEA,TMP
	 RTS
+	LDY LL
loop	DEY
	BMI skip

	LDA (XA),Y
	BEQ loop

	MOVE XA,DLLNBF,LL

skip	MovaW DIF,LL
	DELCHS
	MovaW TEA,TMP
	SubaW TEA,LL
	RTS
	
******************************
*** Delete characters ********
******************************
DELCHS	MovaW ADR1,XA
	AddaB ADR1,DIF
	MovaW LEN,TEA
	SubaW LEN,ADR1
	MovaW ADR2,XA
	MOVER		; XA -> XA+DIF, TEA-XA bytes

	MovaW ADR1,TEA
	DecW ADR1
	SubaB ADR1,DIF
	CLRCHS
	RTS
*
INS	MovlB DIF,1
	CmplW XA,cMXA-1
	BCS +
	INSCHS
+	RTS
*
CTLDBS	MovlB DIF,1
	CmplW XA,cMXA-1
	BCS +
	DELCHS
+	RTS

***********************************************
*** move block of length LEN from ADR1 to ADR2
***********************************************
MOVER	LDY #0
	LDX LEN+1
	BEQ MVREMI	length < 256

MVBLK	LDA (ADR1),Y	   move block
	STA (ADR2),Y
	INY
	BNE MVBLK	go to remainder when Y is zero

	INC ADR1+1
	INC ADR2+1
	DEX
	BNE MVBLK

MVREMI	LDA LEN
	BEQ MVND

loop	LDA (ADR1),Y	move remainder
	STA (ADR2),Y
	INY
	CPY LEN
	BNE loop

MVND	RTS

*****************************************************
*** minus move block of length LEN from ARD1 to ADR2
*****************************************************
MMOVER	AddaW ADR1,LEN
	AddaW ADR2,LEN

	LDX LEN+1
	INX
	LDY #$FF

MMVBLK	DEC ADR1+1
	DEC ADR2+1
	DEX
	BEQ MMVREM
loop	LDA (ADR1),Y
	STA (ADR2),Y
	DEY
	BNE loop

	LDA (ADR1),Y
	STA (ADR2),Y
	DEY
	BMI MMVBLK

MMVREM	LDX #0
loop	CPX LEN
	BEQ MMVEND	break if EQ
	LDA (ADR1),Y
	STA (ADR2),Y
	DEY
	INX
	BNE loop
MMVEND	RTS

*************************
*** Clear characters (DIF)
**************************
CLRCHS	LDY DIF
	LDA #0
loop	STA (ADR1),Y
	DEY
	BNE loop
	RTS
***************************
*The following variables were moved to header
*LNPNT	EPZ $F8
*PBFPNT	EPZ $FA
*ULFLG	EPZ $FC
*ACTLL	EPZ $FD

T	WNDW

	PRINTSN "<1>Atari800WinPLus P: <2>Export TMP.ATA"
	PRINTSN "<3>Atari 1027 P:      <4>Import TMP.ATA"
	PRINTSN "<5>Export TEMP.TXT    <6>Show on Screen"
	PRINTSN "<7>Exit"
loop	GET
	STA CHR
	CMP '1
	BNE +
	  JMP TZ
+	CMP '2
	BNE +
	  JMP EXPORT
+	CMP '3
	BNE +
	  JMP T1
+	CMP '4
	BNE +
	  JMP IMPATA
+	CMP '5
	BNE +
	  JMP EXPORTXT
+	CMP '6
	BNE +
	  JMP PRSCREEN
+	CMP '7
	BNE loop
	  JMP BKTP

******************************************	
*** 1027 Printer (Do not change this code, 
**** as it can no longer be tested.)
*****************************************

T1	MovaW BRKKY,BKYSV
	CLOSE $40
	OPEN $40,8,0,"P:"
	
	CTLRET
	TEUP

	LDY #0
	STY LNPNT
	STY PBFPNT

	LDA #27		ESC
	PUTPBUF
	LDA #23		International characters on
	PUTPBUF
	LPRINT

TYPLOOP	MOVE XA,SAVMSC,LL

	LDY #0
	STY LNPNT
	STY PBFPNT
	STY ULFLG

	LDY LL

DETACTLL	DEY
	BMI DTC2
	LDA (XA),Y
	BEQ DETACTLL	

DTC2	INY
	STY ACTLL

NXTPCH	LDY LNPNT	  DO
	CPY ACTLL
	BEQ DETLEN
	LDA (XA),Y	
	INC LNPNT

	LDX #0

	CMP #223		inverted right arrow
	BNE ATLP
	LDA '-		hyphen
	BNE UNLN

ATLP	CMP #32
	BCC TYPE2 
	INX
	SBC #32	
	JMP ATLP

TYPE2	ADC ASCTAB,X	
UNLN	BMI UNDRLN

	LDX ULFLG
	BPL PTB

	STA ULFLG
	ULOFF
	LDA ULFLG
	BPL PTB

UNDRLN	LDX ULFLG
	BMI PTB

	STA ULFLG
	ULON
	LDA ULFLG

PTB	PUTPBUF	
	JMP NXTPCH	  LOOP

DETLEN	LDX DBSFLG
PUTEOL	LDA #155
	PUTPBUF		preserves X
	DEX
	BEQ PUTEOL	loops once if double spacing
	AddaB XA,LL

	LPRINT		printer or disk

	CmpaW XA,TEA
	BCS TYPEND	
	JMP TYPLOOP	LOOP

TYPEND	JMP BKTP

PUTPBUF	LDY PBFPNT
	CMP #157
	BNE PTBF1
	LDA #155
PTBF1	STA cPRBF,Y
	INC PBFPNT
	RTS

LPRINT	LDA #0		printer or disk
	STA PBFPNT+1
	BPUT $40,cPRBF,PBFPNT
	BPL +
 	  JMP LPBG	end of file
+	RTS

ULON	LDA #27
	PUTPBUF
	LDA #25
	PUTPBUF
	RTS

ULOFF	LDA #27
	PUTPBUF
	LDA #26
	PUTPBUF
	RTS

************************************************
*** Type -- new functions
************************************************

EXPORTXT	OPEN $40,8,0,"D:TEMP.TXT"
	JMP +
PRSCREEN	OPEN $40,8,0,"S:"
	MovlB CHBAS,204	;international character set
	CLRCSR
	JMP EXPORT1
EXPORT	OPEN $40,8,0,"D:TMP.ATA"
EXPORT1	MovlB EXPTFLG,1
	BNE +

TZ	OPEN $40,8,0,"P:"		Atari800Win PLus
+	MovaW BRKKY,BKYSV
	CTLRET			to line begin
	TEUP

*	LDY #0
*	STY LNPNT
*	STY PBFPNT

*TYPLOOPZ	MOVE XA,SAVMSC,LL		cPRBF, not screen is buffer

TYPLOOPZ	LDY #0
	STY LNPNT
	STY PBFPNT
	
	LDY LL

-	DEY
	  BMI +		only spaces in this line?
	  LDA (XA),Y
	BEQ -		skip over spaces

+	INY
	STY ACTLL	actual line length
*** Single-character loop ***
NXTPCHZ	LDY LNPNT	  DO
	CPY ACTLL
	BEQ DETLENZ
	LDA (XA),Y	
	INC LNPNT

	LDX #0
*** Convert hyphen *******
	CMP #223		inverted right arrow internal
	BNE ATLPZ
	  LDA '-'	hyphen
	  BNE PTBZ	skip ATASCII conversion
*** Convert to ATASCII ***
ATLPZ	CMP #32
	  BCC + 
	  INX
	  SBC #32	
	JMP ATLPZ

+	ADC ASCTAB,X	
*** Choose whether to-PC conversion ***
PTBZ	LDY EXPTFLG
	BEQ +
skip	  PUTPBUF	no to-PC char conversion for XPORT ATA
	  JMP NXTPCHZ	LOOP
	  
+	PUTPBUFZ		Atari char -> PC char for Atari800Win PLus and TXT
	JMP NXTPCHZ	LOOP
*** Single-character loop end ***************
	

DETLENZ	LDA #157		inverted arrow down
	LDX DBSFLG	double spacing?
	BEQ PUTEOLZ
	  PUTPBUFZ
*** new: Test first two positions in next line 	  
PUTEOLZ	LDY LL

	LDX #5
	INY		;41
	INY
-	DEY 		;41 40 39
	DEX		;3 2 1
	BEQ skip
	LDA (XA),Y	;1 l _ 
	BNE -		;char found
	  DEY	 	;space found
	  DEX		;0
	  BEQ skip
	  LDA (XA),Y
	  BNE -		;char found
******	
	LDA #157		inverted arrow down
	PUTPBUFZ 
	JMP +
*** fixes bug where last space in line not written	
skip	LDY LL	full line
	DEY
	LDA (XA),Y
	BNE +
	LDA ' '
	PUTPBUFZ
**************************************************
+	LPRINT		printer or disk

	AddaB XA,LL
	CmpaW XA,TEA
	BCS TYPENDZ	
	JMP TYPLOOPZ	LOOP

TYPENDZ	GET
	JMP BKTP
**********************************

*** single char Atari->PC char
PUTPBUFZ	LDY PBFPNT
	CMP #157		inverted down arrow
	BNE skip
	  LDA EXPTFLG
	  BEQ +
	  LDA #155	ATA
	  BNE PUTBF1Z	BRA	  
+	  LDA #$D	convert to CR for TXT and Atari800Win Plus P:
	  BNE PUTBF1Z	BRA
	  
skip	AND #%01111111	inverted chars normal
	CMP #27		international 0 to 26
	BCS skip
	  TAX
	  LDA ANSITAB,X
	
skip	CMP #123		atari'A'umlaut
	BNE +
	LDA #196		ansi 'A'umlaut
	BNE PUTBF1Z
	
+	CMP #96		atari'i' accented
	BNE +
	LDA #237		ansi 'i' accented
	BNE PUTBF1Z
	
+	CMP 'B'
	BNE PUTBF1Z
	  LDX #8		there are 8 vowels
	  LDA cPRBF-1,Y
-	  DEX
	  BMI +		vowel not found
	  CMP VOWELS,X
	  BNE -
	    LDA #223		scharfes S
	    BNE PUTBF1Z
+	LDA 'B'
	    
PUTBF1Z	STA cPRBF,Y
	INC PBFPNT
	RTS
****************************************************
VOWELS	DFB 228,246,252
	ASC "aeiou"

BUF     DFB 0
************************************************
ANSITAB	DFB 225,249,209,201,231,244,242,236
	DFB 163,239,252,228,214,250,243,246
	DFB 220,226,251,238,233,232,241,234
	DFB 229,224,197					   
ASCTAB	DFB 32,64,0,96,160,192,128,224
INSBGAD	DFW 0
CBLKLEN	DFW 0
cCBLKMXL	EQU $960


COLPF1	EQU $D017
WSYNC	EQU $D40A
VCOUNT	EQU $D40B
NMIEN	EQU $D40E
VDSLST	EQU $200
SDLSTL	EQU $230

VORBERT	SublB SAVMSC,40
	MovaW SCREEN,SAVMSC
	MovlW SDLSTL,NEWDLST

	MovlB NMIEN,$40
	MovlW VDSLST,DLIPGM
	MovlB NMIEN,$C0	
	RTS

DLIPGM	PHA
	LDA VCOUNT
	STA WSYNC
	CMP VCNT1
	BCS skip
	MovlW COLPF1,$C009
	BNE ENDI
skip	CMP VCNT2
	BCS skip
	MovlW COLPF1,$120B
	BNE ENDI

skip	MovlW COLPF1,$C009
ENDI	PLA
	RTI

NEWDLST	DFB $70,$70,$F0
	DFB 66+$80
SCREEN	DFW 0
	DFB $82,$82,$82,$82,$82
	DFB $82,$82,$82,$82,$82
	DFB $82,$82,$82,$82,$82
	DFB $82,$82,$82,$82,$82
	DFB $82,$82,$82,$F0,$82
	DFB 65
	DFW NEWDLST

***********************
*** Colors and Cursor
***********************

CLRCSR	MovlB 709,9
	MovlB 710,192
	MovlB 712,226
	MovlB 729,20
	MovlB 730,3
	RTS
*
DEVS	ASC "S:"

GRAPHR	PHA
	CLOSE $60
	PLA
	STA ICAX2,X
	AND #$F0
	EOR #$10
	ORA #$0C
	STA ICAX1,X
	MovlBX ICCOM,COPEN
	MovlWX ICBAL,DEVS
	CIOV
	RTS
	
****************************
*** Get single character
****************************

GET	LDX #$20
	MovlBX ICCOM,CGBIN
	LDA #0
	STA ICBLL,X
	STA ICBLH,X
	CIOV
	RTS
*
CLEAR	LDA #0
	TAY
	STA (ADR1),Y
	MovaW ADR2,ADR1
	IncW ADR2
	DecW LEN
	MOVER
	RTS

********************************
* Move pointer up to end of text
********************************

TEUP	LDY #0
loop	DecW TEA
	LDA (TEA),Y
	BEQ loop

	IncW TEA
	RTS
*
PLOTR	LDX #$60
	MovlBX ICCOM,CPBIN
	LDA #0
	STA ICBLL,X
	STA ICBLH,X
	LDA ATACHR
	CIOV
	RTS
	
***************************
*** Draw to routine ****
***************************

DRTOR	LDX #$60
	MovlBX ICCOM,CDRAW
	MovlBX ICAX1,CCLSE
	MovlBX ICAX2,0
	CIOV
	RTS
*

PRINTR	MovlBX ICCOM,CPTXT
	MovlWX ICBLL,120
	CIOV
	RTS

*
DOSMENU	ASC /L/,"OAD      "  
	DFB 4,CGBIN
	DFW SAVLOD

	ASC /S/,"AVE      "
	DFB 8,CPBIN
	DFW SAVLOD

	ASC /M/,"ERGE     "  
	DFB 4,CGBIN
	DFW SAVLOD

	ASC /W/,"BLOCK    "
	DFB 8,CPBIN
	DFW SAVLOD

	ASC /I/,"MPORT    "  
	DFB 4,CGBIN
	DFW IMPINI	formerly IMPTLP

	ASC /X/,"PORT     "
	DFB 8,CPBIN
	DFW EXPORT1

	ASC /P/,"ROTECT   "
	DFB 0,$23
	DFW PROT

	ASC /U/,"NPROTECT "
	DFB 0,$24
	DFW UNPROT
	
	ASC /D/,"IR       "
	DFB 6,0
	DFW DIR

	ASC /R/,"ENAME    "
	DFB 0,$20
	DFW RENAME

	ASC /E/,"RASE     "
	DFB 0,$21
	DFW ERASE

	
	DFB 0

cMENITL	EQU 10
cNUMATR	EQU 4
*** DOS
D	GR 0
	CLOSE $00
	OPEN $00,12,0,"E:"

	CLRCSR
	MovlB cPRBF,'*'
	MovlB cPRBF+1,155
	MovlW ADR1,DOSMENU+8*(cMENITL+cNUMATR)	DIR
	DOCMND		won't return (pla, pla)
*** Print menu
*	MovlW ADR1,DOSMENU
NXTITM	LDY #0

	LDA (ADR1),Y
	BEQ PICK

	PRMNIT		Print menu item
	AddlB ADR1,cMENITL+cNUMATR
	JMP NXTITM 	
*** Pick item
PICK	PRINTSN ""
	GET
	STA CHR
	MovlW ADR1,DOSMENU

FINDIT	LDY #0
	LDA (ADR1),Y
	AND #%01111111
	BEQ PICK
	CMP CHR
	BEQ ITFND

	AddlB ADR1,cMENITL+cNUMATR
	JMP FINDIT

ITFND	POS 0,22
	PRMNIT			print item found

	LDA CHR
	CMP 'S'			load?
	BNE skip
	
	  LDA cSAVBF
	  BEQ skip		No file was loaded

	  PRINT 0,cSAVBF		Print Name of loaded file
	  
	  POS cMENITL-1,22		Set cursor

	  MovlW ICBLL,0		0 for single character
	  MovlB ICCOM,$0B		PUT CHAR / PUT RECORD
	  LDA '?
	  CIOV			Activate cursor

skip	INPUT $00,cPRBF		input from keyboard

	LDA CHR
	CMP 'L'			load?
	BNE skip
	  LDY #0
-	  LDA cPRBF,Y
	  STA cSAVBF,Y
	  INY
	  CMP #155
	  BNE -


skip	NOP
DOCMND	CLOSE $40
	adjstDX        
	LDX #$40
	LDY #cMENITL
	LDA (ADR1),Y
	STA ICAX1,X
	MovlBX ICAX2,0
	MovlBX ICCOM,COPEN
	MovlWX ICBAL,cPRBF
	CIOV

	LDY #cMENITL+1
	LDA (ADR1),Y
	STA ICCOM,X
	CMP #CPBIN	SAVE or copy?
	BNE +
	  SAVCOPY
	  JMP skip
	  
+	CMP #CGBIN	Load or merge?
	BNE skip
	  LOADMERG	  
	  
skip	LDY #cMENITL+2
	LDA (ADR1),Y
	STA VECTOR 	
	INY
	LDA (ADR1),Y
	STA VECTOR+1

	LDA #M0-1:H
	PHA
	LDA #M0-1:L
	PHA
	JMP (VECTOR)

M0	CIOV	
	MovaB PORTB,BANK
	CLOSE $40
	BKTP
*
SAVLOD	LDX #$40
	LDA XA
	STA ICBAL,X
	LDA XA+1
	STA ICBAH,X

	MovaW LEN,TEA
	SubaW LEN,XA
	LDA LEN
	STA ICBLL,X
	LDA LEN+1
	STA ICBLH,X
	RTS

RENAME	RTS
ERASE	RTS
PROT	RTS
UNPROT	RTS

DIRLN	INPUT $40,cPRBF
	BMI skip
	PRINT $00,cPRBF
	RTS
skip	PRINTSN ""
	MovlW ADR1,DOSMENU
	PLA
	PLA
	JMP NXTITM
	
DIR	EDCLS
	
loop	DIRLN
	DEC ROWCRS
	MovlB COLCRS,19
	DIRLN
	JMP loop

PRMNIT	LDX #$00
	MovlBX ICCOM,CPBIN
	LDA #cMENITL		Item length is 10
	STA ICBLL,X
	LDA #0
	STA ICBLH,X
	LDA ADR1
	STA ICBAL,X
	LDA ADR1+1
	STA ICBAH,X
	CIOV
	BMI DOSERR	  
	RTS

DOSERR	STY CHR
	MovlW LEN,1
	EDCLS
	BPUT $00,CHR,LEN
	GET
	BKTP

	DFB 0
	

*** SAVE or COPYTEXT?
SAVCOPY	LDA CHR
	CMP 'C'		;COPYTEXT
	BEQ +
	
	  MovlW XA,cTXAD	;cursor to front of text buffer
	  MovlW TEA,cMXA
	  JMP skip
	
+	PRINTSN @Copy cursor->pointer to disk? Y/N@
	CONFIRM
	
skip	LDY #0
-	DecW TEA		;marker to end of text to be saved
	LDA (TEA),Y
	BEQ -
	IncW TEA		;first space after last character to be saved
	RTS
	
*** LOAD or MERGE?
LOADMERG LDA CHR
	CMP 'M'		MERGE
	BNE +
	  PRINTSN @Overwrite from cursor? Y/N@
	  CONFIRM
	  RTS

+	PRINTSN @Wipe and load? Y/N@	
	CONFIRM
	DLTXBF
	RTS	
***
CONFIRM	GET
	CMP 'Y'
	BEQ +
	CMP 'Z'
	BEQ +
	  BKTP
+	RTS
***************************************
*** Routines from SGEN ****************

*** If ":" not found, "D:" is assumed ***
*** If found, could be D:,F:,P:,S:etc ***

adjstDX	LDA ':'
	CMP cPRBF+1
	BEQ skip
	CMP cPRBF+2
	BEQ skip

	LDY #30	ample length
	LDX #32

loop	LDA cPRBF,Y		'X'
	  STA cPRBF,X	
	  DEX
	  DEY
	  BPL loop

	LDA 'D'
	STA cPRBF
	LDA ':'
	STA cPRBF+1

skip	LDY #1
loop	INY	
	LDA cPRBF,Y
	CMP '.'
	BNE +
	  RTS
+	CMP #155
	BNE loop
	
	LDA '.'
	STA cPRBF,Y
	INY
	
	LDA CHR
	CMP 'X
	BNE +
	  BEQ skip  
+	CMP 'I
	BNE +
skip	  LDA 'T
	  STA cPRBF,Y
	  INY
	  
+	LDA 'X'
	STA cPRBF,Y
	INY
	LDA #155
	STA cPRBF,Y	
	RTS	

##
PHB	PHA
	CMP #10
	BCC PHB2
	PT \$\
	STX XSAV
	PLA
PHB1	PHA
	LSR
	LSR
	LSR
	LSR
	BEQ PHB2
	TAX
	LDA HXTB,X
	PTCH
PHB2	PLA
	AND #%00001111
	TAX
	LDA HXTB,X
	PTCH
	LDX XSAV
	RTS
	
HXTB	ASC "0123456789ABCDEF"
XSAV	DFB 0

************************************

BLK	LDA ' '
PTCH	STX TMP
	LDX LPTR
	STA LN,X
	INC LPTR

	LDA LPTR
	CMP LPTRMX
	BEQ PCHER

	INC CHC
	LDX TMP
	DEC A1
	BEQ PTCND

	MovaB A1,SECSZ

PTCND	RTS
##      

; =============================================
; Open file D:TMP.ATA
; =============================================

IMPATA	CLOSE $40
	OPEN $40,4,0,"D:TMP.ATA"
	BPL IMPINI
	JMP OPENERR


; =============================================
; Initialisation
; =============================================

IMPINI	MovlW PBPTR,cPRBF		current parse pointer
	LDA #0
	STA PBCNT		bytes remaining in buffer
	STA COL			current line column

; =============================================
; Main Loop
; =============================================

IMPTLP	LDA PBCNT
	BNE GOTCHR

; ---------------------------------------------
; Buffer empty -> GET CHARACTERS
; ---------------------------------------------

	LDX #$40

	LDA #cPRBF
	STA ICBAL,X
	LDA #cPRBF:H
	STA ICBAH,X

	LDA #128
	STA ICBLL,X
	LDA #0
	STA ICBLH,X

	LDA #$07			GET CHARACTERS
	STA ICCOM,X

	JSR CIOV
*	BPL + 
*	JMP EOF

; actual bytes read returned in ICBLL/H
; IMPORTANT:
; EOF may return negative status
; but still provide valid bytes
+	LDX #$40
	LDA ICBLL,X
	ORA ICBLH,X
	BNE + 
	JMP EOF

+	LDA ICBLL,X
	STA PBCNT

	MovlW PBPTR,cPRBF


; =============================================
; Get next byte from buffer
; =============================================

GOTCHR	LDY #0
	LDA (PBPTR),Y

	IncW PBPTR
	DEC PBCNT

; =============================================
; EOL ?
; =============================================

	CMP #$9B
	BEQ ENDOFLN

; =============================================
; Normal character
; =============================================

	JSR ATAtoSCR

	LDY #0
	STA (XA),Y

	IncW XA

	INC COL

	LDA COL
	CMP LL
	BNE IMPTLP

; line wrapped

	LDA #0
	STA COL

	JMP IMPTLP


; =============================================
; End of line
; Fill remaining columns with zeros
; =============================================

ENDOFLN	LDA LL
	SEC
	SBC COL
	BEQ NEWLINE

	STA LEN

FILLP	LDA #0
	LDY #0
	STA (XA),Y

	IncW XA

	DEC LEN
	BNE FILLP

NEWLINE	LDA #0
	STA COL

	JMP IMPTLP


; =============================================
; ATASCII to Screen Code conversion
; =============================================

ATAtoSCR	CMP #$20
	BCC add40
	CMP #$40
	BCC sub20
	CMP #$60
	BCC sub20
	CMP #$80
	BCC skip
	CMP #$A0
	BCC add40
	CMP #$C0
	BCC sub20
	CMP #$E0
	BCS skip

sub20	SEC
	SBC #$20
	RTS

add40	CLC
	ADC #$40
skip	RTS


; =============================================
; End of file
; =============================================

EOF	LDX #$40
	LDA #$0C
	STA ICCOM,X
	JSR CIOV
	JMP BKTP


; =============================================
; Show error number at top-left of screen
; =============================================
ERRNO	DFB 0

OPENERR	STY ERRNO
	LDY #39
	LDA ERRNO
	STA (ADR2),Y
	GET
	RTS


; =============================================
; Variables
; =============================================

*PBPTR	EPZ TMP			current position in cPRBF
PBCNT	DFB 0			bytes left in cPRBF
*COL	DFB 0			current output column
*LEN	DFB 0

************************


STATchas	MovaW ADR2,SAVMSC
	AddaW ADR2,SSP	status line

	LDA XA+1		Page to status line
	LSR
	STA PAGECH

	LDA TEA+1	Pointer to status line
	LSR
	STA TEACH

	LDY #0		column of first item
	LDX #0
* Status line
loop	LDA STATLN,X	flag
	PHP
	INX
	LDA STATLN,X
	STA (ADR2),Y	character
	PLP		flag
	BEQ INSMK

	CPX #1		bank
	BEQ INSMK
	
	LDA STATLN,X
	ORA #%10000000	invert if flag on
	STA (ADR2),Y

INSMK	INY
	INX
	CPX #19*2		10+9 items
	BCC loop

	RTS
	
**************************
EDCLS	LDA #0
	STA COLCRS
	STA ROWCRS
	LDA #$7D		CLS

PUTCR	LDX #0
	PHA
	MovlBX ICCOM,CPBIN
	MovlBX ICBLL,0	one character
	STA ICBLH,X
	PLA
	CIOV
	rts

##
Außer bei den im ROM vorhandenen Vektortabellen der Geräte P, E, S, K
und C wird dieser Sprungbefehl vom Betriebssystem ignoriert. Daher
müssen nachgeladene Treiber (z.B. der Diskettentreiber) über eine reset
feste Routine selbst dafür sorgen, dass beim Reset seine Initialisierungs
routine aufgerufen wird. Üblicherweise geschieht dies beim Laden des
Treibers durch Verbiegen des DOSINI-Vektors (12,13; $C,$D): Man liest
den alten DOSINI-Wert aus, setzt DOSINI dann auf die eigene Init-Routine,
in der als erstes die alte DOSINI-Routine per JSR gerufen wird. Das ma
chen auch andere Reset-feste Programme wie z.B. Turbo BASIC XL so
(manchmal wird statt DOSINI auch CASINI (2,3; $2,$3) benutzt). Das letz
te Byte der Vektortabellen ist (bisher noch) unbenutzt
##

JDOS	JSR 0
*	MovaB RAMTOP,RAMTOPSV
	JMP BG1
	
* bell
BELL	LDA SKCTL Disable the POKEY key click directly
	AND #%11111111  ; set bit 0
	STA SKCTL

	JSR $F556	ring bell

	LDA SKCTL Disable the POKEY key click directly
	AND #%11111110  ; clear bit 0
	STA SKCTL

	RTS